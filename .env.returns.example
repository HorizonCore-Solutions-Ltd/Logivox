# ==========================================
# ADVANCED RETURNS MANAGEMENT
# Environment Variables Configuration
# ==========================================

# ==========================================
# LABEL GENERATION SERVICES
# ==========================================

# Choose primary label provider: shipstation, easypost, or shipengine
LABEL_PROVIDER=shipstation

# ShipStation API Credentials
# Get yours at: https://ship11.shipstation.com/settings/api
SHIPSTATION_API_KEY=your_shipstation_api_key_here
SHIPSTATION_API_SECRET=your_shipstation_api_secret_here

# EasyPost API Credentials
# Get yours at: https://www.easypost.com/account/api-keys
EASYPOST_API_KEY=your_easypost_api_key_here

# ShipEngine API Credentials (Optional)
# Get yours at: https://www.shipengine.com/docs/
SHIPENGINE_API_KEY=your_shipengine_api_key_here

# ==========================================
# MARKETPLACE INTEGRATIONS (Resale Automation)
# ==========================================

# eBay API Credentials
# Get yours at: https://developer.ebay.com/my/keys
EBAY_APP_ID=your_ebay_app_id
EBAY_CERT_ID=your_ebay_cert_id
EBAY_DEV_ID=your_ebay_dev_id
EBAY_ACCESS_TOKEN=your_ebay_oauth_token
EBAY_REFRESH_TOKEN=your_ebay_refresh_token
EBAY_ENVIRONMENT=sandbox # or production

# Amazon Marketplace API (SP-API)
# Get yours at: https://developer-docs.amazon.com/sp-api/
AMAZON_SP_CLIENT_ID=your_amazon_client_id
AMAZON_SP_CLIENT_SECRET=your_amazon_client_secret
AMAZON_SP_REFRESH_TOKEN=your_amazon_refresh_token
AMAZON_SP_REGION=us-east-1 # or your region
AMAZON_MARKETPLACE_ID=ATVPDKIKX0DER # US marketplace

# Shopify API Credentials
# Get yours at: https://shopify.dev/docs/api/admin-rest
SHOPIFY_SHOP_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=your_shopify_access_token
SHOPIFY_API_KEY=your_shopify_api_key
SHOPIFY_API_SECRET=your_shopify_api_secret

# Walmart Marketplace API
# Get yours at: https://developer.walmart.com/
WALMART_CLIENT_ID=your_walmart_client_id
WALMART_CLIENT_SECRET=your_walmart_client_secret

# Mercari (Optional)
MERCARI_API_KEY=your_mercari_api_key

# Poshmark (Optional)
POSHMARK_API_KEY=your_poshmark_api_key

# ==========================================
# FRAUD DETECTION & ANALYTICS
# ==========================================

# MaxMind GeoIP Database (for fraud detection)
# Get yours at: https://www.maxmind.com/en/geoip2-services-and-databases
MAXMIND_ACCOUNT_ID=your_maxmind_account_id
MAXMIND_LICENSE_KEY=your_maxmind_license_key

# Sift Science (Optional - Advanced Fraud Detection)
# Get yours at: https://sift.com/
SIFT_API_KEY=your_sift_api_key
SIFT_ACCOUNT_ID=your_sift_account_id

# ==========================================
# PAYMENT & ACCOUNTING INTEGRATIONS
# ==========================================

# Stripe (for refund processing)
STRIPE_SECRET_KEY=your_stripe_secret_key
STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key
STRIPE_WEBHOOK_SECRET=your_stripe_webhook_secret

# QuickBooks Online API
# Get yours at: https://developer.intuit.com/
QUICKBOOKS_CLIENT_ID=your_quickbooks_client_id
QUICKBOOKS_CLIENT_SECRET=your_quickbooks_client_secret
QUICKBOOKS_REALM_ID=your_quickbooks_company_id
QUICKBOOKS_REFRESH_TOKEN=your_quickbooks_refresh_token
QUICKBOOKS_ENVIRONMENT=sandbox # or production

# ==========================================
# CUSTOMER SUPPORT INTEGRATIONS
# ==========================================

# Zendesk API
# Get yours at: https://support.zendesk.com/hc/en-us/articles/4408889192858
ZENDESK_SUBDOMAIN=your-company
ZENDESK_EMAIL=your-email@company.com
ZENDESK_API_TOKEN=your_zendesk_api_token

# Freshdesk API (Optional)
FRESHDESK_DOMAIN=your-company.freshdesk.com
FRESHDESK_API_KEY=your_freshdesk_api_key

# ==========================================
# EMAIL & NOTIFICATION SERVICES
# ==========================================

# SendGrid (for return notifications)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=returns@yourcompany.com
SENDGRID_FROM_NAME=Your Company Returns

# Twilio (for SMS notifications - optional)
TWILIO_ACCOUNT_SID=your_twilio_account_sid
TWILIO_AUTH_TOKEN=your_twilio_auth_token
TWILIO_PHONE_NUMBER=+1234567890

# ==========================================
# AI/ML SERVICES (Predictive Analytics)
# ==========================================

# OpenAI API (for predictive analytics & recommendations)
OPENAI_API_KEY=your_openai_api_key
OPENAI_ORG_ID=your_openai_org_id

# Google Cloud AI Platform (Optional)
GCP_PROJECT_ID=your_gcp_project_id
GCP_SERVICE_ACCOUNT_KEY=path/to/service-account-key.json

# ==========================================
# RETURN SETTINGS (Optional Defaults)
# ==========================================

# Default return window (days)
DEFAULT_RETURN_WINDOW_DAYS=30

# Auto-approve returns under this amount (USD)
AUTO_APPROVE_THRESHOLD=50

# Fraud score threshold (0-100, higher = more suspicious)
FRAUD_HIGH_RISK_THRESHOLD=75
FRAUD_CRITICAL_THRESHOLD=90

# Resale automation settings
RESALE_AUTO_LIST=false # Auto-list approved items
RESALE_MIN_PROFIT_MARGIN=0.20 # 20% minimum margin

# ==========================================
# FEATURE FLAGS
# ==========================================

# Enable/disable advanced features
ENABLE_LABEL_GENERATION=true
ENABLE_FRAUD_DETECTION=true
ENABLE_REFURBISHMENT=true
ENABLE_RESALE_AUTOMATION=true
ENABLE_RTV_MANAGEMENT=true
ENABLE_PREDICTIVE_ANALYTICS=true
ENABLE_CUSTOMER_PORTAL=true

# ==========================================
# LOGGING & MONITORING
# ==========================================

# Sentry (Error tracking)
SENTRY_DSN=your_sentry_dsn
SENTRY_ENVIRONMENT=production

# LogRocket (Session replay - optional)
LOGROCKET_APP_ID=your_logrocket_app_id

# ==========================================
# COMPLIANCE & SECURITY
# ==========================================

# Data retention period (days)
DATA_RETENTION_DAYS=2555 # 7 years

# PII encryption key (generate with: openssl rand -base64 32)
PII_ENCRYPTION_KEY=your_encryption_key_here

# GDPR compliance
ENABLE_GDPR_COMPLIANCE=true
ENABLE_DATA_ANONYMIZATION=true

# ==========================================
# RATE LIMITING & PERFORMANCE
# ==========================================

# API rate limits (requests per minute)
RATE_LIMIT_RETURNS_API=60
RATE_LIMIT_LABELS_API=30
RATE_LIMIT_FRAUD_API=100

# Cache TTL (seconds)
CACHE_TTL_SETTINGS=3600 # 1 hour
CACHE_TTL_FORECASTS=1800 # 30 minutes

# ==========================================
# NOTES
# ==========================================
# 
# 1. Never commit this file with real credentials
# 2. Use .env.local for local development
# 3. Use environment variables in production (Vercel, AWS, etc.)
# 4. Rotate API keys regularly
# 5. Use different keys for sandbox/testing vs production
# 6. Keep backup of production keys in secure vault (1Password, AWS Secrets Manager, etc.)
# 
# For more information, see:
# - /docs/modules/RETURNS_MANAGEMENT_COMPLETE.md
# - /docs/ENVIRONMENT_VARIABLES.md
