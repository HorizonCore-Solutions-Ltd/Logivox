# =============================================================================
# LOGIVOX WMS - ENVIRONMENT VARIABLES
# =============================================================================
# IMPORTANT: Never commit actual secrets to version control!
# Copy this file to .env.local for local development
# Use secrets management (AWS Secrets Manager, Azure Key Vault) for production
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE CONFIGURATION
# -----------------------------------------------------------------------------
# PostgreSQL connection string
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=SCHEMA
# Production: Use managed database (AWS RDS, Azure Database, Google Cloud SQL)
DATABASE_URL="postgresql://username:password@localhost:5432/logivox?schema=public"

# Database connection pool settings (optional)
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_TIMEOUT=30000

# -----------------------------------------------------------------------------
# NEXTAUTH.JS AUTHENTICATION
# -----------------------------------------------------------------------------
# Application URL (must match your domain)
NEXTAUTH_URL="http://localhost:3000"

# Secret for JWT token signing (CRITICAL: Generate strong secret for production)
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-super-secret-key-change-this-in-production-use-openssl-rand-base64-32"

# Session configuration
SESSION_MAX_AGE=43200 # 12 hours in seconds
SESSION_UPDATE_AGE=1800 # 30 minutes in seconds

# -----------------------------------------------------------------------------
# OAUTH PROVIDERS
# -----------------------------------------------------------------------------
# Google OAuth 2.0
# Get credentials: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

# GitHub OAuth
# Get credentials: https://github.com/settings/developers
GITHUB_ID="your-github-client-id"
GITHUB_SECRET="your-github-client-secret"

# -----------------------------------------------------------------------------
# APPLICATION CONFIGURATION
# -----------------------------------------------------------------------------
# Public URL for the application
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Application name and branding
NEXT_PUBLIC_APP_NAME="LogiVox"

# Application environment
NODE_ENV="development" # Options: development, production, test

# -----------------------------------------------------------------------------
# EMAIL CONFIGURATION
# -----------------------------------------------------------------------------
# SMTP settings for transactional emails
SMTP_HOST="smtp.sendgrid.net"
SMTP_PORT=587
SMTP_USER="apikey"
SMTP_PASSWORD="your-sendgrid-api-key"
SMTP_FROM_EMAIL="noreply@logivox.ai"
SMTP_FROM_NAME="LogiVox WMS"

# SendGrid API (alternative to SMTP)
SENDGRID_API_KEY="your-sendgrid-api-key"

# Email templates
EMAIL_VERIFICATION_ENABLED=true
PASSWORD_RESET_ENABLED=true

# -----------------------------------------------------------------------------
# SMS CONFIGURATION (Twilio)
# -----------------------------------------------------------------------------
TWILIO_ACCOUNT_SID="your-twilio-account-sid"
TWILIO_AUTH_TOKEN="your-twilio-auth-token"
TWILIO_PHONE_NUMBER="+1234567890"
TWILIO_VERIFY_SERVICE_SID="your-verify-service-sid" # For 2FA/OTP

# SMS notifications enabled
SMS_NOTIFICATIONS_ENABLED=false

# -----------------------------------------------------------------------------
# STORAGE & FILE UPLOADS
# -----------------------------------------------------------------------------
# AWS S3 for file storage
AWS_ACCESS_KEY_ID="your-aws-access-key"
AWS_SECRET_ACCESS_KEY="your-aws-secret-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="logivox-uploads"

# Azure Blob Storage (alternative)
AZURE_STORAGE_ACCOUNT_NAME="your-storage-account"
AZURE_STORAGE_ACCOUNT_KEY="your-storage-key"
AZURE_STORAGE_CONTAINER="logivox-uploads"

# File upload limits
MAX_FILE_SIZE=10485760 # 10MB in bytes
ALLOWED_FILE_TYPES="image/jpeg,image/png,image/gif,application/pdf,text/csv"

# -----------------------------------------------------------------------------
# CARRIER INTEGRATIONS
# -----------------------------------------------------------------------------
# FedEx API
FEDEX_API_KEY="your-fedex-api-key"
FEDEX_SECRET_KEY="your-fedex-secret-key"
FEDEX_ACCOUNT_NUMBER="your-fedex-account"
FEDEX_METER_NUMBER="your-fedex-meter"
FEDEX_PRODUCTION=false # Set to true for production

# UPS API
UPS_ACCESS_KEY="your-ups-access-key"
UPS_USERNAME="your-ups-username"
UPS_PASSWORD="your-ups-password"
UPS_ACCOUNT_NUMBER="your-ups-account"
UPS_PRODUCTION=false

# USPS API
USPS_USERNAME="your-usps-username"
USPS_PASSWORD="your-usps-password"

# -----------------------------------------------------------------------------
# ERP/E-COMMERCE INTEGRATIONS
# -----------------------------------------------------------------------------
# SAP Integration
SAP_API_URL="https://your-sap-instance.com/api"
SAP_CLIENT_ID="your-sap-client-id"
SAP_CLIENT_SECRET="your-sap-client-secret"

# Oracle NetSuite
NETSUITE_ACCOUNT_ID="your-netsuite-account"
NETSUITE_CONSUMER_KEY="your-consumer-key"
NETSUITE_CONSUMER_SECRET="your-consumer-secret"
NETSUITE_TOKEN_ID="your-token-id"
NETSUITE_TOKEN_SECRET="your-token-secret"

# Shopify
SHOPIFY_STORE_URL="your-store.myshopify.com"
SHOPIFY_ACCESS_TOKEN="your-shopify-access-token"
SHOPIFY_API_KEY="your-shopify-api-key"
SHOPIFY_API_SECRET="your-shopify-api-secret"

# WooCommerce
WOOCOMMERCE_URL="https://your-store.com"
WOOCOMMERCE_CONSUMER_KEY="your-woocommerce-key"
WOOCOMMERCE_CONSUMER_SECRET="your-woocommerce-secret"

# -----------------------------------------------------------------------------
# PAYMENT PROCESSING
# -----------------------------------------------------------------------------
# Stripe
STRIPE_PUBLISHABLE_KEY="pk_test_..."
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# PayPal
PAYPAL_CLIENT_ID="your-paypal-client-id"
PAYPAL_CLIENT_SECRET="your-paypal-client-secret"
PAYPAL_MODE="sandbox" # Options: sandbox, live

# -----------------------------------------------------------------------------
# MONITORING & OBSERVABILITY
# -----------------------------------------------------------------------------
# Sentry for error tracking
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"
SENTRY_ORG="your-organization"
SENTRY_PROJECT="logivox-wms"

# Application Insights (Azure)
APPINSIGHTS_INSTRUMENTATIONKEY="your-instrumentation-key"

# New Relic
NEW_RELIC_LICENSE_KEY="your-new-relic-license"
NEW_RELIC_APP_NAME="LogiVox WMS"

# Prometheus metrics
METRICS_ENABLED=true
METRICS_PORT=9090

# Logging level
LOG_LEVEL="info" # Options: error, warn, info, debug, trace

# -----------------------------------------------------------------------------
# SECURITY CONFIGURATION
# -----------------------------------------------------------------------------
# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=60000 # 1 minute

# CORS configuration
CORS_ORIGIN="http://localhost:3000,https://app.logivox.ai"

# Content Security Policy
CSP_ENABLED=true

# Encryption keys
ENCRYPTION_KEY="your-encryption-key-for-sensitive-data" # Generate with: openssl rand -hex 32
ENCRYPTION_ALGORITHM="aes-256-gcm"

# Two-Factor Authentication
MFA_ENABLED=true
MFA_ISSUER="LogiVox WMS"

# API Key configuration
API_KEY_PREFIX="lv_"
API_KEY_LENGTH=32

# -----------------------------------------------------------------------------
# REDIS CACHE (Optional - for session storage & caching)
# -----------------------------------------------------------------------------
REDIS_URL="redis://localhost:6379"
REDIS_PASSWORD="your-redis-password"
REDIS_TLS_ENABLED=false

# Cache TTL settings
CACHE_TTL_DEFAULT=3600 # 1 hour
CACHE_TTL_LONG=86400 # 24 hours

# -----------------------------------------------------------------------------
# WEBHOOKS & BACKGROUND JOBS
# -----------------------------------------------------------------------------
# Webhook retry configuration
WEBHOOK_MAX_RETRIES=3
WEBHOOK_RETRY_DELAY=1000 # milliseconds

# Background job processing
JOB_QUEUE_URL="redis://localhost:6379"
JOB_CONCURRENCY=5

# -----------------------------------------------------------------------------
# AI & MACHINE LEARNING (Optional)
# -----------------------------------------------------------------------------
# OpenAI for AI Assistant
OPENAI_API_KEY="sk-..."
OPENAI_MODEL="gpt-4"
OPENAI_MAX_TOKENS=4000

# Azure OpenAI (alternative)
AZURE_OPENAI_API_KEY="your-azure-openai-key"
AZURE_OPENAI_ENDPOINT="https://your-resource.openai.azure.com/"
AZURE_OPENAI_DEPLOYMENT="gpt-4"

# -----------------------------------------------------------------------------
# FEATURE FLAGS
# -----------------------------------------------------------------------------
NEXT_PUBLIC_ENABLE_ANALYTICS=false
NEXT_PUBLIC_ENABLE_PWA=false
NEXT_PUBLIC_ENABLE_VOICE=true
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=false
NEXT_PUBLIC_ENABLE_MOBILE_APP=true
NEXT_PUBLIC_ENABLE_INTEGRATIONS=true

# Multi-tenant features
NEXT_PUBLIC_ENABLE_MULTI_TENANT=true
NEXT_PUBLIC_ENABLE_CUSTOM_DOMAINS=false

# Advanced features
NEXT_PUBLIC_ENABLE_SLOTTING_OPTIMIZATION=true
NEXT_PUBLIC_ENABLE_LOAD_PLANNING=true
NEXT_PUBLIC_ENABLE_YARD_MANAGEMENT=true
NEXT_PUBLIC_ENABLE_GATE_SECURITY=true
NEXT_PUBLIC_ENABLE_3PL_BILLING=true

# -----------------------------------------------------------------------------
# DEVELOPMENT & TESTING
# -----------------------------------------------------------------------------
# Debug mode
DEBUG=false
VERBOSE_LOGGING=false

# Skip certain validations in development
SKIP_ENV_VALIDATION=false

# Test database (for CI/CD)
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5432/logivox_test?schema=public"

# Seed data
SEED_DEMO_DATA=false

# -----------------------------------------------------------------------------
# KUBERNETES & DEPLOYMENT
# -----------------------------------------------------------------------------
# Health check configuration
HEALTH_CHECK_ENABLED=true
HEALTH_CHECK_PATH="/api/health"

# Graceful shutdown
SHUTDOWN_TIMEOUT=30000 # 30 seconds

# Pod configuration
POD_NAME="${HOSTNAME}"
POD_NAMESPACE="production"

# -----------------------------------------------------------------------------
# ANALYTICS & TRACKING
# -----------------------------------------------------------------------------
# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Mixpanel
NEXT_PUBLIC_MIXPANEL_TOKEN="your-mixpanel-token"

# Segment
SEGMENT_WRITE_KEY="your-segment-write-key"

# -----------------------------------------------------------------------------
# COMPLIANCE & LEGAL
# -----------------------------------------------------------------------------
# GDPR compliance
GDPR_ENABLED=true
DATA_RETENTION_DAYS=2555 # 7 years

# Terms of Service and Privacy Policy URLs
NEXT_PUBLIC_TOS_URL="https://logivox.ai/terms"
NEXT_PUBLIC_PRIVACY_URL="https://logivox.ai/privacy"

# -----------------------------------------------------------------------------
# SUPPORT & HELPDESK
# -----------------------------------------------------------------------------
# Intercom
NEXT_PUBLIC_INTERCOM_APP_ID="your-intercom-app-id"

# Zendesk
ZENDESK_SUBDOMAIN="your-subdomain"
ZENDESK_EMAIL="support@logivox.ai"
ZENDESK_API_TOKEN="your-zendesk-token"

# Support email
SUPPORT_EMAIL="support@logivox.ai"
SUPPORT_PHONE="+1-800-LOGIVOX"
