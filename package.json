{
  "name": "logivox",
  "version": "1.0.0",
  "description": "LogiVox - The Autonomous Cognitive WMS (Enterprise v1)",
  "private": true,
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "start": "turbo run start",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "lint:security": "eslint . --ext .ts,.tsx,.js,.jsx --config .eslintrc.security.js",
    "type-check": "turbo run type-check",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "test:coverage": "turbo run test:coverage",
    "test:all": "npm run test && npm run test:integration && npm run test:e2e",
    "test:e2e": "turbo run test:e2e",
    "test:integration": "turbo run test:integration",
    "test:security": "turbo run test:security",
    "test:security:e2e": "playwright test --grep @security",
    "clean": "turbo run clean && rm -rf node_modules",
    "db:generate": "turbo run db:generate",
    "db:push": "turbo run db:push",
    "db:migrate": "turbo run db:migrate",
    "db:seed": "turbo run db:seed",
    "db:studio": "turbo run db:studio",
    "db:reset": "turbo run db:reset",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md,mdx}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md,mdx}\"",
    "prepare": "husky install",
    "changeset": "changeset",
    "version-packages": "changeset version",
    "release": "turbo run build && changeset publish",
    "security:scan": "npm run audit:deps && npm run security:secrets",
    "security:secrets": "echo 'GitLeaks: Install via: brew install gitleaks' || true",
    "security:deps": "npm audit --audit-level=moderate",
    "audit:full": "npm audit",
    "audit:deps": "npm audit --audit-level=high",
    "audit:fix": "npm audit fix",
    "deploy:setup": "./scripts/setup-production-db.sh",
    "deploy:build": "npm run build && npm run test:e2e",
    "deploy:validate": "playwright test e2e/production-validation.spec.ts",
    "health:check": "curl -f http://localhost:3000/api/health || exit 1",
    "health:db": "curl -f http://localhost:3000/api/health/database || exit 1"
  },
  "devDependencies": {
    "@changesets/cli": "^2.27.1",
    "@commitlint/cli": "^18.4.3",
    "@commitlint/config-conventional": "^18.4.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@testing-library/user-event": "^14.6.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/jest": "^30.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.19.27",
    "@typescript-eslint/eslint-plugin": "^6.13.1",
    "@typescript-eslint/parser": "^6.13.1",
    "eslint": "^8.54.0",
    "eslint-config-next": "^14.0.4",
    "eslint-config-prettier": "^9.0.0",
    "eslint-plugin-import": "^2.29.0",
    "eslint-plugin-jsx-a11y": "^6.8.0",
    "eslint-plugin-react": "^7.33.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-security": "^1.7.1",
    "eslint-plugin-testing-library": "^6.2.0",
    "husky": "^8.0.3",
    "jest-environment-jsdom": "^30.2.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.1.0",
    "prettier-plugin-tailwindcss": "^0.5.7",
    "prisma": "^6.17.1",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "turbo": "^1.11.2",
    "typescript": "^5.3.3"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,mdx}": [
      "prettier --write"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "packageManager": "npm@10.2.4",
  "dependencies": {
    "@auth/prisma-adapter": "^2.11.0",
    "@aws-sdk/client-secrets-manager": "^3.1000.0",
    "@aws-sdk/client-sesv2": "^3.1000.0",
    "@heroicons/react": "^2.2.0",
    "@prisma/client": "^6.19.2",
    "@sendgrid/mail": "^8.1.6",
    "@types/lru-cache": "^7.10.9",
    "@types/nodemailer": "^7.0.4",
    "@types/qrcode": "^1.5.6",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.2",
    "crypto": "^1.0.1",
    "framer-motion": "^12.34.5",
    "lru-cache": "^11.2.5",
    "lucide-react": "^0.577.0",
    "next-auth": "^4.24.11",
    "nodemailer": "^6.10.1",
    "otplib": "^12.0.1",
    "pdfkit": "^0.17.2",
    "pino": "^10.3.1",
    "pino-pretty": "^13.1.3",
    "prom-client": "^15.1.3",
    "qrcode": "^1.5.4",
    "stripe": "^20.1.0",
    "twilio": "^5.11.1",
    "uuid": "^13.0.0",
    "zod": "^4.3.6"
  }
}
