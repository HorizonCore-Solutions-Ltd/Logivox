{
  "expo": {
    "name": "Flowstock",
    "slug": "flowstock-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icons/icon.png",
    "scheme": "flowstock",
    "userInterfaceStyle": "automatic",
    "splash": {
      "image": "./assets/icons/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#1a1a2e"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.flowstock.mobile",
      "buildNumber": "1",
      "infoPlist": {
        "NSCameraUsageDescription": "Flowstock uses the camera for barcode scanning and photo documentation.",
        "NSMicrophoneUsageDescription": "Flowstock uses the microphone for voice commands.",
        "NSFaceIDUsageDescription": "Flowstock uses Face ID for secure login.",
        "NSLocationWhenInUseUsageDescription": "Flowstock uses location for yard management check-in.",
        "UIBackgroundModes": ["fetch", "remote-notification"]
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-icon.png",
        "backgroundColor": "#1a1a2e"
      },
      "package": "com.flowstock.mobile",
      "versionCode": 1,
      "permissions": [
        "CAMERA",
        "RECORD_AUDIO",
        "USE_BIOMETRIC",
        "USE_FINGERPRINT",
        "VIBRATE",
        "RECEIVE_BOOT_COMPLETED",
        "ACCESS_NETWORK_STATE",
        "ACCESS_WIFI_STATE"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/icons/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Allow Flowstock to use Face ID."
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Flowstock to access your camera for scanning."
        }
      ],
      [
        "expo-av",
        {
          "microphonePermission": "Allow Flowstock to access your microphone for voice commands."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icons/notification-icon.png",
          "color": "#6366f1",
          "sounds": []
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {
        "origin": false
      },
      "eas": {
        "projectId": "flowstock-mobile"
      }
    }
  }
}
