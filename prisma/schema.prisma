// ==========================================
// SECURITY & ACCESS CONTROL
// ==========================================

model SecurityPersonnel {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String?  @unique // Link to Employee if they're also an employee
  
  // Personal Information
  firstName      String
  lastName       String
  email          String?
  phone          String?
  badgeNumber    String   @unique
  
  // Employment
  status         SecurityPersonnelStatus @default(ACTIVE)
  hireDate       DateTime
  terminationDate DateTime?
  
  // Assignment
  warehouseId    String?
  primaryZone    String?
  
  // Credentials & Clearance
  clearanceLevel SecurityClearanceLevel @default(STANDARD)
  certifications Json? // Array of security certifications
  trainingExpiry DateTime?
  
  // Access Card
  accessCardNumber String?
  accessCardExpiry DateTime?
  
  // Metadata
  notes          String?  @db.Text
  metadata       Json?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee       Employee?         @relation(fields: [employeeId], references: [id])
  shifts         SecurityShift[]
  incidents      SecurityIncident[] @relation("IncidentReporter")
  investigations SecurityIncident[] @relation("IncidentInvestigator")
  gateEntries    GateEntry[]
  accessLogs     SecurityAccessLog[]
  visitors       Visitor[]
  
  @@unique([organizationId, badgeNumber])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([status])
  @@index([clearanceLevel])
  @@map("security_personnel")
}

model SecurityShift {
  id             String   @id @default(cuid())
  organizationId String
  personnelId    String
  
  // Shift Details
  shiftDate      DateTime
  shiftType      ShiftType @default(DAY)
  startTime      DateTime
  endTime        DateTime?
  
  // Location
  warehouseId    String?
  assignedZone   String?
  assignedPost   String? // "Main Gate", "Loading Dock", "Patrol", etc.
  
  // Status
  status         ShiftStatus @default(SCHEDULED)
  checkInTime    DateTime?
  checkOutTime   DateTime?
  
  // Activities
  patrols        Int      @default(0)
  incidentsReported Int   @default(0)
  visitorsProcessed Int   @default(0)
  
  // Metadata
  notes          String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  personnel      SecurityPersonnel   @relation(fields: [personnelId], references: [id])
  
  @@index([organizationId])
  @@index([personnelId])
  @@index([shiftDate])
  @@index([warehouseId])
  @@map("security_shifts")
}

model GateEntry {
  id             String   @id @default(cuid())
  organizationId String
  entryNumber    String
  
  // Entry Details
  entryType      GateEntryType
  direction      EntryDirection
  warehouseId    String?
  gateNumber     String?
  
  // Vehicle Information
  vehicleType    VehicleType?
  vehicleNumber  String?
  licensePlate   String?
  trailerNumber  String?
  driverName     String?
  driverLicense  String?
  driverPhone    String?
  carrierName    String?
  
  // Visitor Information (for VISITOR type)
  visitorName    String?
  visitorCompany String?
  visitorId      String?
  visitorPhone   String?
  visitorEmail   String?
  purposeOfVisit String?
  hostName       String? // Employee being visited
  
  // Dock Appointment Link
  appointmentId  String?
  
  // Reference Documents
  referenceType  String? // "PURCHASE_ORDER", "SALES_ORDER", "DELIVERY", etc.
  referenceId    String?
  referenceNumber String?
  
  // Security Check
  securityPersonnelId String?
  securityCheckPassed Boolean @default(false)
  securityNotes       String? @db.Text
  
  // Timing
  scheduledTime  DateTime?
  entryTime      DateTime
  exitTime       DateTime?
  duration       Int? // Minutes
  
  // Items/Cargo
  cargoDescription String? @db.Text
  numberOfPallets  Int?
  estimatedWeight  Float?
  hasDangerousGoods Boolean @default(false)
  
  // Photos/Documents
  vehiclePhoto   String? // URL
  driverIdPhoto  String? // URL
  documents      Json? // Array of document URLs
  
  // Status
  status         GateEntryStatus @default(CHECKED_IN)
  
  // Approval
  approvedBy     String?
  approvedAt     DateTime?
  
  // Metadata
  notes          String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  securityPersonnel SecurityPersonnel? @relation(fields: [securityPersonnelId], references: [id])
  appointment    DockAppointment? @relation(fields: [appointmentId], references: [id])
  weighBridges   GateWeighBridge[]
  photos         GatePhoto[]
  queueEntry     GateQueue?
  temperatureLogs TemperatureLog[]
  hazmatRecords  HazmatRecord[]
  gateDocuments  GateDocument[]
  manifest       TruckManifest?
  
  @@unique([organizationId, entryNumber])
  @@index([organizationId])
  @@index([appointmentId])
  @@index([warehouseId])
  @@index([entryTime])
  @@index([licensePlate])
  @@index([status])
  @@map("gate_entries")
}

model Visitor {
  id             String   @id @default(cuid())
  organizationId String
  
  // Visitor Information
  firstName      String
  lastName       String
  company        String?
  email          String?
  phone          String
  idType         String? // "DRIVERS_LICENSE", "PASSPORT", etc.
  idNumber       String?
  
  // Badge
  badgeNumber    String?
  badgeIssued    DateTime?
  badgeReturned  DateTime?
  
  // Visit Details
  visitDate      DateTime
  checkInTime    DateTime
  checkOutTime   DateTime?
  purposeOfVisit String   @db.Text
  
  // Host Information
  hostName       String
  hostDepartment String?
  hostPhone      String?
  
  // Location
  warehouseId    String?
  allowedAreas   Json? // Array of zone IDs visitor can access
  
  // Security
  securityCheckPassed Boolean @default(false)
  securityPersonnelId String?
  securityPersonnel   SecurityPersonnel? @relation(fields: [securityPersonnelId], references: [id])
  
  // Photos
  photo          String? // URL to visitor photo
  idPhoto        String? // URL to ID photo
  
  // Status
  status         VisitorStatus @default(CHECKED_IN)
  
  // Emergency Contact
  emergencyContact String?
  emergencyPhone   String?
  
  // Escort Required
  escortRequired Boolean @default(false)
  escortName     String?
  
  // Metadata
  notes          String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  preRegistration VisitorPreRegistration?
  
  @@unique([organizationId, badgeNumber])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([visitDate])
  @@index([status])
  @@index([phone])
  @@map("visitors")
}

model SecurityIncident {
  id             String   @id @default(cuid())
  organizationId String
  incidentNumber String
  
  // Incident Details
  incidentType   SecurityIncidentType
  severity       IncidentSeverity
  title          String
  description    String   @db.Text
  
  // Location
  warehouseId    String?
  locationDetails String? @db.Text
  zoneId         String?
  
  // Timing
  incidentDate   DateTime
  reportedAt     DateTime @default(now())
  
  // People Involved
  reportedById   String
  reportedBy     SecurityPersonnel @relation("IncidentReporter", fields: [reportedById], references: [id])
  
  investigatorId String?
  investigatedBy SecurityPersonnel? @relation("IncidentInvestigator", fields: [investigatorId], references: [id])
  
  personsInvolved Json? // Array of person details
  witnesses       Json? // Array of witness details
  
  // Related Entities
  relatedEntityType String? // "GATE_ENTRY", "VISITOR", "EMPLOYEE", etc.
  relatedEntityId   String?
  
  // Investigation
  status         IncidentStatus @default(REPORTED)
  investigationNotes String? @db.Text
  actionTaken    String? @db.Text
  resolution     String? @db.Text
  resolvedAt     DateTime?
  
  // Police/Authorities
  policeNotified Boolean @default(false)
  policeReportNumber String?
  policeDepartment String?
  
  // Evidence
  photos         Json? // Array of photo URLs
  videos         Json? // Array of video URLs
  documents      Json? // Array of document URLs
  cameraFootage  Json? // Array of camera IDs and timestamps
  
  // Follow-up
  followUpRequired Boolean @default(false)
  followUpDate     DateTime?
  followUpNotes    String? @db.Text
  
  // Metadata
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
