  resolutionStatus  String   @default("PENDING") @map("resolution_status") // PENDING, RTV_REQUESTED, RTV_APPROVED, CREDITED, REPLACED, ACCEPTED_WITH_DISCOUNT, REJECTED
  resolutionNotes   String?  @map("resolution_notes") @db.Text
  resolutionDate    DateTime? @map("resolution_date")
  
  // Root cause (optional)
  rootCause         String?  @map("root_cause") @db.Text
  correctiveAction  String?  @map("corrective_action") @db.Text
  
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  // Relations
  inspection        QCReceivingInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  item              QCInspectionItem      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  organization      Organization          @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rtv               RTV?
  
  @@index([inspectionId])
  @@index([itemId])
  @@index([organizationId])
  @@index([defectType])
  @@index([defectCategory])
  @@index([resolutionStatus])
  @@index([createdAt])
  @@map("qc_defects")
}

model RTV {
  id                  String   @id @default(cuid())
  rtvNumber           String   @unique @map("rtv_number")
  organizationId      String   @map("organization_id")
  defectId            String   @unique @map("defect_id")
  poId                String   @map("po_id")
  vendorId            String   @map("vendor_id")
  warehouseId         String   @map("warehouse_id")
  
  // Return details
  reason              String   @db.Text
  quantity            Int
  value               Decimal  @db.Decimal(10, 2)
  
  // Vendor response
  vendorRmaNumber     String?  @map("vendor_rma_number")
  vendorResponseDate  DateTime? @map("vendor_response_date")
  vendorNotes         String?  @map("vendor_notes") @db.Text
  
  // Status tracking
  status              String   @default("PENDING") // PENDING, VENDOR_NOTIFIED, APPROVED, REJECTED, SHIPPED, RECEIVED_BY_VENDOR, CREDITED, REPLACED, CLOSED, CANCELLED
  
  // Shipping details
  carrier             String?
  trackingNumber      String?  @map("tracking_number")
  labelUrl            String?  @map("label_url")
  shippingCost        Decimal? @map("shipping_cost") @db.Decimal(8, 2)
  shippedAt           DateTime? @map("shipped_at")
  deliveredAt         DateTime? @map("delivered_at")
  
  // Resolution
  resolutionType      String?  @map("resolution_type") // CREDIT, REPLACEMENT, REFUSED, PARTIAL_CREDIT
  creditAmount        Decimal? @map("credit_amount") @db.Decimal(10, 2)
  creditMemoNumber    String?  @map("credit_memo_number")
  creditedAt          DateTime? @map("credited_at")
  
  // Replacement tracking
  replacementPoId     String?  @map("replacement_po_id")
  replacementReceived Boolean  @map("replacement_received") @default(false)
  replacementDate     DateTime? @map("replacement_date")
  
  // Internal tracking
  priority            String   @default("MEDIUM") // URGENT, HIGH, MEDIUM, LOW
  assignedTo          String?  @map("assigned_to")
  internalNotes       String?  @map("internal_notes") @db.Text
  
  createdAt           DateTime @default(now()) @map("created_at")
  createdBy           String   @map("created_by")
  updatedAt           DateTime @updatedAt @map("updated_at")
  
  // Relations
  organization        Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  defect              QCDefect     @relation(fields: [defectId], references: [id])
  purchaseOrder       PurchaseOrder @relation(fields: [poId], references: [id])
  vendor              Vendor       @relation(fields: [vendorId], references: [id])
  warehouse           Warehouse    @relation(fields: [warehouseId], references: [id])
  activities          RTVActivity[]
  
  @@index([organizationId])
  @@index([vendorId])
  @@index([warehouseId])
  @@index([poId])
  @@index([status])
  @@index([createdAt])
  @@map("rtvs")
}

model RTVActivity {
  id          String   @id @default(cuid())
  rtvId       String   @map("rtv_id")
  activityType String  @map("activity_type") // CREATED, VENDOR_NOTIFIED, APPROVED, SHIPPED, RECEIVED, CREDITED, etc.
  description String   @db.Text
  performedBy String   @map("performed_by")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")
  
  rtv         RTV      @relation(fields: [rtvId], references: [id], onDelete: Cascade)
  
  @@index([rtvId])
  @@index([createdAt])
  @@map("rtv_activities")
}

model VendorQualityScore {
  id                   String   @id @default(cuid())
  organizationId       String   @map("organization_id")
  vendorId             String   @map("vendor_id")
  
  // Lifetime statistics
  totalPurchaseOrders  Int      @default(0) @map("total_purchase_orders")
  totalUnitsReceived   Int      @default(0) @map("total_units_received")
  totalDefectiveUnits  Int      @default(0) @map("total_defective_units")
  totalRtvCount        Int      @default(0) @map("total_rtv_count")
  totalRtvValue        Decimal  @default(0) @map("total_rtv_value") @db.Decimal(12, 2)
  
  // Rolling 90-day metrics
  recent90DaysOrders   Int      @default(0) @map("recent_90days_orders")
  recent90DaysUnits    Int      @default(0) @map("recent_90days_units")
  recent90DaysDefects  Int      @default(0) @map("recent_90days_defects")
  recent90DaysRtv      Int      @default(0) @map("recent_90days_rtv")
  
  // Calculated metrics
  lifetimeDefectRate   Decimal  @default(0) @map("lifetime_defect_rate") @db.Decimal(5, 4) // Percentage
  recent90DefectRate   Decimal  @default(0) @map("recent_90_defect_rate") @db.Decimal(5, 4)
  avgResolutionDays    Int?     @map("avg_resolution_days")
  
  // Quality scoring (0-100)
  qualityScore         Int      @default(100) @map("quality_score")
  reliabilityScore     Int      @default(100) @map("reliability_score")
  responseScore        Int      @default(100) @map("response_score")
  overallScore         Int      @default(100) @map("overall_score")
  
  // Status and classification
  status               String   @default("APPROVED") // APPROVED, PROBATION, SUSPENDED, BLOCKED
  tier                 String   @default("STANDARD") @map("tier") // PREMIUM, STANDARD, BASIC, POOR
  
  // Incident tracking
  lastDefectDate       DateTime? @map("last_defect_date")
  lastRtvDate          DateTime? @map("last_rtv_date")
  lastInspectionDate   DateTime? @map("last_inspection_date")
  consecutiveGoodOrders Int     @default(0) @map("consecutive_good_orders")
  
  // Review and notes
  lastReviewDate       DateTime? @map("last_review_date")
  lastReviewedBy       String?   @map("last_reviewed_by")
  reviewNotes          String?   @map("review_notes") @db.Text
  
  createdAt            DateTime @default(now()) @map("created_at")
  updatedAt            DateTime @updatedAt @map("updated_at")
  
  // Relations
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  vendor               Vendor       @relation(fields: [vendorId], references: [id])
  
  @@unique([organizationId, vendorId])
  @@index([organizationId])
  @@index([vendorId])
  @@index([qualityScore])
  @@index([status])
  @@map("vendor_quality_scores")
}

model QCInspectionTemplate {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  name              String
  description       String?  @db.Text
  
  // Template scope
  templateType      String   @map("template_type") // PRODUCT_SPECIFIC, CATEGORY, VENDOR_SPECIFIC, UNIVERSAL
  targetId          String?  @map("target_id") // Product ID, Category ID, or Vendor ID
  
  // Inspection configuration
  inspectionType    String   @map("inspection_type") // FULL, SAMPLE, VISUAL, FUNCTIONAL
  sampleSizePercent Int?     @map("sample_size_percent") // For SAMPLE type (1-100)
  minSampleSize     Int?     @map("min_sample_size")
  maxSampleSize     Int?     @map("max_sample_size")
  
  // Checklist (JSON array of inspection points)
  checklist         Json     // Array of { id, description, type, required, pass_criteria, fail_action }
  
  // Acceptance criteria
  aqlLevel          String?  @map("aql_level") // Acceptable Quality Limit (e.g., "1.0", "2.5", "4.0")
  criticalDefectAql Decimal? @map("critical_defect_aql") @db.Decimal(4, 2)
  majorDefectAql    Decimal? @map("major_defect_aql") @db.Decimal(4, 2)
  minorDefectAql    Decimal? @map("minor_defect_aql") @db.Decimal(4, 2)
  
  // Settings
  requirePhotos     Boolean  @default(false) @map("require_photos")
  photoMinCount     Int?     @map("photo_min_count")
  autoAssign        Boolean  @default(true) @map("auto_assign")
  priority          String   @default("MEDIUM")
  
  // Status
  active            Boolean  @default(true)
  version           Int      @default(1)
  
  createdAt         DateTime @default(now()) @map("created_at")
  createdBy         String   @map("created_by")
  updatedAt         DateTime @updatedAt @map("updated_at")
  
  // Relations
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@index([organizationId])
  @@index([templateType])
  @@index([active])
  @@map("qc_inspection_templates")
}

model QCInspectionActivity {
  id              String   @id @default(cuid())
  inspectionId    String   @map("inspection_id")
  activityType    String   @map("activity_type") // CREATED, ASSIGNED, STARTED, PAUSED, RESUMED, COMPLETED, CANCELLED, etc.
  description     String   @db.Text
  performedBy     String   @map("performed_by")
  metadata        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  
  inspection      QCReceivingInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  
  @@index([inspectionId])
  @@index([createdAt])
  @@map("qc_inspection_activities")
}

model QCSettings {
  organizationId         String   @id @map("organization_id")
  
  // General settings
  enableAutoInspection   Boolean  @default(true) @map("enable_auto_inspection")
  inspectionTrigger      String   @default("ON_RECEIPT") @map("inspection_trigger") // ON_RECEIPT, ON_PUTAWAY, MANUAL
  defaultInspectionType  String   @default("SAMPLE") @map("default_inspection_type")
  defaultSamplePercent   Int      @default(10) @map("default_sample_percent")
  
  // Vendor-based rules
  newVendorInspection    String   @default("FULL") @map("new_vendor_inspection") // FULL, SAMPLE, VISUAL
  trustedVendorSampling  Int      @default(5) @map("trusted_vendor_sampling") // %
  
  // Defect handling
  autoQuarantine         Boolean  @default(true) @map("auto_quarantine")
  autoCreateRtv          Boolean  @default(false) @map("auto_create_rtv")
  criticalDefectAction   String   @default("REJECT") @map("critical_defect_action") // REJECT, QUARANTINE, ACCEPT_WITH_DISCOUNT
  
  // Photo requirements
  requireDefectPhotos    Boolean  @default(true) @map("require_defect_photos")
  minDefectPhotos        Int      @default(2) @map("min_defect_photos")
  
  // Notifications
  notifyOnDefect         Boolean  @default(true) @map("notify_on_defect")
  notifyVendorAutomatic  Boolean  @default(false) @map("notify_vendor_automatic")
  escalationThreshold    Int      @default(3) @map("escalation_threshold") // Number of defects before escalation
  
  // Scoring and performance
  updateVendorScores     Boolean  @default(true) @map("update_vendor_scores")
  scoreUpdateFrequency   String   @default("DAILY") @map("score_update_frequency") // REALTIME, DAILY, WEEKLY
  
  // RTV settings
  rtvApprovalRequired    Boolean  @default(true) @map("rtv_approval_required")
  rtvApprovalThreshold   Decimal  @default(500) @map("rtv_approval_threshold") @db.Decimal(10, 2)
  autoRequestVendorRma   Boolean  @default(true) @map("auto_request_vendor_rma")
  
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  
  organization           Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@map("qc_settings")
}

// ==========================================
// CROSS-DOCKING MODULE
// ==========================================

enum CrossDockType {
  DIRECT        // Direct transfer from inbound to outbound
  MERGE         // Multiple inbound to single outbound
  SPLIT         // Single inbound to multiple outbound
  TRANSLOAD     // Container-to-container transfer
  CONSOLIDATION // Consolidate multiple shipments
}

enum CrossDockStatus {
  SCHEDULED     // Appointment scheduled
  RECEIVING     // Inbound receiving in progress
  SORTING       // Items being sorted/allocated
  STAGED        // Staged for outbound loading
  LOADING       // Loading onto outbound trucks
  COMPLETED     // Cross-dock completed
  CANCELLED     // Operation cancelled
}

enum SortingMethod {
  MANUAL        // Manual sorting by workers
  SCAN_SORT     // Scan-based sorting
  CONVEYOR      // Automated conveyor sorting
  VOICE         // Voice-directed sorting
  PUT_WALL      // Put wall sorting system
}

model CrossDockingAppointment {
  id                  String              @id @default(cuid())
  appointmentNumber   String              @unique @map("appointment_number")
  organizationId      String              @map("organization_id")
  warehouseId         String              @map("warehouse_id")
  
  // Appointment details
  type                CrossDockType
  status              CrossDockStatus     @default(SCHEDULED)
  priority            String              @default("MEDIUM") // LOW, MEDIUM, HIGH, URGENT
  
  // Inbound details
  inboundDoorId       String?             @map("inbound_door_id")
  inboundCarrier      String?             @map("inbound_carrier")
  inboundVehicleId    String?             @map("inbound_vehicle_id")
  expectedArrival     DateTime            @map("expected_arrival")
  actualArrival       DateTime?           @map("actual_arrival")
  
  // Outbound details
  outboundDoorIds     String[]            @map("outbound_door_ids") // Can load to multiple doors
  targetShipDate      DateTime            @map("target_ship_date")
  actualShipDate      DateTime?           @map("actual_ship_date")
  
  // Operational
  sortingMethod       SortingMethod       @default(MANUAL) @map("sorting_method")
  sortingAreaId       String?             @map("sorting_area_id") // Location used for sorting
  maxDwellTime        Int                 @default(4) @map("max_dwell_time") // Hours allowed in cross-dock
  
  // Metrics
  totalUnits          Int                 @default(0) @map("total_units")
  receivedUnits       Int                 @default(0) @map("received_units")
  sortedUnits         Int                 @default(0) @map("sorted_units")
  shippedUnits        Int                 @default(0) @map("shipped_units")
  dwellTimeMinutes    Int?                @map("dwell_time_minutes") // Actual time from receipt to ship
  
  // Notes
  notes               String?             @db.Text
  specialInstructions String?             @map("special_instructions") @db.Text
  
  // Timestamps
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")
  completedAt         DateTime?           @map("completed_at")
  
  // Relations
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse           Warehouse           @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  inboundDoor         DockDoor?           @relation("InboundDoor", fields: [inboundDoorId], references: [id])
  inboundVehicle      Vehicle?            @relation("CrossDockInbound", fields: [inboundVehicleId], references: [id])
  sortingArea         Location?           @relation("CrossDockSorting", fields: [sortingAreaId], references: [id])
  receipts            CrossDockReceipt[]
  shipments           CrossDockShipment[]
  sortingTasks        CrossDockSorting[]
  activities          CrossDockActivity[]
  
  @@index([organizationId])
  @@index([warehouseId])
  @@index([status])
  @@index([expectedArrival])
  @@index([targetShipDate])
  @@map("cross_docking_appointments")
}

model CrossDockReceipt {
  id                  String                    @id @default(cuid())
  receiptNumber       String                    @unique @map("receipt_number")
  appointmentId       String                    @map("appointment_id")
  organizationId      String                    @map("organization_id")
  
  // Receipt details
  supplierId          String?                   @map("supplier_id")
  carrier             String?
  referenceNumber     String?                   @map("reference_number") // PO, ASN, BOL
  
  // Status
  status              String                    @default("RECEIVING") // RECEIVING, COMPLETED
  
  // Timestamps
  receivedAt          DateTime                  @default(now()) @map("received_at")
  completedAt         DateTime?                 @map("completed_at")
  
  // Relations
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment         CrossDockingAppointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  supplier            Supplier?                 @relation(fields: [supplierId], references: [id])
  items               CrossDockReceiptItem[]
  
  @@index([organizationId])
  @@index([appointmentId])
  @@index([supplierId])
  @@map("cross_dock_receipts")
}

model CrossDockReceiptItem {
  id                  String              @id @default(cuid())
  receiptId           String              @map("receipt_id")
  organizationId      String              @map("organization_id")
  
  // Product details
  inventoryId         String              @map("inventory_id")
  sku                 String
  productName         String              @map("product_name")
  
  // Quantities
  quantityReceived    Int                 @map("quantity_received")
  quantityAllocated   Int                 @default(0) @map("quantity_allocated")
  quantityShipped     Int                 @default(0) @map("quantity_shipped")
  quantityRemaining   Int                 @default(0) @map("quantity_remaining")
  
  // Traceability
  lotNumber           String?             @map("lot_number")
  serialNumbers       String[]            @map("serial_numbers")
  
  // Location
  currentLocationId   String?             @map("current_location_id") // Where it's staged
  
  // Timestamps
  receivedAt          DateTime            @default(now()) @map("received_at")
  
  // Relations
  organization        Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receipt             CrossDockReceipt    @relation(fields: [receiptId], references: [id], onDelete: Cascade)
  inventory           InventoryItem       @relation(fields: [inventoryId], references: [id])
  currentLocation     Location?           @relation("CrossDockItemLocation", fields: [currentLocationId], references: [id])
  allocations         CrossDockAllocation[]
  
  @@index([organizationId])
  @@index([receiptId])
  @@index([inventoryId])
  @@index([sku])
  @@map("cross_dock_receipt_items")
}

model CrossDockShipment {
  id                  String                    @id @default(cuid())
  shipmentNumber      String                    @unique @map("shipment_number")
  appointmentId       String                    @map("appointment_id")
  organizationId      String                    @map("organization_id")
  
  // Shipment details
  customerId          String?                   @map("customer_id")
  salesOrderId        String?                   @map("sales_order_id")
  carrier             String?
  trackingNumber      String?                   @map("tracking_number")
  
  // Door assignment
  outboundDoorId      String?                   @map("outbound_door_id")
  loadSheetId         String?                   @map("load_sheet_id")
  
  // Status
  status              String                    @default("PLANNED") // PLANNED, PICKING, STAGED, LOADING, SHIPPED
  
  // Metrics
  totalUnits          Int                       @default(0) @map("total_units")
  packedUnits         Int                       @default(0) @map("packed_units")
  
  // Timestamps
  targetShipDate      DateTime                  @map("target_ship_date")
  shippedAt           DateTime?                 @map("shipped_at")
  createdAt           DateTime                  @default(now()) @map("created_at")
  
  // Relations
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment         CrossDockingAppointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  customer            Customer?                 @relation(fields: [customerId], references: [id])
  salesOrder          SalesOrder?               @relation(fields: [salesOrderId], references: [id])
  outboundDoor        DockDoor?                 @relation("OutboundDoor", fields: [outboundDoorId], references: [id])
  loadSheet           LoadSheet?                @relation(fields: [loadSheetId], references: [id])
  allocations         CrossDockAllocation[]
  
  @@index([organizationId])
  @@index([appointmentId])
  @@index([customerId])
  @@index([salesOrderId])
  @@index([status])
  @@map("cross_dock_shipments")
}

model CrossDockAllocation {
  id                  String                  @id @default(cuid())
  organizationId      String                  @map("organization_id")
  
  // Source (inbound)
  receiptItemId       String                  @map("receipt_item_id")
  
  // Destination (outbound)
  shipmentId          String                  @map("shipment_id")
  
  // Allocation details
  quantityAllocated   Int                     @map("quantity_allocated")
  quantityPicked      Int                     @default(0) @map("quantity_picked")
  quantityShipped     Int                     @default(0) @map("quantity_shipped")
  
  // Status
  status              String                  @default("ALLOCATED") // ALLOCATED, PICKING, PICKED, STAGED, LOADED, SHIPPED
  
  // Assignment
  assignedTo          String?                 @map("assigned_to") // Worker assigned to pick
  
  // Timestamps
  allocatedAt         DateTime                @default(now()) @map("allocated_at")
  pickedAt            DateTime?               @map("picked_at")
  shippedAt           DateTime?               @map("shipped_at")
  
  // Relations
  organization        Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  receiptItem         CrossDockReceiptItem    @relation(fields: [receiptItemId], references: [id], onDelete: Cascade)
  shipment            CrossDockShipment       @relation(fields: [shipmentId], references: [id], onDelete: Cascade)
  
  @@index([organizationId])
  @@index([receiptItemId])
  @@index([shipmentId])
  @@index([status])
  @@map("cross_dock_allocations")
}

model CrossDockSorting {
  id                  String                    @id @default(cuid())
  appointmentId       String                    @map("appointment_id")
  organizationId      String                    @map("organization_id")
  
  // Sorting details
  sortingMethod       SortingMethod
  sortingAreaId       String                    @map("sorting_area_id")
  
  // Assignment
  assignedWorkerId    String?                   @map("assigned_worker_id")
  teamSize            Int                       @default(1) @map("team_size")
  
  // Progress
  status              String                    @default("PENDING") // PENDING, IN_PROGRESS, COMPLETED
  totalUnits          Int                       @default(0) @map("total_units")
  sortedUnits         Int                       @default(0) @map("sorted_units")
  
  // Performance metrics
  unitsPerHour        Decimal?                  @map("units_per_hour") @db.Decimal(10, 2)
  accuracy            Decimal?                  @db.Decimal(5, 2) // Percentage
  
  // Timestamps
  startedAt           DateTime?                 @map("started_at")
  completedAt         DateTime?                 @map("completed_at")
  createdAt           DateTime                  @default(now()) @map("created_at")
  
  // Relations
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment         CrossDockingAppointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  sortingArea         Location                  @relation("SortingTaskArea", fields: [sortingAreaId], references: [id])
  
  @@index([organizationId])
  @@index([appointmentId])
  @@index([status])
  @@map("cross_dock_sorting")
}

model CrossDockActivity {
  id                  String                    @id @default(cuid())
  appointmentId       String                    @map("appointment_id")
  organizationId      String                    @map("organization_id")
  
  // Activity details
  action              String                    // CREATED, RECEIVED, SORTED, ALLOCATED, SHIPPED, etc.
  description         String                    @db.Text
  performedBy         String?                   @map("performed_by")
  
  // Metadata
  metadata            Json?                     // Additional contextual data
  
  // Timestamp
  performedAt         DateTime                  @default(now()) @map("performed_at")
  
  // Relations
  organization        Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointment         CrossDockingAppointment   @relation(fields: [appointmentId], references: [id], onDelete: Cascade)
  
  @@index([organizationId])
  @@index([appointmentId])
  @@index([performedAt])
  @@map("cross_dock_activities")
}

model CrossDockSettings {
  organizationId            String    @id @map("organization_id")
  
  // Operational settings
  enableAutomaticMatching   Boolean   @default(true) @map("enable_automatic_matching")
  matchingStrategy          String    @default("FIFO") @map("matching_strategy") // FIFO, LIFO, CLOSEST_DUE_DATE
  defaultDwellTimeHours     Int       @default(4) @map("default_dwell_time_hours")
  maxDwellTimeHours         Int       @default(24) @map("max_dwell_time_hours")
  
  // Sorting settings
  defaultSortingMethod      SortingMethod @default(MANUAL) @map("default_sorting_method")
  requireScanValidation     Boolean   @default(true) @map("require_scan_validation")
  enableVoiceDirected       Boolean   @default(false) @map("enable_voice_directed")
  
  // Allocation rules
  allowPartialAllocations   Boolean   @default(true) @map("allow_partial_allocations")
  reserveBuffer             Decimal   @default(0) @map("reserve_buffer") @db.Decimal(5, 2) // % to reserve
  priorityAllocation        Boolean   @default(true) @map("priority_allocation") // Allocate high priority first
  
  // Performance thresholds
  targetDwellTime           Int       @default(2) @map("target_dwell_time") // Hours
  targetThroughput          Int       @default(100) @map("target_throughput") // Units per hour
  alertThreshold            Int       @default(80) @map("alert_threshold") // % of max dwell time
  
  // Notifications
  notifyOnArrival           Boolean   @default(true) @map("notify_on_arrival")
  notifyOnDelay             Boolean   @default(true) @map("notify_on_delay")
  notifyOnCompletion        Boolean   @default(false) @map("notify_on_completion")
  escalateDelays            Boolean   @default(true) @map("escalate_delays")
  
  // Integration
  autoCreateShipments       Boolean   @default(true) @map("auto_create_shipments")
  syncWithLoadPlanning      Boolean   @default(true) @map("sync_with_load_planning")
  updateInventoryRealtime   Boolean   @default(false) @map("update_inventory_realtime")
  
  createdAt                 DateTime  @default(now()) @map("created_at")
  updatedAt                 DateTime  @updatedAt @map("updated_at")
  
  organization              Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  @@map("cross_dock_settings")
}

