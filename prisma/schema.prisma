// ─── Autonomous Wave Generation ──────────────────────────────────────────────

model WaveAutomationRule {
  id                    String                    @id @default(cuid())
  organizationId        String
  warehouseId           String
  name                  String
  description           String?
  isActive              Boolean                   @default(true)
  triggerType           WaveRuleTrigger
  /// For THRESHOLD trigger: minimum number of pending orders before wave fires
  pendingOrderThreshold Int?
  /// For THRESHOLD trigger: minimum total order lines before wave fires
  pendingLineThreshold  Int?
  /// For SCHEDULE trigger: cron expression e.g. "0 8 * * 1-5"
  cronExpression        String?
  /// Default wave settings applied when auto-creating
  defaultWaveType       WaveType                  @default(BATCH)
  defaultPriority       WavePriority              @default(NORMAL)
  defaultStrategy       WaveStrategy              @default(FIFO)
  defaultMaxOrders      Int?
  defaultMaxLines       Int?
  /// Only include orders whose ship date is within this many hours
  shipWindowHours       Int?
  /// Carrier filter (optional)
  carrierFilter         String[]
  /// Minimum time between automatic firings (minutes)
  cooldownMinutes       Int                       @default(30)
  lastFiredAt           DateTime?
  nextScheduledAt       DateTime?
  fireCount             Int                       @default(0)
  successCount          Int                       @default(0)
  failureCount          Int                       @default(0)
  status                WaveRuleStatus            @default(IDLE)
  lastError             String?
  tags                  String[]
  metadata              Json?
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  createdById           String
  createdBy             User                      @relation("WaveRuleCreator", fields: [createdById], references: [id])
  organization          Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse             Warehouse                 @relation(fields: [warehouseId], references: [id], onDelete: Cascade)
  executions            WaveAutomationExecution[]

  @@index([organizationId, warehouseId])
  @@index([isActive, triggerType])
  @@index([nextScheduledAt])
}

model WaveAutomationExecution {
  id             String             @id @default(cuid())
  organizationId String
  ruleId         String
  triggeredBy    String             @default("SYSTEM")
  triggerData    Json
  status         ExecutionStatus    @default(PENDING)
  wavePickId     String?
  waveNumber     String?
  ordersIncluded Int                @default(0)
  linesIncluded  Int                @default(0)
  startedAt      DateTime?
  completedAt    DateTime?
  durationMs     Int?
  error          String?
  createdAt      DateTime           @default(now())
  rule           WaveAutomationRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId, ruleId])
  @@index([status])
  @@index([createdAt])
}

enum WaveRuleTrigger {
  THRESHOLD
  SCHEDULE
  DEMAND_SPIKE
}

enum WaveRuleStatus {
  IDLE
  EVALUATING
  FIRING
  ERROR
  PAUSED
}

// ─────────────────────────────────────────────────────────────────────────────
// REPLENISHMENT ENGINE
// ─────────────────────────────────────────────────────────────────────────────

model ReplenishmentRule {
  id                   String              @id @default(cuid())
  organizationId       String
  warehouseId          String?
  inventoryItemId      String? // null = apply to all items matching filter
  name                 String
  strategy             ReplenishStrategy   @default(MIN_MAX)
  // ── Classic strategy params ───────────────────────────────────────────────
  minQty               Int                 @default(0)
  maxQty               Int                 @default(0)
  reorderPoint         Int                 @default(0)
  reorderQty           Int                 @default(0)
  demandDays           Int                 @default(30)
  leadTimeDays         Int                 @default(3)
  reviewFrequencyDays  Int                 @default(7)
  nextReviewDate       DateTime?
  // ── Next-gen params ───────────────────────────────────────────────────────
  replenUnit           ReplenUnit          @default(EACH)
  triggerSource        ReplenTriggerSource @default(RULE_SCAN)
  forecastHorizonDays  Int                 @default(14) // PREDICTIVE
  iotDeviceId          String? // IOT_TRIGGERED – watching device
  wavePreFillHours     Int                 @default(2) // WAVE_AWARE
  microTaskSplitQty    Int                 @default(0) // CONTINUOUS_MICRO; 0 = no split
  costOptTarget        String              @default("LABOUR") // LABOUR|ROBOT|COMBINED
  maxCostPerUnit       Decimal?            @db.Decimal(10, 4)
  featureFlagOverrides Json?
  // ── Supplier / PO ─────────────────────────────────────────────────────────
  supplierId           String?
  autoCreatePO         Boolean             @default(false)
  isActive             Boolean             @default(true)
  lastTriggeredAt      DateTime?
  createdById          String
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  tasks                ReplenishmentTask[]
  organization         Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse            Warehouse?          @relation("ReplenRuleWarehouse", fields: [warehouseId], references: [id])
  inventoryItem        InventoryItem?      @relation("ReplenRuleItem", fields: [inventoryItemId], references: [id])
  supplier             Supplier?           @relation("ReplenRuleSupplier", fields: [supplierId], references: [id])

  @@index([organizationId])
  @@index([warehouseId])
  @@index([inventoryItemId])
  @@index([isActive])
  @@index([strategy])
  @@map("replenishment_rules")
}

model ReplenishmentTask {
  id                 String                    @id @default(cuid())
  organizationId     String
  ruleId             String?
  warehouseId        String
  inventoryItemId    String
  fromLocationId     String?
  toLocationId       String?
  purchaseOrderId    String?
  // ── Quantities ────────────────────────────────────────────────────────────
  requiredQty        Int
  pickedQty          Int                       @default(0)
  orderedQty         Int                       @default(0)
  replenUnit         ReplenUnit                @default(EACH)
  // ── Status & metadata ─────────────────────────────────────────────────────
  status             ReplenishTaskStatus       @default(PENDING)
  priority           Priority                  @default(MEDIUM)
  triggerSource      ReplenTriggerSource       @default(RULE_SCAN)
  // ── Assignment ────────────────────────────────────────────────────────────
  assignedToId       String?
  startedAt          DateTime?
  completedAt        DateTime?
  notes              String?
  // ── Micro-task hierarchy ──────────────────────────────────────────────────
  parentTaskId       String? // null = root task
  // ── Cost tracking ─────────────────────────────────────────────────────────
  estimatedCostUsd   Decimal?                  @db.Decimal(10, 4)
  actualCostUsd      Decimal?                  @db.Decimal(10, 4)
  labourMinutes      Int?
  // ── AI quality signal ─────────────────────────────────────────────────────
  forecastConfidence Float?
  createdAt          DateTime                  @default(now())
  updatedAt          DateTime                  @updatedAt
  // ── Relations ─────────────────────────────────────────────────────────────
  rule               ReplenishmentRule?        @relation(fields: [ruleId], references: [id])
  organization       Organization              @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItem      InventoryItem             @relation("ReplenTaskItem", fields: [inventoryItemId], references: [id])
  warehouse          Warehouse                 @relation("ReplenTaskWarehouse", fields: [warehouseId], references: [id])
  fromLocation       Location?                 @relation("ReplenFromLocation", fields: [fromLocationId], references: [id])
  toLocation         Location?                 @relation("ReplenToLocation", fields: [toLocationId], references: [id])
  assignedTo         User?                     @relation("ReplenAssignedTo", fields: [assignedToId], references: [id])
  purchaseOrder      PurchaseOrder?            @relation(fields: [purchaseOrderId], references: [id])
  parentTask         ReplenishmentTask?        @relation("ReplenMicroTask", fields: [parentTaskId], references: [id])
  childTasks         ReplenishmentTask[]       @relation("ReplenMicroTask")
  iotTriggers        ReplenishmentIoTTrigger[]
  waveBinds          ReplenishmentWaveBind[]
  robotJob           ReplenishmentRobotJob?
  costLog            ReplenishmentCostLog?

  @@index([organizationId])
  @@index([warehouseId])
  @@index([status])
  @@index([assignedToId])
  @@index([purchaseOrderId])
  @@index([parentTaskId])
  @@index([triggerSource])
  @@map("replenishment_tasks")
}

enum ReplenishStrategy {
  MIN_MAX
  REORDER_POINT
  DEMAND_BASED
  PERIODIC_REVIEW
  PREDICTIVE // AI/ML demand-based forecast
  WAVE_AWARE // pre-fill before an upcoming wave releases
  IOT_TRIGGERED // sensor/RFID/vision event fires the task
  COST_OPTIMISED // cheapest time/method to replenish
  CONTINUOUS_MICRO // split into small opportunistic micro-tasks
}

enum ReplenishTaskStatus {
  PENDING
  IN_PROGRESS
  PO_CREATED
  COMPLETED
  CANCELLED
  FAILED
}

enum ReplenUnit {
  PALLET
  CASE
  INNER_PACK
  EACH
}

enum ReplenTriggerSource {
  MANUAL
  RULE_SCAN
  IOT_SENSOR
  WAVE_PRE_FILL
  AI_PREDICTION
  COST_OPTIMISED
  ROBOT_SCAN
  PERIODIC_REVIEW
}

enum RobotJobStatus {
  QUEUED
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  FAILED
  ABORTED
}

