/// Per-organisation feature flags that gate advanced replenishment capabilities.
model ReplenishmentFeatureFlag {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  predictiveAI         Boolean      @default(false)
  aiModelVersion       String? // EWMA | ARIMA | PROPHET | NEURAL
  forecastRefreshHours Int          @default(24)
  iotTriggers          Boolean      @default(false)
  robotics             Boolean      @default(false)
  waveAware            Boolean      @default(false)
  microTasks           Boolean      @default(false)
  costOptimisation     Boolean      @default(false)
  digitalTwin          Boolean      @default(false)
  billingIntegration   Boolean      @default(false)
  autoApprovalLimitUsd Decimal      @default(0) @db.Decimal(10, 2)
  createdAt            DateTime     @default(now())
  updatedAt            DateTime     @updatedAt
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@map("replenishment_feature_flags")
}

/// AI/ML demand forecast cache per SKU, used by PREDICTIVE strategy.
model ReplenishmentForecastCache {
  id                String        @id @default(cuid())
  organizationId    String
  inventoryItemId   String
  horizonDays       Int
  dailyDemand       Float
  safetyStockQty    Int
  recommendedQty    Int
  confidence        Float
  modelType         String        @default("EWMA")
  seasonalityFactor Float         @default(1.0)
  trendFactor       Float         @default(0.0)
  rawPredictions    Json // [{ date, qty, lower, upper }]
  metadata          Json?
  generatedAt       DateTime      @default(now())
  expiresAt         DateTime
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem @relation("ReplenForecastItem", fields: [inventoryItemId], references: [id])

  @@index([organizationId, inventoryItemId])
  @@index([expiresAt])
  @@map("replenishment_forecast_cache")
}

/// IoT sensor event that triggered (or was evaluated for) replenishment.
model ReplenishmentIoTTrigger {
  id              String             @id @default(cuid())
  organizationId  String
  deviceId        String
  inventoryItemId String?
  locationId      String?
  warehouseId     String
  eventType       String // WEIGHT_LOW | PICK_FACE_EMPTY | RFID_DEPLETION | VISION_DETECT
  sensorValue     Float?
  threshold       Float?
  rawPayload      Json
  processed       Boolean            @default(false)
  taskId          String?
  processedAt     DateTime?
  failureReason   String?
  createdAt       DateTime           @default(now())
  organization    Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device          IoTDevice          @relation(fields: [deviceId], references: [id])
  inventoryItem   InventoryItem?     @relation("ReplenIoTItem", fields: [inventoryItemId], references: [id])
  task            ReplenishmentTask? @relation(fields: [taskId], references: [id])

  @@index([organizationId])
  @@index([deviceId])
  @@index([processed])
  @@index([createdAt])
  @@map("replenishment_iot_triggers")
}

/// Binds a replenishment task to an upcoming wave pick for pre-fill scheduling.
model ReplenishmentWaveBind {
  id             String            @id @default(cuid())
  organizationId String
  waveId         String
  taskId         String
  bindReason     String? // pre-fill | shortage-prevention
  requiredByTime DateTime?
  resolved       Boolean           @default(false)
  resolvedAt     DateTime?
  createdAt      DateTime          @default(now())
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wave           WavePick          @relation(fields: [waveId], references: [id])
  task           ReplenishmentTask @relation(fields: [taskId], references: [id])

  @@unique([waveId, taskId])
  @@index([organizationId])
  @@index([waveId])
  @@index([resolved])
  @@map("replenishment_wave_binds")
}

/// Robot (AMR/AS-RS) job dispatched for a replenishment task.
model ReplenishmentRobotJob {
  id             String            @id @default(cuid())
  organizationId String
  taskId         String            @unique
  robotId        String
  jobReference   String?
  status         RobotJobStatus    @default(QUEUED)
  fromLocationId String?
  toLocationId   String?
  qty            Int
  startedAt      DateTime?
  completedAt    DateTime?
  failureReason  String?
  telemetry      Json? // { position, batteryPct, speedMps }
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  task           ReplenishmentTask @relation(fields: [taskId], references: [id])
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([robotId])
  @@index([status])
  @@map("replenishment_robot_jobs")
}

/// Detailed cost breakdown logged after a replenishment task completes.
model ReplenishmentCostLog {
  id                String            @id @default(cuid())
  organizationId    String
  taskId            String            @unique
  labourCostUsd     Decimal           @default(0) @db.Decimal(10, 4)
  equipmentCostUsd  Decimal           @default(0) @db.Decimal(10, 4)
  congestionCostUsd Decimal           @default(0) @db.Decimal(10, 4)
  robotCostUsd      Decimal           @default(0) @db.Decimal(10, 4)
  storageCostUsd    Decimal           @default(0) @db.Decimal(10, 4)
  totalCostUsd      Decimal           @default(0) @db.Decimal(10, 4)
  costPerUnit       Decimal?          @db.Decimal(10, 4)
  labourMinutes     Int               @default(0)
  distanceMetres    Float             @default(0)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
