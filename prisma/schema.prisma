  checklistItems   Json?
  requiresEvidence Boolean      @default(false)
  evidenceTypes    String[]
  isActive         Boolean      @default(true)
  metadata         Json?
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  duties           Duty[]
  organization     Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, name])
  @@index([organizationId])
  @@index([category])
  @@map("duty_types")
}

model Duty {
  id                 String         @id @default(cuid())
  organizationId     String
  dutyTypeId         String?
  shiftId            String?
  employeeId         String?
  assignedBy         String?
  zoneId             String?
  zoneName           String?
  warehouseId        String?
  title              String
  description        String?
  category           DutyCategory   @default(OTHER)
  status             DutyStatus     @default(PLANNED)
  priority           DutyPriority   @default(MEDIUM)
  scheduledStart     DateTime?
  scheduledEnd       DateTime?
  actualStart        DateTime?
  actualEnd          DateTime?
  durationMinutes    Int?
  slaMinutes         Int?
  slaBreached        Boolean        @default(false)
  capaId             String?
  capaStage          String?
  ncrId              String?
  autoAssigned       Boolean        @default(false)
  assignmentRule     String?
  voiceScriptRef     String?
  voiceSessionId     String?
  checklistItems     Json?
  completionNotes    String?
  rejectionReason    String?
  previousEmployeeId String?
  reassignReason     String?
  reassignCount      Int            @default(0)
  metadata           Json?
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt
  dutyType           DutyType?      @relation(fields: [dutyTypeId], references: [id])
  organization       Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  evidence           DutyEvidence[]

  @@index([organizationId])
  @@index([status])
  @@index([employeeId])
  @@index([shiftId])
  @@index([capaId])
  @@index([scheduledStart])
  @@index([slaBreached])
  @@map("duties")
}

model DutyEvidence {
  id           String       @id @default(cuid())
