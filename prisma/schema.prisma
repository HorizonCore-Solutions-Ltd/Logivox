// ─── LoadSheet & related models ─────────────────────────────────────────────

model BayDoor {
  id             String       @id @default(cuid())
  organizationId String
  warehouseId    String?
  doorNumber     String
  doorType       String? // INBOUND | OUTBOUND | CROSS_DOCK
  status         String       @default("AVAILABLE") // AVAILABLE | OCCUPIED | MAINTENANCE | CLOSED
  isActive       Boolean      @default(true)
  notes          String?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse      Warehouse?   @relation(fields: [warehouseId], references: [id])
  loadSheets     LoadSheet[]

  @@unique([organizationId, doorNumber])
  @@index([organizationId])
  @@index([warehouseId])
  @@map("bay_doors")
}

model LoadSheet {
  id                 String    @id @default(cuid())
  organizationId     String
  warehouseId        String?
  loadSheetNumber    String
  status             String    @default("BUILDING") // BUILDING | CONFIRMED | APPROVED | DISTRIBUTED | DEPARTED | CANCELLED
  generationMethod   String    @default("MANUAL") // REALTIME | MANUAL
  autoGenerated      Boolean   @default(false)
  shipmentDate       DateTime
  customerId         String?
  destinationAddress String?
  destinationBranch  String?
  routeCode          String?
  carrierName        String?
  carrierCode        String?
  driverName         String?
  driverPhone        String?
  trailerNumber      String?
  bayDoorId          String?
  totalContainers    Int       @default(0)
  totalWeight        Float     @default(0)
  totalVolume        Float     @default(0)
  totalPallets       Int       @default(0)
  totalBoxes         Int       @default(0)
  totalItems         Int       @default(0)
  totalOrders        Int       @default(0)
  approved           Boolean   @default(false)
  approvedBy         String?
  approvedAt         DateTime?
  approvalNotes      String?
  distributed        Boolean   @default(false)
  distributedAt      DateTime?

  // Timing & KPI Fields
  scheduledDeparture DateTime? // Target departure time
  startedLoadingAt   DateTime? // When the first item was scanned/loaded
  finishedLoadingAt  DateTime? // When the last item was loaded
  actualDeparture    DateTime? // When the truck left the geofence/gate
  delayReason        String? // "Traffic", "Warehouse Delay", "Paperwork", etc.
  detentionMinutes   Int?      @default(0) // Billable detention time

  notes                  String?
  metadata               Json?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  loadSheetDistributions LoadSheetDistribution[]
  events                 LoadSheetEvent[]
  containers             Container[]
  bayDoor                BayDoor?                @relation(fields: [bayDoorId], references: [id])
  customer               Customer?               @relation(fields: [customerId], references: [id])
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse              Warehouse?              @relation(fields: [warehouseId], references: [id])
  vehicleType            FleetVehicleType?       @relation(fields: [vehicleTypeId], references: [id])
  vehicleTypeId          String?

  @@unique([organizationId, loadSheetNumber])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([customerId])
  @@index([shipmentDate])
  @@index([status])
  @@map("load_sheets")
}

model FleetVehicleType {
  id             String       @id @default(cuid())
  organizationId String
  name           String // e.g. "53ft Dry Van", "26ft Box Truck"
  description    String?
  length         Float // in meters or feet
  width          Float
  height         Float
  maxWeight      Float // kg
  maxVolume      Float // cubic meters
  metadata       Json?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loadSheets     LoadSheet[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("fleet_vehicle_types")
}

model LoadSheetDistribution {
  id             String    @id @default(cuid())
  loadSheetId    String
  recipientEmail String
  recipientName  String?
  sentAt         DateTime  @default(now())
  sentBy         String?
  organizationId String
  loadSheet      LoadSheet @relation(fields: [loadSheetId], references: [id], onDelete: Cascade)

  @@index([loadSheetId])
  @@index([organizationId])
  @@map("load_sheet_distributions")
}

model LoadSheetEvent {
  id             String    @id @default(cuid())
  loadSheetId    String
  eventType      String // CREATED | APPROVED | DISTRIBUTED | DEPARTED | MODIFIED
  userId         String?
  userName       String?
  automated      Boolean   @default(false)
  notes          String?
  eventData      Json?
  organizationId String
  createdAt      DateTime  @default(now())
  loadSheet      LoadSheet @relation(fields: [loadSheetId], references: [id], onDelete: Cascade)

  @@index([loadSheetId])
  @@index([organizationId])
  @@index([eventType])
  @@map("load_sheet_events")
}

model Container {
  id              String          @id @default(cuid())
  organizationId  String
  loadSheetId     String?
  containerNumber String?
  containerType   String          @default("PALLET") // PALLET | BOX | OTHER
  status          String          @default("BUILDING") // BUILDING | READY | SHIPPED | CANCELLED
  weight          Float?
  volume          Float?
  shippedAt       DateTime?
  notes           String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  containerItems  ContainerItem[]
  loadSheet       LoadSheet?      @relation(fields: [loadSheetId], references: [id])

  @@index([loadSheetId])
  @@index([organizationId])
  @@index([status])
  @@map("containers")
}

model ContainerItem {
  id              String         @id @default(cuid())
  containerId     String
  salesOrderId    String?
  inventoryItemId String?
  sku             String
  description     String?
  quantity        Int
  weight          Float?
  volume          Float?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  container       Container      @relation(fields: [containerId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  salesOrder      SalesOrder?    @relation(fields: [salesOrderId], references: [id])

  @@index([containerId])
  @@index([salesOrderId])
  @@index([inventoryItemId])
  @@map("container_items")
}

model YardMove {
  id             String         @id @default(cuid())
  organizationId String
  warehouseId    String
  trailerNumber  String
  fromLocationId String
  toLocationId   String
  appointmentId  String?
  status         YardMoveStatus @default(PENDING)
  priority       Int            @default(1)
  assignedToId   String? // Yard jockey user ID
  completedBy    String?
  completedAt    DateTime?
  startedAt      DateTime?
  notes          String?
  metadata       Json?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  fromLocation YardLocation     @relation("MovesFrom", fields: [fromLocationId], references: [id])
  toLocation   YardLocation     @relation("MovesTo", fields: [toLocationId], references: [id])
  appointment  DockAppointment? @relation(fields: [appointmentId], references: [id])
  organization Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignedTo   User?            @relation("YardMoveAssignee", fields: [assignedToId], references: [id])

  @@index([organizationId])
  @@index([warehouseId])
  @@index([status])
  @@index([assignedToId])
  @@map("yard_moves")
}

enum YardMoveStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

