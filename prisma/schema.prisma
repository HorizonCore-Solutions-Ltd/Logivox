// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTHENTICATION & USER MANAGEMENT
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // For email/password auth
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts                     Account[]
  sessions                     Session[]
  organizationMemberships      OrganizationMember[]
  createdOrganizations         Organization[]           @relation("OrganizationCreator")
  createdInventoryItems        InventoryItem[]          @relation("InventoryCreator")
  createdBookings              Booking[]                @relation("BookingCreator")
  createdPurchaseOrders        PurchaseOrder[]          @relation("POCreator")
  approvedPurchaseOrders       PurchaseOrder[]          @relation("POApprover")
  receivedGRNs                 GoodsReceiptNote[]       @relation("GRNReceivedBy")
  qcGRNs                       GoodsReceiptNote[]       @relation("GRNQCBy")
  createdSalesOrders           SalesOrder[]             @relation("SOCreator")
  approvedSalesOrders          SalesOrder[]             @relation("SOApprover")
  pickedSalesOrders            SalesOrder[]             @relation("SOPicker")
  packedSalesOrders            SalesOrder[]             @relation("SOPacker")
  assignedPickLists            PickList[]               @relation("PickListAssignee")
  createdPickLists             PickList[]               @relation("PickListCreator")
  createdShipments             Shipment[]               @relation("ShipmentCreator")
  createdPacks                 Pack[]                   @relation("PackCreator")
  initiatedPacks               Pack[]                   @relation("PackInitiator")
  requestedTransfers           WarehouseTransfer[]      @relation("TransferRequestedBy")
  approvedTransfers            WarehouseTransfer[]      @relation("TransferApprovedBy")
  completedTransfers           WarehouseTransfer[]      @relation("TransferCompletedBy")
  createdAdjustments           StockAdjustment[]        @relation("AdjustmentCreatedBy")
  approvedAdjustments          StockAdjustment[]        @relation("AdjustmentApprovedBy")
  completedAdjustments         StockAdjustment[]        @relation("AdjustmentCompletedBy")
  assignedCycleCounts          CycleCount[]             @relation("AssignedCycleCounts")
  approvedCycleCounts          CycleCount[]             @relation("ApprovedCycleCounts")
  countedItems                 CycleCountItem[]         @relation("CountedItems")
  reconciledItems              CycleCountItem[]         @relation("ReconciledItems")
  approvedRMAs                 RMA[]                    @relation("RMAApprovedBy")
  inspectedRMAs                RMA[]                    @relation("RMAInspectedBy")
  restockedRMAItems            RMAItem[]                @relation("RMARestockedBy")
  inspectedQC                  QCInspection[]           @relation("QCInspector")
  performedCheckpoints         QCCheckpoint[]           @relation("CheckpointPerformer")
  qcApprovals                  QCApproval[]             @relation("QCApprover")
  approvedBOMs                 BillOfMaterials[]        @relation("BOMApprover")
  createdAssemblyOrders        AssemblyOrder[]          @relation("AssemblyCreator")
  assignedAssemblyOrders       AssemblyOrder[]          @relation("AssemblyAssignee")
  issuedComponents             AssemblyComponentIssue[] @relation("ComponentIssuer")
  returnedComponents           AssemblyComponentIssue[] @relation("ComponentReturner")
  productionLogs               AssemblyProductionLog[]  @relation("ProductionOperator")
  createdReports               Report[]                 @relation("ReportCreator")
  executedReports              ReportExecution[]        @relation("ReportExecutor")
  createdDashboards            Dashboard[]              @relation("DashboardCreator")
  analyticsEvents              AnalyticsEvent[]         @relation("AnalyticsUser")
  createdNotificationTemplates NotificationTemplate[]   @relation("NotificationTemplateCreator")
  receivedNotifications        Notification[]           @relation("NotificationRecipient")
  createdNotifications         Notification[]           @relation("NotificationCreator")
  createdAlertRules            AlertRule[]              @relation("AlertRuleCreator")
  acknowledgedAlerts           Alert[]                  @relation("AlertAcknowledger")
  resolvedAlerts               Alert[]                  @relation("AlertResolver")
  notificationPreference       NotificationPreference?
  createdExternalIntegrations  ExternalIntegration[]    @relation("ExternalIntegrationCreator")
  createdConnections           IntegrationConnection[]  @relation("ConnectionCreator")
  triggeredSyncs               IntegrationSync[]        @relation("SyncTriggeredBy")
  createdMappings              IntegrationMapping[]     @relation("MappingCreator")
  integrationLogs              IntegrationLog[]         @relation("LogUser")
  createdWebhooks              IntegrationWebhook[]     @relation("WebhookCreator")
  activityLogs                 ActivityLog[]

  // Phase 9 Day 20-21: Wave & Task Management Relations
  assignedWaves       WavePick[]       @relation("WaveAssignee")
  createdWaves        WavePick[]       @relation("WaveCreator")
  assignedPickLines   WavePickLine[]   @relation("LinePickerAssignee")
  pickedLines         WavePickLine[]   @relation("LinePicker")
  verifiedLines       WavePickLine[]   @relation("LineVerifier")
  assignedTasks       PickingTask[]    @relation("TaskAssignee")
  completedTasks      PickingTask[]    @relation("TaskCompleter")
  createdTasks        PickingTask[]    @relation("TaskCreator")
  assignedRoutes      PickingRoute[]   @relation("RouteAssignee")
  createdRoutes       PickingRoute[]   @relation("RouteCreator")
  assignedAutomations TaskAutomation[] @relation("AutomationAssignee")
  createdAutomations  TaskAutomation[] @relation("AutomationCreator")
  
  // Labor Management
  employee            Employee?
  
  // QC Module Relations
  qcReceivingInspections QCReceivingInspection[] @relation("QCReceivingInspector")

  @@index([email])
  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum UserRole {
  SUPER_ADMIN // Platform administrator
  ADMIN // Organization administrator
  MANAGER // Department/warehouse manager
  USER // Regular user
  VIEWER // Read-only access
}

// ==========================================
// MULTI-TENANT ORGANIZATION MANAGEMENT
// ==========================================

model Organization {
  id           String  @id @default(cuid())
  name         String
  slug         String  @unique
  domain       String? @unique // Custom domain for white-labeling
  logo         String?
  primaryColor String? @default("#3B82F6")
  isActive     Boolean @default(true)

  // Subscription & billing
  subscriptionTier   SubscriptionTier @default(FREE)
  subscriptionStatus String?          @default("active")
  billingEmail       String?

  // Settings
  timezone String @default("UTC")
  currency String @default("USD")
  
  // Security Settings (Configurable per organization)
  securitySettings Json? // Visitor policies, gate rules, etc.

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  // Relations
  createdBy              User                    @relation("OrganizationCreator", fields: [createdById], references: [id])
  members                OrganizationMember[]
  warehouses             Warehouse[]
  inventoryItems         InventoryItem[]
  bookings               Booking[]
  categories             Category[]
  suppliers              Supplier[]
  customers              Customer[]
  purchaseOrders         PurchaseOrder[]
  goodsReceiptNotes      GoodsReceiptNote[]
  salesOrders            SalesOrder[]
  pickLists              PickList[]
  shipments              Shipment[]
  packs                  Pack[]
  carrierConfigs         CarrierConfig[]
  locations              Location[]
  warehouseTransfers     WarehouseTransfer[]
  stockAdjustments       StockAdjustment[]
  cycleCounts            CycleCount[]
  returnReasons          ReturnReason[]
  rmas                   RMA[]
  lots                   Lot[]
  serialNumbers          SerialNumber[]
  lotMovements           LotMovement[]
  serialMovements        SerialMovement[]
  lotGenealogies         LotGenealogy[]
  inspectionTemplates    InspectionTemplate[]
  qcInspections          QCInspection[]
  billsOfMaterials       BillOfMaterials[]
  assemblyOrders         AssemblyOrder[]
  reports                Report[]
  reportExecutions       ReportExecution[]
  dashboards             Dashboard[]
  analyticsEvents        AnalyticsEvent[]
  kpiMetrics             KPIMetric[]
  notificationTemplates  NotificationTemplate[]
  notifications          Notification[]
  alertRules             AlertRule[]
  alerts                 Alert[]
  integrations           Integration[]
  externalIntegrations   ExternalIntegration[]
  integrationConnections IntegrationConnection[]
  integrationSyncs       IntegrationSync[]
  integrationMappings    IntegrationMapping[]
  integrationLogs        IntegrationLog[]
  integrationWebhooks    IntegrationWebhook[]
  apiKeys                ApiKey[]
  activityLogs           ActivityLog[]
  reorderAlerts          ReorderAlert[]

  // Phase 9 Day 20-21: Wave & Task Management Relations
  waves           WavePick[]
  wavePickLines   WavePickLine[]
  pickingTasks    PickingTask[]
  pickingRoutes   PickingRoute[]
  taskAutomations TaskAutomation[]
  taskExecutions  TaskExecution[]
  
  // New Features Relations
  employees              Employee[]
  shifts                 Shift[]
  shiftAssignments       ShiftAssignment[]
  timeEntries            TimeEntry[]
  productivityRecords    ProductivityRecord[]
  slottingRules          SlottingRule[]
  slottingRecommendations SlottingRecommendation[]
  loadPlans              LoadPlan[]
  deliveryRoutes         DeliveryRoute[]
  clients                Client[]
  rateCards              BillingRateCard[]
  billingTransactions    BillingTransaction[]
  clientInvoices         ClientInvoice[]
  yardLocations          YardLocation[]
  dockAppointments       DockAppointment[]
  iotDevices             IoTDevice[]
  iotAlerts              IoTAlert[]
  securityPersonnel      SecurityPersonnel[]
  securityShifts         SecurityShift[]
  gateEntries            GateEntry[]
  visitors               Visitor[]
  securityIncidents      SecurityIncident[]
  securityAccessLogs     SecurityAccessLog[]
  cameraSystems          CameraSystem[]
  accessControlZones     AccessControlZone[]
  securityNotifications  SecurityNotification[]
  visitorPreRegistrations VisitorPreRegistration[]
  securityAlerts         SecurityAlert[]
  complianceReports      SecurityComplianceReport[]
  vehicleBlacklist       VehicleBlacklist[]
  vehicleWhitelist       VehicleWhitelist[]
  gates                  Gate[]
  gateQueue              GateQueue[]
  parkingSpots           ParkingSpot[]
  gateWeighBridges       GateWeighBridge[]
  gatePhotos             GatePhoto[]
  gateDocuments          GateDocument[]
  temperatureLogs        TemperatureLog[]
  hazmatRecords          HazmatRecord[]
  
  // New Guard Management Relations
  patrolRoutes           PatrolRoute[]
  guardLocations         GuardLocation[]
  geofences              Geofence[]
  panicAlerts            PanicAlert[]
  dailyActivityReports   DailyActivityReport[]
  equipment              Equipment[]
  shiftHandovers         ShiftHandover[]
  guardCertifications    GuardCertification[]
  trainingCourses        TrainingCourse[]
  weatherLogs            WeatherLog[]
  
  // Advanced Returns Management Relations
  refurbTemplates        RefurbTemplate[]
  rtvRequests            RTVRequest[]
  
  // QC Module Relations
  qcReceivingInspections QCReceivingInspection[]
  qcDefects              QCDefect[]
  rtvs                   RTV[]
  vendorQualityScores    VendorQualityScore[]
  qcInspectionTemplates  QCInspectionTemplate[]
  qcSettings             QCSettings?
  vendorReturnPolicies   VendorReturnPolicy[]
  returnSettings         ReturnSettings?
  returnsForecasts       ReturnsForecast[]
  
  // Cross-Docking Relations
  crossDockAppointments  CrossDockingAppointment[]
  crossDockReceipts      CrossDockReceipt[]
  crossDockReceiptItems  CrossDockReceiptItem[]
  crossDockShipments     CrossDockShipment[]
  crossDockAllocations   CrossDockAllocation[]
  crossDockSorting       CrossDockSorting[]
  crossDockActivities    CrossDockActivity[]
  crossDockSettings      CrossDockSettings?

  @@index([slug])
  @@index([createdById])
  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  permissions    Json? // Custom permissions
  isActive       Boolean          @default(true)
  joinedAt       DateTime         @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  GUEST
}

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// ==========================================
// INVENTORY MANAGEMENT
// ==========================================

model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String // Unique code per organization
  address        String?
  city           String?
  country        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  
  // QC Module Relations
  qcReceivingInspections QCReceivingInspection[]
  rtvs                   RTV[]
  
  // Cross-Docking Relations
  crossDockAppointments  CrossDockingAppointment[]
  
  inventoryItems InventoryItem[]
  grns           GoodsReceiptNote[]
  salesOrders    SalesOrder[]
  pickLists      PickList[]
  packs          Pack[]
  assemblyOrders AssemblyOrder[]

  // Phase 9 Day 20-21: Wave & Task Management Relations
  waves         WavePick[]
  pickingTasks  PickingTask[]
  pickingRoutes PickingRoute[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("warehouses")
}

model Category {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  parentId       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[]      @relation("CategoryHierarchy")
  inventoryItems InventoryItem[]
  cycleCounts    CycleCount[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([parentId])
  @@map("categories")
}

model InventoryItem {
  id             String  @id @default(cuid())
  organizationId String
  warehouseId    String
  categoryId     String?
  supplierId     String?

  // Product details
  sku         String
  name        String
  description String? @db.Text
  barcode     String?

  // Inventory tracking
  quantity        Int       @default(0)
  reservedQty     Int       @default(0) // Quantity reserved in bookings
  availableQty    Int       @default(0) // quantity - reservedQty
  minStockLevel   Int       @default(0)
  maxStockLevel   Int?
  reorderPoint    Int?
  reorderQuantity Int?      @default(0) // How many to reorder when threshold hit
  leadTimeDays    Int?      @default(7) // Supplier lead time in days
  lastReorderDate DateTime? // Track when last reorder was triggered
  autoReorder     Boolean   @default(false) // Enable auto-reorder alerts

  // Pricing
  costPrice    Decimal? @db.Decimal(10, 2)
  sellingPrice Decimal? @db.Decimal(10, 2)
  currency     String   @default("USD")

  // Status
  status   InventoryStatus @default(ACTIVE)
  isActive Boolean         @default(true)

  // Metadata
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  // Relations
  organization            Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse               Warehouse                @relation(fields: [warehouseId], references: [id])
  category                Category?                @relation(fields: [categoryId], references: [id])
  supplier                Supplier?                @relation(fields: [supplierId], references: [id])
  createdBy               User                     @relation("InventoryCreator", fields: [createdById], references: [id])
  bookingItems            BookingItem[]
  movements               InventoryMovement[]
  reorderAlerts           ReorderAlert[]
  purchaseOrderItems      PurchaseOrderItem[]      @relation("POInventoryItem")
  grnItems                GRNItem[]
  salesOrderItems         SalesOrderItem[]
  pickListItems           PickListItem[]
  packageItems            PackageItem[]
  warehouseTransfers      WarehouseTransfer[]
  stockAdjustments        StockAdjustment[]
  cycleCountItems         CycleCountItem[]
  rmaItems                RMAItem[]                @relation("RMAInventoryItem")
  rmaExchangeItems        RMAItem[]                @relation("RMAExchangeItem")
  lots                    Lot[]
  serialNumbers           SerialNumber[]
  qcInspections           QCInspection[]
  bomsAsProduct           BillOfMaterials[]        @relation("BOMProduct")
  bomComponents           BOMComponent[]           @relation("BOMComponent")
  assemblyOrdersAsProduct AssemblyOrder[]          @relation("AssemblyProduct")
  assemblyComponents      AssemblyComponentIssue[] @relation("AssemblyComponent")
  WavePickLine            WavePickLine[]
  PickingTask             PickingTask[]
  slottingRecommendations SlottingRecommendation[]
  
  // QC Module Relations
  qcInspectionItems       QCInspectionItem[]
  
  // Cross-Docking Relations
  crossDockReceiptItems   CrossDockReceiptItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([sku])
  @@map("inventory_items")
}

enum InventoryStatus {
  ACTIVE
  LOW_STOCK
  OUT_OF_STOCK
  DISCONTINUED
  DAMAGED
}

model InventoryMovement {
  id              String       @id @default(cuid())
  inventoryItemId String
  type            MovementType
  quantity        Int
  fromWarehouse   String?
  toWarehouse     String?
  reason          String?
  notes           String?      @db.Text
  createdAt       DateTime     @default(now())

  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([createdAt])
  @@map("inventory_movements")
}

enum MovementType {
  PURCHASE
  SALE
  TRANSFER
  ADJUSTMENT
  RETURN
  DAMAGE
  BOOKING
  RELEASE
}

// ==========================================
// REORDER ALERTS
// ==========================================

model ReorderAlert {
  id              String @id @default(cuid())
  organizationId  String
  inventoryItemId String

  // Alert details
  alertType AlertType     @default(LOW_STOCK)
  severity  AlertSeverity @default(MEDIUM)
  status    AlertStatus   @default(PENDING)

  // Stock information at time of alert
  currentStock          Int
  reorderPoint          Int
  reorderQuantity       Int
  estimatedStockoutDate DateTime?

  // Notification tracking
  emailSent Boolean @default(false)
  smsSent   Boolean @default(false)
  slackSent Boolean @default(false)
  pushSent  Boolean @default(false)

  sentAt         DateTime?
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  dismissedAt    DateTime?

  notes     String?  @db.Text
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([inventoryItemId])
  @@index([status])
  @@index([createdAt])
  @@map("reorder_alerts")
}

enum AlertType {
  LOW_STOCK // Below reorder point
  OUT_OF_STOCK // Zero stock
  CRITICAL_STOCK // Stockout imminent (within lead time)
  OVERSTOCK // Above max stock level
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
  AUTO_RESOLVED
}

// ==========================================
// BOOKING MANAGEMENT
// ==========================================

model Booking {
  id             String  @id @default(cuid())
  organizationId String
  customerId     String?
  bookingNumber  String  @unique

  // Booking details
  status     BookingStatus @default(PENDING)
  priority   Priority      @default(MEDIUM)
  totalItems Int           @default(0)
  totalValue Decimal?      @db.Decimal(10, 2)

  // Dates
  bookedAt    DateTime  @default(now())
  requiredBy  DateTime?
  confirmedAt DateTime?
  fulfilledAt DateTime?
  cancelledAt DateTime?

  // Notes
  notes         String? @db.Text
  internalNotes String? @db.Text

  // Metadata
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id])
  createdBy    User          @relation("BookingCreator", fields: [createdById], references: [id])
  items        BookingItem[]

  @@index([organizationId])
  @@index([customerId])
  @@index([bookingNumber])
  @@index([status])
  @@index([createdAt])
  @@map("bookings")
}

model BookingItem {
  id              String @id @default(cuid())
  bookingId       String
  inventoryItemId String

  quantityBooked    Int
  quantityFulfilled Int      @default(0)
  unitPrice         Decimal? @db.Decimal(10, 2)
  totalPrice        Decimal? @db.Decimal(10, 2)

  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([bookingId])
  @@index([inventoryItemId])
  @@map("booking_items")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PROCESSING
  FULFILLED
  PARTIALLY_FULFILLED
  CANCELLED
  ON_HOLD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==========================================
// SUPPLIERS & CUSTOMERS
// ==========================================

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  
  // QC Module Relations
  qcReceivingInspections QCReceivingInspection[] @relation("SupplierInspections")
  rtvs                   RTV[]                   @relation("SupplierRTVs")
  qualityScore           VendorQualityScore?
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  website        String?
  notes          String?  @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  purchaseOrders PurchaseOrder[]
  lots           Lot[]
  
  // Cross-Docking Relations
  crossDockReceipts CrossDockReceipt[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("suppliers")
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  notes          String?  @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings      Booking[]
  salesOrders   SalesOrder[]
  rmas          RMA[]
  serialNumbers SerialNumber[]
  fraudAnalyses FraudAnalysis[]
  
  // Cross-Docking Relations
  crossDockShipments CrossDockShipment[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("customers")
}

// ==========================================
// PURCHASE ORDERS (Inbound Operations)
// ==========================================

model PurchaseOrder {
  id             String @id @default(cuid())
  organizationId String
  supplierId     String
  poNumber       String @unique

  // Status & workflow
  status   POStatus @default(DRAFT)
  priority Priority @default(MEDIUM)

  // Dates
  orderDate     DateTime  @default(now())
  expectedDate  DateTime?
  approvedDate  DateTime?
  receivedDate  DateTime?
  cancelledDate DateTime?

  // Financial
  subtotal    Decimal? @db.Decimal(10, 2)
  tax         Decimal? @db.Decimal(10, 2)
  shipping    Decimal? @db.Decimal(10, 2)
  totalAmount Decimal? @db.Decimal(10, 2)
  currency    String   @default("USD")

  // Delivery information
  deliveryAddress String?
  deliveryCity    String?
  deliveryCountry String?
  deliveryNotes   String? @db.Text

  // Internal tracking
  notes         String? @db.Text
  internalNotes String? @db.Text
  approvedById  String?

  // Metadata
  metadata    Json?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  // Relations
  organization Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier     Supplier            @relation(fields: [supplierId], references: [id])
  createdBy    User                @relation("POCreator", fields: [createdById], references: [id])
  approvedBy   User?               @relation("POApprover", fields: [approvedById], references: [id])
  items        PurchaseOrderItem[]
  receipts     GoodsReceiptNote[]
  lots         Lot[]
  
  // QC Module Relations
  qcInspections QCReceivingInspection[]
  rtvs          RTV[]

  @@index([organizationId])
  @@index([supplierId])
  @@index([poNumber])
  @@index([status])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String  @id @default(cuid())
  purchaseOrderId String
  inventoryItemId String?

  // Product details
  sku         String
  description String

  // Quantity & pricing
  quantityOrdered  Int
  quantityReceived Int      @default(0)
  unitPrice        Decimal  @db.Decimal(10, 2)
  tax              Decimal? @db.Decimal(10, 2)
  totalPrice       Decimal  @db.Decimal(10, 2)

  // Metadata
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem? @relation("POInventoryItem", fields: [inventoryItemId], references: [id])
  grnItems      GRNItem[]

  @@index([purchaseOrderId])
  @@index([inventoryItemId])
  @@map("purchase_order_items")
}

enum POStatus {
  DRAFT // Being created
  PENDING // Awaiting approval
  APPROVED // Approved, ready to send
  SENT // Sent to supplier
  CONFIRMED // Confirmed by supplier
  PARTIALLY_RECEIVED // Some items received
  RECEIVED // All items received
  CANCELLED // Cancelled
  CLOSED // Completed and closed
}

// ==========================================
// GOODS RECEIPT NOTE (GRN) - Receiving System
// ==========================================

enum GRNStatus {
  DRAFT // Being created
  PENDING // Submitted for QC
  QUALITY_CHECK // Under quality inspection
  APPROVED // QC passed
  REJECTED // QC failed
  COMPLETED // Finalized & inventory updated
}

model GoodsReceiptNote {
  id              String    @id @default(cuid())
  organizationId  String
  purchaseOrderId String
  warehouseId     String?
  grnNumber       String    @unique
  status          GRNStatus @default(DRAFT)
  receivedDate    DateTime  @default(now())
  receivedById    String

  // Quality Control
  qcStatus String? // PASS, FAIL, PENDING
  qcNotes  String?   @db.Text
  qcById   String?
  qcDate   DateTime?

  // Discrepancies
  hasDiscrepancy   Boolean @default(false)
  discrepancyNotes String? @db.Text

  // Financial
  totalReceived Decimal @default(0) @db.Decimal(10, 2)
  currency      String  @default("GBP")

  // Location & Put-away
  receivingDock    String?
  putAwayCompleted Boolean   @default(false)
  putAwayDate      DateTime?

  // Metadata
  notes         String?  @db.Text
  internalNotes String?  @db.Text
  attachments   Json? // Array of file URLs
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // Relations
  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder PurchaseOrder  @relation(fields: [purchaseOrderId], references: [id])
  warehouse     Warehouse?     @relation(fields: [warehouseId], references: [id])
  receivedBy    User           @relation("GRNReceivedBy", fields: [receivedById], references: [id])
  qcBy          User?          @relation("GRNQCBy", fields: [qcById], references: [id])
  items         GRNItem[]
  lots          Lot[]
  serialNumbers SerialNumber[]
  qcInspections QCInspection[]
  
  // QC Receiving Module Relations
  qcReceivingInspections QCReceivingInspection[]

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([warehouseId])
  @@index([status])
  @@index([receivedDate])
  @@map("goods_receipt_notes")
}

model GRNItem {
  id                  String  @id @default(cuid())
  grnId               String
  purchaseOrderItemId String?
  inventoryItemId     String

  // Quantities
  orderedQuantity  Int // From PO
  receivedQuantity Int // Actually received
  acceptedQuantity Int // After QC
  rejectedQuantity Int @default(0)

  // Quality
  qcStatus          String? // PASS, FAIL, PENDING
  qcNotes           String? @db.Text
  hasDefects        Boolean @default(false)
  defectDescription String? @db.Text

  // Location
  binLocation      String?
  putAwayCompleted Boolean @default(false)

  // Batch/Serial Tracking
  batchNumber   String?
  serialNumbers Json? // Array of serial numbers
  expiryDate    DateTime?

  // Financial
  unitCost Decimal @db.Decimal(10, 2)

  // Metadata
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  grn               GoodsReceiptNote   @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderItem PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  inventoryItem     InventoryItem      @relation(fields: [inventoryItemId], references: [id])

  @@index([grnId])
  @@index([inventoryItemId])
  @@index([purchaseOrderItemId])
  @@map("grn_items")
}

// ==========================================
// SALES ORDERS & OUTBOUND OPERATIONS
// ==========================================

enum SalesOrderStatus {
  DRAFT // Initial creation
  PENDING_APPROVAL // Awaiting approval
  APPROVED // Approved, ready to pick
  PICKING // Items being picked
  PICKED // All items picked
  PACKING // Items being packed
  PACKED // Ready to ship
  SHIPPED // Shipped to customer
  DELIVERED // Delivered successfully
  CANCELLED // Order cancelled
  ON_HOLD // Temporarily paused
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
  OVERDUE
}

enum ShippingMethod {
  STANDARD
  EXPRESS
  OVERNIGHT
  PICKUP
  FREIGHT
}

model SalesOrder {
  id             String @id @default(cuid())
  organizationId String
  soNumber       String // Auto-generated (SO-YYYYMMDD-XXX)

  // Customer Information
  customerId String

  // Order Details
  status        SalesOrderStatus @default(DRAFT)
  orderDate     DateTime         @default(now())
  requestedDate DateTime? // Customer requested delivery date
  promisedDate  DateTime? // Promised delivery date

  // Warehouse & Fulfillment
  warehouseId String?

  // Shipping Information
  shippingMethod  ShippingMethod?
  shippingAddress String?         @db.Text
  shippingCity    String?
  shippingState   String?
  shippingZip     String?
  shippingCountry String?
  trackingNumber  String?
  carrierName     String?
  shippedDate     DateTime?
  deliveredDate   DateTime?

  // Financial
  subtotal     Decimal @db.Decimal(10, 2)
  taxAmount    Decimal @default(0) @db.Decimal(10, 2)
  shippingCost Decimal @default(0) @db.Decimal(10, 2)
  discount     Decimal @default(0) @db.Decimal(10, 2)
  total        Decimal @db.Decimal(10, 2)
  currency     String  @default("USD")

  // Payment
  paymentStatus PaymentStatus @default(UNPAID)
  paymentMethod String?
  paidAmount    Decimal       @default(0) @db.Decimal(10, 2)

  // Workflow
  priority     Int       @default(0) // Higher = more urgent
  approvedById String?
  approvedDate DateTime?
  pickedById   String?
  pickedDate   DateTime?
  packedById   String?
  packedDate   DateTime?

  // Metadata
  notes         String?  @db.Text
  internalNotes String?  @db.Text
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  createdById   String

  // Relations
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer       Customer         @relation(fields: [customerId], references: [id])
  warehouse      Warehouse?       @relation(fields: [warehouseId], references: [id])
  createdBy      User             @relation("SOCreator", fields: [createdById], references: [id])
  approvedBy     User?            @relation("SOApprover", fields: [approvedById], references: [id])
  pickedBy       User?            @relation("SOPicker", fields: [pickedById], references: [id])
  packedBy       User?            @relation("SOPacker", fields: [packedById], references: [id])
  items          SalesOrderItem[]
  pickLists      PickList[]
  shipments      Shipment[]
  packs          Pack[]
  rmas           RMA[]
  serialNumbers  SerialNumber[]
  qcInspections  QCInspection[]
  assemblyOrders AssemblyOrder[]
  WavePickLine   WavePickLine[]
  loadPlanItems  LoadPlanItem[]
  
  // Cross-Docking Relations
  crossDockShipments CrossDockShipment[]

  @@unique([organizationId, soNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([warehouseId])
  @@index([status])
  @@index([orderDate])
  @@map("sales_orders")
}

model SalesOrderItem {
  id              String @id @default(cuid())
  salesOrderId    String
  inventoryItemId String

  // Quantities
  quantity        Int
  quantityPicked  Int @default(0)
  quantityPacked  Int @default(0)
  quantityShipped Int @default(0)

  // Pricing
  unitPrice Decimal @db.Decimal(10, 2)
  discount  Decimal @default(0) @db.Decimal(10, 2)
  taxRate   Decimal @default(0) @db.Decimal(5, 2)
  lineTotal Decimal @db.Decimal(10, 2)

  // Fulfillment
  binLocation   String?
  batchNumber   String?
  serialNumbers Json? // Array of serial numbers

  // Metadata
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  salesOrder    SalesOrder     @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem  @relation(fields: [inventoryItemId], references: [id])
  pickListItems PickListItem[]
  packageItems  PackageItem[]
  rmaItems      RMAItem[]

  @@index([salesOrderId])
  @@index([inventoryItemId])
  @@map("sales_order_items")
}

enum PickListStatus {
  PENDING
  IN_PROGRESS
  PICKED
  CANCELLED
}

model PickList {
  id             String @id @default(cuid())
  organizationId String
  pickListNumber String // Auto-generated (PICK-YYYYMMDD-XXX)
  salesOrderId   String
  warehouseId    String

  status   PickListStatus @default(PENDING)
  priority Int            @default(0)

  // Assignment
  assignedToId  String?
  assignedDate  DateTime?
  startedDate   DateTime?
  completedDate DateTime?

  // Metadata
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  // Relations
  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder   SalesOrder     @relation(fields: [salesOrderId], references: [id])
  warehouse    Warehouse      @relation(fields: [warehouseId], references: [id])
  assignedTo   User?          @relation("PickListAssignee", fields: [assignedToId], references: [id])
  createdBy    User           @relation("PickListCreator", fields: [createdById], references: [id])
  items        PickListItem[]
  packs        Pack[]
  WavePickLine WavePickLine[]

  @@unique([organizationId, pickListNumber])
  @@index([organizationId])
  @@index([salesOrderId])
  @@index([warehouseId])
  @@index([status])
  @@map("pick_lists")
}

model PickListItem {
  id               String @id @default(cuid())
  pickListId       String
  salesOrderItemId String
  inventoryItemId  String

  quantityToPick Int
  quantityPicked Int     @default(0)
  binLocation    String?
  batchNumber    String?
  serialNumbers  Json?

  pickedAt DateTime?

  // Relations
  pickList       PickList       @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  inventoryItem  InventoryItem  @relation(fields: [inventoryItemId], references: [id])

  @@index([pickListId])
  @@index([salesOrderItemId])
  @@index([inventoryItemId])
  @@map("pick_list_items")
}

enum PackingStatus {
  PENDING
  IN_PROGRESS
  PACKED
  CANCELLED
}

model Pack {
  id             String  @id @default(cuid())
  organizationId String
  packNumber     String // Auto-generated (PACK-YYYYMMDD-XXX)
  salesOrderId   String
  pickListId     String?
  warehouseId    String

  status PackingStatus @default(PENDING)

  // Assignment
  packedById    String?
  startedDate   DateTime?
  completedDate DateTime?

  // Package details
  totalPackages Int      @default(0)
  totalWeight   Decimal? @db.Decimal(10, 2)
  weightUnit    String?  @default("kg")

  // Metadata
  notes       String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder   SalesOrder   @relation(fields: [salesOrderId], references: [id])
  pickList     PickList?    @relation(fields: [pickListId], references: [id])
  warehouse    Warehouse    @relation(fields: [warehouseId], references: [id])
  packedBy     User?        @relation("PackCreator", fields: [packedById], references: [id])
  createdBy    User         @relation("PackInitiator", fields: [createdById], references: [id])
  packages     Package[]
  shipments    Shipment[]

  @@unique([organizationId, packNumber])
  @@index([organizationId])
  @@index([salesOrderId])
  @@index([pickListId])
  @@index([warehouseId])
  @@index([status])
  @@map("packs")
}

model Package {
  id            String @id @default(cuid())
  packId        String
  packageNumber String // Sequential within pack (1, 2, 3...)

  // Package details
  packageType String? // Box, Pallet, Envelope, etc.
  weight      Decimal? @db.Decimal(10, 2)
  weightUnit  String?  @default("kg")
  dimensions  Json? // {length, width, height, unit}

  // Tracking
  trackingNumber String?
  labelUrl       String?

  // Contents
  items PackageItem[]

  // Metadata
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  pack Pack @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId])
  @@index([trackingNumber])
  @@map("packages")
}

model PackageItem {
  id               String @id @default(cuid())
  packageId        String
  salesOrderItemId String
  inventoryItemId  String

  quantity      Int
  binLocation   String?
  batchNumber   String?
  serialNumbers Json?

  // Relations
  package        Package        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  salesOrderItem SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  inventoryItem  InventoryItem  @relation(fields: [inventoryItemId], references: [id])

  @@index([packageId])
  @@index([salesOrderItemId])
  @@index([inventoryItemId])
  @@map("package_items")
}

enum ShipmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  EXCEPTION
  FAILED
  CANCELLED
  RETURNED
}

model Shipment {
  id             String  @id @default(cuid())
  organizationId String
  shipmentNumber String // Auto-generated (SHIP-YYYYMMDD-XXX)
  salesOrderId   String
  packId         String?

  status ShipmentStatus @default(PENDING)

  // Carrier Information
  carrierCode    String? // UPS, FEDEX, DHL, USPS
  carrierName    String?
  carrierService String? // Ground, Express, Overnight, etc.
  trackingNumber String?
  trackingUrl    String?
  labelUrl       String?
  labelFormat    String? // PDF, PNG, ZPL

  // Shipping Address
  recipientName  String?
  recipientPhone String?
  recipientEmail String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?

  // Shipping Details
  weight     Decimal? @db.Decimal(10, 2)
  weightUnit String?  @default("kg")
  dimensions Json? // {length, width, height, unit}

  // Dates
  shippedDate       DateTime?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?

  // Cost & Rating
  shippingCost    Decimal? @db.Decimal(10, 2)
  insuranceAmount Decimal? @db.Decimal(10, 2)
  currency        String   @default("USD")

  // Signature & Delivery Options
  signatureRequired Boolean @default(false)
  saturdayDelivery  Boolean @default(false)

  // Tracking Events
  trackingEvents     Json? // Array of tracking updates
  lastTrackingUpdate DateTime?

  // Exception Handling
  exceptionReason String?
  exceptionDate   DateTime?

  // Metadata
  notes       String?  @db.Text
  metadata    Json? // Carrier-specific data
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder   SalesOrder   @relation(fields: [salesOrderId], references: [id])
  pack         Pack?        @relation(fields: [packId], references: [id])
  createdBy    User         @relation("ShipmentCreator", fields: [createdById], references: [id])
  loadPlanItems LoadPlanItem[]

  @@unique([organizationId, shipmentNumber])
  @@index([organizationId])
  @@index([salesOrderId])
  @@index([packId])
  @@index([status])
  @@index([trackingNumber])
  @@index([carrierCode])
  @@map("shipments")
}

enum CarrierType {
  UPS
  FEDEX
  DHL
  USPS
  CUSTOM
}

model CarrierConfig {
  id             String @id @default(cuid())
  organizationId String

  carrierType CarrierType
  carrierName String
  isActive    Boolean     @default(true)

  // API Credentials (encrypted)
  apiKey        String?
  apiSecret     String?
  accountNumber String?

  // Configuration
  config Json? // Carrier-specific settings

  // Default settings
  defaultService String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, carrierType])
  @@index([organizationId])
  @@map("carrier_configs")
}

// ==========================================
// INTEGRATIONS & API
// ==========================================

model Integration {
  id             String          @id @default(cuid())
  organizationId String
  type           IntegrationType
  name           String
  config         Json // Integration-specific configuration
  isActive       Boolean         @default(true)
  lastSyncAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([type])
  @@map("integrations")
}

enum IntegrationType {
  ERP
  ECOMMERCE
  ACCOUNTING
  CRM
  WAREHOUSE
  SHIPPING
  ANALYTICS
  CUSTOM
}

// ==========================================
// WAREHOUSE OPERATIONS
// ==========================================

enum LocationType {
  WAREHOUSE
  ZONE
  AISLE
  RACK
  SHELF
  BIN
  STAGING
  SHIPPING
  RECEIVING
  QUARANTINE
}

enum TransferStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

enum AdjustmentReason {
  DAMAGE
  LOSS
  FOUND
  CORRECTION
  RECOUNT
  RETURN_TO_VENDOR
  SAMPLE
  THEFT
  EXPIRY
  OTHER
}

enum AdjustmentStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
}

model Location {
  id             String       @id @default(cuid())
  organizationId String
  locationCode   String // e.g., "WH1-A-01-R2-S3-B4"
  name           String
  type           LocationType
  parentId       String?

  // Hierarchy fields
  warehouseId String?
  zoneId      String?
  aisleId     String?
  rackId      String?
  shelfId     String?

  // Physical attributes
  barcode   String? @unique
  qrCode    String?
  capacity  Float? // Max units
  maxWeight Float? // kg

  // Dimensions (cm)
  length Float?
  width  Float?
  height Float?

  // Status
  isActive    Boolean @default(true)
  isPickable  Boolean @default(true)
  isPutaway   Boolean @default(true)
  temperature Float? // For cold storage

  // Metadata
  notes    String?
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent       Location?    @relation("LocationHierarchy", fields: [parentId], references: [id])
  children     Location[]   @relation("LocationHierarchy")

  transfersFrom   WarehouseTransfer[]      @relation("TransferFromLocation")
  transfersTo     WarehouseTransfer[]      @relation("TransferToLocation")
  adjustments     StockAdjustment[]
  cycleCounts     CycleCount[]
  cycleCountItems CycleCountItem[]
  rmaRestockItems RMAItem[]
  lots            Lot[]
  serialNumbers   SerialNumber[]
  componentIssues AssemblyComponentIssue[]

  // Phase 9 Day 20-21: Wave & Task Management Relations
  wavePickLines WavePickLine[]
  tasksFrom     PickingTask[]  @relation("TaskFromLocation")
  tasksTo       PickingTask[]  @relation("TaskToLocation")
  routeStarts   PickingRoute[] @relation("RouteStart")
  routeEnds     PickingRoute[] @relation("RouteEnd")
  
  // Cross-Docking Relations
  crossDockSorting      CrossDockingAppointment[] @relation("CrossDockSorting")
  sortingTasks          CrossDockSorting[]        @relation("SortingTaskArea")
  crossDockReceiptItems CrossDockReceiptItem[]    @relation("CrossDockItemLocation")

  @@unique([organizationId, locationCode])
  @@index([organizationId])
  @@index([locationCode])
  @@index([barcode])
  @@index([type])
  @@index([parentId])
  @@index([warehouseId])
  @@map("locations")
}

model WarehouseTransfer {
  id             String         @id @default(cuid())
  organizationId String
  transferNumber String         @unique
  status         TransferStatus @default(PENDING)

  // Source and destination
  fromLocationId String
  toLocationId   String

  // Item details
  inventoryId String
  quantity    Int

  // Transfer details
  reason   String?
  notes    String?
  priority String? // HIGH, MEDIUM, LOW

  // User tracking
  requestedById String
  approvedById  String?
  completedById String?

  // Dates
  requestedDate DateTime  @default(now())
  scheduledDate DateTime?
  approvedDate  DateTime?
  startedDate   DateTime?
  completedDate DateTime?

  // Metadata
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  fromLocation  Location      @relation("TransferFromLocation", fields: [fromLocationId], references: [id])
  toLocation    Location      @relation("TransferToLocation", fields: [toLocationId], references: [id])
  inventoryItem InventoryItem @relation(fields: [inventoryId], references: [id])
  requestedBy   User          @relation("TransferRequestedBy", fields: [requestedById], references: [id])
  approvedBy    User?         @relation("TransferApprovedBy", fields: [approvedById], references: [id])
  completedBy   User?         @relation("TransferCompletedBy", fields: [completedById], references: [id])

  @@index([organizationId])
  @@index([transferNumber])
  @@index([status])
  @@index([fromLocationId])
  @@index([toLocationId])
  @@index([inventoryId])
  @@map("warehouse_transfers")
}

model StockAdjustment {
  id               String           @id @default(cuid())
  organizationId   String
  adjustmentNumber String           @unique
  status           AdjustmentStatus @default(PENDING)

  // Item details
  inventoryId String
  locationId  String?

  // Adjustment details
  quantityBefore Int
  quantityAfter  Int
  quantityChange Int // Can be negative
  reason         AdjustmentReason
  reasonNotes    String?

  // Approval workflow
  requiresApproval Boolean @default(true)
  approvedById     String?
  rejectionReason  String?

  // User tracking
  createdById   String
  completedById String?

  // Dates
  adjustmentDate DateTime  @default(now())
  approvedDate   DateTime?
  completedDate  DateTime?

  // Financial impact
  unitCost  Float?
  totalCost Float?

  // Metadata
  attachments Json? // URLs to photos/documents
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem    @relation(fields: [inventoryId], references: [id])
  location        Location?        @relation(fields: [locationId], references: [id])
  createdBy       User             @relation("AdjustmentCreatedBy", fields: [createdById], references: [id])
  approvedBy      User?            @relation("AdjustmentApprovedBy", fields: [approvedById], references: [id])
  completedBy     User?            @relation("AdjustmentCompletedBy", fields: [completedById], references: [id])
  cycleCountItems CycleCountItem[]

  @@index([organizationId])
  @@index([adjustmentNumber])
  @@index([status])
  @@index([inventoryId])
  @@index([locationId])
  @@index([reason])
  @@map("stock_adjustments")
}

model ApiKey {
  id             String    @id @default(cuid())
  organizationId String
  name           String
  key            String    @unique
  permissions    Json?
  isActive       Boolean   @default(true)
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([key])
  @@map("api_keys")
}

// ==========================================
// AUDIT & ACTIVITY LOGGING
// ==========================================

model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}

// ==========================================
// CYCLE COUNTS & STOCK TAKE
// ==========================================

enum CycleCountType {
  SCHEDULED // Regular scheduled cycle count
  ADHOC // Unscheduled count triggered manually
  FULL // Complete physical inventory count
  SPOT // Random spot check
}

enum CycleCountStatus {
  PLANNED // Count scheduled but not started
  IN_PROGRESS // Counting in progress
  COMPLETED // Counting finished
  APPROVED // Count verified and approved
  REJECTED // Count rejected, needs recount
  CANCELLED // Count cancelled
}

model CycleCount {
  id             String           @id @default(cuid())
  organizationId String
  countNumber    String           @unique // CC-YYYYMMDD-XXX
  type           CycleCountType
  status         CycleCountStatus @default(PLANNED)

  // Scheduling
  scheduledDate DateTime
  startedDate   DateTime?
  completedDate DateTime?
  approvedDate  DateTime?

  // Scope - what to count
  locationId     String? // Specific location (null = all locations)
  categoryId     String? // Specific category (null = all categories)
  includeZeroQty Boolean @default(false) // Include items with zero quantity

  // Assignments
  assignedToId String? // User assigned to perform count
  approvedById String? // User who approved count

  // Results
  totalItems    Int     @default(0) // Total items to count
  countedItems  Int     @default(0) // Items counted so far
  varianceItems Int     @default(0) // Items with variance
  totalVariance Decimal @default(0) @db.Decimal(15, 2) // Total financial variance

  // Configuration
  requiresApproval Boolean @default(true)
  autoAdjust       Boolean @default(false) // Auto-adjust inventory on completion
  notes            String? @db.Text
  metadata         Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  location     Location?    @relation(fields: [locationId], references: [id])
  category     Category?    @relation(fields: [categoryId], references: [id])
  assignedTo   User?        @relation("AssignedCycleCounts", fields: [assignedToId], references: [id])
  approvedBy   User?        @relation("ApprovedCycleCounts", fields: [approvedById], references: [id])

  items CycleCountItem[]

  @@index([organizationId])
  @@index([countNumber])
  @@index([status])
  @@index([locationId])
  @@index([categoryId])
  @@index([assignedToId])
  @@index([scheduledDate])
  @@map("cycle_counts")
}

model CycleCountItem {
  id           String  @id @default(cuid())
  cycleCountId String
  inventoryId  String
  locationId   String?

  // Expected vs Actual
  expectedQty     Int // System quantity before count
  countedQty      Int? // Physical count quantity
  variance        Int? // Difference (countedQty - expectedQty)
  variancePercent Decimal? @db.Decimal(5, 2) // Variance as percentage

  // Financial Impact
  unitCost      Decimal? @db.Decimal(15, 2)
  varianceValue Decimal? @db.Decimal(15, 2) // Financial impact of variance

  // Count Details
  isCounted   Boolean   @default(false)
  countedById String? // User who counted this item
  countedAt   DateTime?

  // Reconciliation
  isReconciled   Boolean   @default(false)
  reconciledById String?
  reconciledAt   DateTime?
  adjustmentId   String? // Link to stock adjustment if created

  // Notes
  notes    String? @db.Text
  reason   String? // Reason for variance
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  cycleCount    CycleCount       @relation(fields: [cycleCountId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem    @relation(fields: [inventoryId], references: [id])
  location      Location?        @relation(fields: [locationId], references: [id])
  countedBy     User?            @relation("CountedItems", fields: [countedById], references: [id])
  reconciledBy  User?            @relation("ReconciledItems", fields: [reconciledById], references: [id])
  adjustment    StockAdjustment? @relation(fields: [adjustmentId], references: [id])

  @@index([cycleCountId])
  @@index([inventoryId])
  @@index([locationId])
  @@index([isCounted])
  @@index([isReconciled])
  @@map("cycle_count_items")
}

// ==========================================
// RETURNS MANAGEMENT (RMA)
// ==========================================

enum RMAStatus {
  PENDING // Return requested, awaiting approval
  APPROVED // Return authorized
  REJECTED // Return denied
  IN_TRANSIT // Customer shipped the return
  RECEIVED // Return received at warehouse
  INSPECTING // Under inspection/QC
  COMPLETED // Return processed (refunded/exchanged/restocked)
  CANCELLED // Return cancelled
}

enum ReturnAction {
  REFUND // Issue refund to customer
  EXCHANGE // Exchange for same/different item
  STORE_CREDIT // Issue store credit
  REPAIR // Repair and return to customer
  DISPOSE // Dispose of item (damaged beyond repair)
}

enum ReturnCondition {
  NEW // Unopened, like new
  GOOD // Used but good condition
  FAIR // Shows wear, functional
  DAMAGED // Damaged but repairable
  DEFECTIVE // Manufacturing defect
  DESTROYED // Not salvageable
}

model ReturnReason {
  id             String  @id @default(cuid())
  organizationId String
  code           String // e.g., "DEFECTIVE", "WRONG_ITEM", "NOT_AS_DESCRIBED"
  name           String // Display name
  description    String?

  // Workflow automation
  autoApprove   Boolean       @default(false) // Auto-approve returns with this reason
  requiresQC    Boolean       @default(true) // Requires quality inspection
  defaultAction ReturnAction? // Default action for this reason

  // Business rules
  allowedDays Int? // Days after delivery to allow returns (null = unlimited)
  restockable Boolean @default(true) // Can item be restocked

  // Metrics
  isActive  Boolean @default(true)
  sortOrder Int     @default(0)

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rmas         RMA[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([isActive])
  @@map("return_reasons")
}

model RMA {
  id             String    @id @default(cuid())
  organizationId String
  rmaNumber      String    @unique // RMA-YYYYMMDD-XXX
  status         RMAStatus @default(PENDING)

  // Source information
  salesOrderId String? // Original sales order
  customerId   String

  // Return details
  returnReasonId String
  customerNotes  String? @db.Text

  // Dates
  requestedDate DateTime  @default(now())
  approvedDate  DateTime?
  receivedDate  DateTime?
  completedDate DateTime?

  // Approval workflow
  approvedById    String?
  rejectionReason String?

  // Shipping details
  returnTrackingNumber String?
  returnCarrier        String?
  returnShippingCost   Decimal? @db.Decimal(10, 2)

  // Financial
  totalRefundAmount Decimal? @db.Decimal(10, 2)
  restockingFee     Decimal? @db.Decimal(10, 2)

  // Processing
  inspectedById String?
  inspectedDate DateTime?
  qcNotes       String?   @db.Text

  // Configuration
  requiresApproval Boolean @default(true)
  notifyCustomer   Boolean @default(true)

  // Metadata
  attachments Json? // Photos, documents
  metadata    Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder   SalesOrder?  @relation(fields: [salesOrderId], references: [id])
  customer     Customer     @relation(fields: [customerId], references: [id])
  returnReason ReturnReason @relation(fields: [returnReasonId], references: [id])
  approvedBy   User?        @relation("RMAApprovedBy", fields: [approvedById], references: [id])
  inspectedBy  User?        @relation("RMAInspectedBy", fields: [inspectedById], references: [id])

  items          RMAItem[]
  returnLabels   ReturnLabel[]
  fraudAnalyses  FraudAnalysis[]

  @@index([organizationId])
  @@index([rmaNumber])
  @@index([status])
  @@index([salesOrderId])
  @@index([customerId])
  @@index([returnReasonId])
  @@map("rmas")
}

model RMAItem {
  id               String  @id @default(cuid())
  rmaId            String
  inventoryId      String
  salesOrderItemId String? // Link to original order item

  // Quantities
  quantityRequested Int
  quantityReceived  Int?
  quantityAccepted  Int? // Quantity approved for refund/exchange
  quantityRejected  Int? // Quantity not accepted

  // Item details
  condition ReturnCondition?
  action    ReturnAction     @default(REFUND)

  // Financial
  unitPrice     Decimal  @db.Decimal(10, 2)
  refundAmount  Decimal? @db.Decimal(10, 2)
  restockingFee Decimal? @db.Decimal(10, 2)

  // Processing
  isInspected     Boolean @default(false)
  inspectionNotes String? @db.Text

  // Restocking
  isRestocked       Boolean   @default(false)
  restockLocationId String?
  restockedDate     DateTime?
  restockedById     String?

  // Exchange (if action = EXCHANGE)
  exchangeInventoryId String?
  exchangeQuantity    Int?

  // Metadata
  serialNumbers Json? // Array of serial numbers
  batchNumbers  Json? // Array of batch numbers
  photos        Json? // Inspection photos
  metadata      Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  rma             RMA             @relation(fields: [rmaId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem   @relation("RMAInventoryItem", fields: [inventoryId], references: [id])
  salesOrderItem  SalesOrderItem? @relation(fields: [salesOrderItemId], references: [id])
  restockLocation Location?       @relation(fields: [restockLocationId], references: [id])
  restockedBy     User?           @relation("RMARestockedBy", fields: [restockedById], references: [id])
  exchangeItem    InventoryItem?  @relation("RMAExchangeItem", fields: [exchangeInventoryId], references: [id])

  refurbWorkOrders RefurbWorkOrder[]
  resaleCandidates ResaleCandidate[]

  @@index([rmaId])
  @@index([inventoryId])
  @@index([salesOrderItemId])
  @@index([isInspected])
  @@index([isRestocked])
  @@map("rma_items")
}

// ==========================================
// BATCH & SERIAL TRACKING
// ==========================================

model Lot {
  id             String @id @default(cuid())
  organizationId String
  inventoryId    String

  // Lot identification
  lotNumber         String // Unique lot/batch number
  supplierLotNumber String? // Vendor's lot number

  // Dates
  manufacturingDate DateTime?
  expiryDate        DateTime?
  receivedDate      DateTime  @default(now())

  // Quantities
  initialQuantity   Int
  currentQuantity   Int
  reservedQuantity  Int @default(0)
  availableQuantity Int @default(0) // currentQuantity - reservedQuantity

  // Quality & Compliance
  qcStatus          QCStatus  @default(PENDING)
  qcDate            DateTime?
  qcNotes           String?   @db.Text
  certificateNumber String? // Certificate of Analysis number

  // Traceability
  grnId           String? // Link to GRN if received
  purchaseOrderId String?
  supplierId      String?

  // Status
  status           LotStatus @default(AVAILABLE)
  isQuarantined    Boolean   @default(false)
  quarantineReason String?
  quarantineDate   DateTime?

  // Recall management
  isRecalled   Boolean   @default(false)
  recallDate   DateTime?
  recallReason String?   @db.Text
  recallNotes  String?   @db.Text

  // Storage
  locationId        String?
  storageConditions String? // e.g., "Keep refrigerated 2-8°C"

  // Metadata
  customFields Json? // Flexible fields for industry-specific data
  notes        String? @db.Text
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem     @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  grn           GoodsReceiptNote? @relation(fields: [grnId], references: [id])
  purchaseOrder PurchaseOrder?    @relation(fields: [purchaseOrderId], references: [id])
  supplier      Supplier?         @relation(fields: [supplierId], references: [id])
  location      Location?         @relation(fields: [locationId], references: [id])

  serialNumbers           SerialNumber[]
  movements               LotMovement[]
  genealogyParents        LotGenealogy[]           @relation("LotParent")
  genealogyChildren       LotGenealogy[]           @relation("LotChild")
  qcInspections           QCInspection[]
  assemblyComponentIssues AssemblyComponentIssue[]
  WavePickLine            WavePickLine[]

  @@unique([organizationId, lotNumber])
  @@index([organizationId])
  @@index([inventoryId])
  @@index([lotNumber])
  @@index([expiryDate])
  @@index([status])
  @@index([qcStatus])
  @@index([isRecalled])
  @@index([grnId])
  @@map("lots")
}

model SerialNumber {
  id             String  @id @default(cuid())
  organizationId String
  inventoryId    String
  lotId          String? // Optional link to lot

  // Serial identification
  serialNumber String // Unique serial number

  // Status
  status SerialStatus @default(AVAILABLE)

  // Traceability
  grnId            String?
  grnItemId        String?
  salesOrderId     String?
  salesOrderItemId String?
  customerId       String?

  // Dates
  receivedDate DateTime?
  soldDate     DateTime?
  returnedDate DateTime?

  // Location
  locationId String?

  // Warranty & Service
  warrantyStartDate  DateTime?
  warrantyEndDate    DateTime?
  warrantyPeriodDays Int?
  serviceHistory     Json? // Array of service records

  // Metadata
  customFields Json?
  notes        String? @db.Text
  metadata     Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization  Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem     @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  lot           Lot?              @relation(fields: [lotId], references: [id])
  grn           GoodsReceiptNote? @relation(fields: [grnId], references: [id])
  salesOrder    SalesOrder?       @relation(fields: [salesOrderId], references: [id])
  customer      Customer?         @relation(fields: [customerId], references: [id])
  location      Location?         @relation(fields: [locationId], references: [id])

  movements SerialMovement[]

  @@unique([organizationId, serialNumber])
  @@index([organizationId])
  @@index([inventoryId])
  @@index([lotId])
  @@index([serialNumber])
  @@index([status])
  @@index([salesOrderId])
  @@index([customerId])
  @@map("serial_numbers")
}

model LotMovement {
  id             String @id @default(cuid())
  organizationId String
  lotId          String

  // Movement details
  movementType MovementType
  quantity     Int

  // Reference
  referenceType String? // e.g., "GRN", "SALES_ORDER", "ADJUSTMENT"
  referenceId   String?

  // Location
  fromLocationId String?
  toLocationId   String?

  // Metadata
  notes         String? @db.Text
  performedById String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  lot          Lot          @relation(fields: [lotId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([lotId])
  @@index([movementType])
  @@index([createdAt])
  @@map("lot_movements")
}

model SerialMovement {
  id             String @id @default(cuid())
  organizationId String
  serialNumberId String

  // Movement details
  movementType MovementType

  // Reference
  referenceType String? // e.g., "GRN", "SALES_ORDER", "ADJUSTMENT"
  referenceId   String?

  // Location
  fromLocationId String?
  toLocationId   String?

  // Metadata
  notes         String? @db.Text
  performedById String?

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  serialNumber SerialNumber @relation(fields: [serialNumberId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([serialNumberId])
  @@index([movementType])
  @@index([createdAt])
  @@map("serial_movements")
}

model LotGenealogy {
  id             String @id @default(cuid())
  organizationId String
  parentLotId    String // Parent lot (ingredient/component)
  childLotId     String // Child lot (produced/assembled)

  // Relationship details
  quantity Int // Quantity of parent used in child

  // Metadata
  notes String? @db.Text

  createdAt DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parentLot    Lot          @relation("LotParent", fields: [parentLotId], references: [id], onDelete: Cascade)
  childLot     Lot          @relation("LotChild", fields: [childLotId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([parentLotId])
  @@index([childLotId])
  @@map("lot_genealogy")
}

enum QCStatus {
  PENDING
  PASSED
  FAILED
  CONDITIONAL
}

enum LotStatus {
  AVAILABLE
  RESERVED
  QUARANTINED
  EXPIRED
  RECALLED
  DEPLETED
}

enum SerialStatus {
  AVAILABLE
  RESERVED
  SOLD
  IN_SERVICE
  RETURNED
  DEFECTIVE
  SCRAPPED
}

// ==========================================
// QUALITY CONTROL SYSTEM
// ==========================================

model InspectionTemplate {
  id             String @id @default(cuid())
  organizationId String

  // Template details
  name        String
  code        String // Unique code per organization
  description String? @db.Text

  // Applicability
  category     InspectionCategory
  inventoryIds Json? // Array of inventory item IDs (null = applies to all)
  supplierIds  Json? // Array of supplier IDs (null = applies to all)

  // Sampling
  samplingType     SamplingType @default(FULL)
  sampleSize       Int? // For statistical sampling
  samplePercentage Decimal?     @db.Decimal(5, 2) // For percentage sampling

  // Workflow
  requiresApproval Boolean @default(true)
  approvalLevels   Int     @default(1) // Number of approval levels required
  autoQuarantine   Boolean @default(false) // Auto-quarantine on fail

  // Configuration
  checkpoints Json // Array of checkpoint definitions

  // Status
  isActive Boolean @default(true)

  // Metadata
  notes    String? @db.Text
  metadata Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  organization Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inspections  QCInspection[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([category])
  @@index([isActive])
  @@map("inspection_templates")
}

model QCInspection {
  id             String @id @default(cuid())
  organizationId String
  templateId     String

  // Inspection details
  inspectionNumber String // Auto-generated: QC-YYYYMMDD-XXX
  category         InspectionCategory

  // Reference
  referenceType String? // GRN, PRODUCTION, SALES_ORDER
  referenceId   String?
  grnId         String?
  salesOrderId  String?
  lotId         String?

  // Items inspected
  inventoryId String
  quantity    Int // Total quantity inspected
  sampleSize  Int? // Sample size if sampling used

  // Results
  status      InspectionStatus  @default(PENDING)
  result      InspectionResult?
  passedCount Int               @default(0)
  failedCount Int               @default(0)
  defectCount Int               @default(0)

  // Defect tracking
  majorDefects    Int @default(0)
  minorDefects    Int @default(0)
  criticalDefects Int @default(0)

  // Quality metrics
  qualityScore Decimal? @db.Decimal(5, 2) // Percentage score
  aqlLevel     String? // Acceptable Quality Level

  // Inspector
  inspectedById String
  inspectedDate DateTime @default(now())

  // Approval chain
  currentApprovalLevel Int            @default(1)
  approvalStatus       ApprovalStatus @default(PENDING)

  // Actions
  isQuarantined    Boolean @default(false)
  quarantineReason String? @db.Text

  // Documentation
  certificateNumber String? // CoA number if generated
  certificateUrl    String? // Link to CoA document
  photos            Json? // Array of photo URLs
  attachments       Json? // Array of document URLs

  // Metadata
  notes          String? @db.Text
  inspectorNotes String? @db.Text
  metadata       Json?

  completedDate DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  organization  Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  template      InspectionTemplate @relation(fields: [templateId], references: [id])
  inventoryItem InventoryItem      @relation(fields: [inventoryId], references: [id])
  inspectedBy   User               @relation("QCInspector", fields: [inspectedById], references: [id])
  grn           GoodsReceiptNote?  @relation(fields: [grnId], references: [id])
  salesOrder    SalesOrder?        @relation(fields: [salesOrderId], references: [id])
  lot           Lot?               @relation(fields: [lotId], references: [id])

  checkpoints QCCheckpoint[]
  approvals   QCApproval[]

  @@unique([organizationId, inspectionNumber])
  @@index([organizationId])
  @@index([templateId])
  @@index([inventoryId])
  @@index([status])
  @@index([result])
  @@index([grnId])
  @@index([salesOrderId])
  @@index([lotId])
  @@index([inspectedDate])
  @@map("qc_inspections")
}

model QCCheckpoint {
  id           String @id @default(cuid())
  inspectionId String

  // Checkpoint details
  name        String
  description String?        @db.Text
  type        CheckpointType
  sequence    Int // Order of execution

  // Requirements
  isRequired    Boolean @default(true)
  expectedValue String? // For measurements
  tolerance     String? // Acceptable range
  unit          String? // Measurement unit

  // Results
  status      CheckpointStatus  @default(PENDING)
  actualValue String?
  result      CheckpointResult?

  // Defects
  defectType        DefectSeverity?
  defectDescription String?         @db.Text

  // Evidence
  photos Json? // Array of photo URLs

  // Metadata
  notes         String?   @db.Text
  performedById String?
  performedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspection  QCInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  performedBy User?        @relation("CheckpointPerformer", fields: [performedById], references: [id])

  @@index([inspectionId])
  @@index([type])
  @@index([status])
  @@index([result])
  @@map("qc_checkpoints")
}

model QCApproval {
  id           String @id @default(cuid())
  inspectionId String

  // Approval details
  level    Int // Approval level (1, 2, 3, etc.)
  status   ApprovalStatus    @default(PENDING)
  decision ApprovalDecision?

  // Approver
  approverId   String?
  approvedDate DateTime?

  // Feedback
  comments        String? @db.Text
  rejectionReason String? @db.Text

  // Metadata
  notifiedDate DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  inspection QCInspection @relation(fields: [inspectionId], references: [id], onDelete: Cascade)
  approver   User?        @relation("QCApprover", fields: [approverId], references: [id])

  @@index([inspectionId])
  @@index([level])
  @@index([status])
  @@index([approverId])
  @@map("qc_approvals")
}

enum InspectionCategory {
  INCOMING // GRN/Receipt inspection
  IN_PROCESS // Production/Assembly inspection
  FINAL // Pre-shipment inspection
  RANDOM // Random sampling inspection
  COMPLAINT // Customer complaint inspection
}

enum SamplingType {
  FULL // 100% inspection
  STATISTICAL // Statistical sampling (e.g., AQL)
  PERCENTAGE // Percentage-based sampling
  RANDOM // Random selection
}

enum InspectionStatus {
  PENDING // Not started
  IN_PROGRESS // Inspection ongoing
  AWAITING_APPROVAL // Awaiting QC approval
  COMPLETED // Finished
  CANCELLED // Cancelled
}

enum InspectionResult {
  PASS // All checks passed
  PASS_WITH_NOTES // Passed with minor issues
  FAIL // Failed inspection
  CONDITIONAL // Conditional pass (requires action)
}

enum CheckpointType {
  VISUAL // Visual inspection
  MEASUREMENT // Dimensional/quantitative measurement
  FUNCTIONAL // Functional testing
  DOCUMENTATION // Documentation check
  PACKAGING // Packaging inspection
  LABELING // Label verification
}

enum CheckpointStatus {
  PENDING // Not performed
  IN_PROGRESS // Being performed
  COMPLETED // Finished
  SKIPPED // Skipped (optional checkpoints)
}

enum CheckpointResult {
  PASS // Meets requirements
  FAIL // Does not meet requirements
  NA // Not applicable
}

enum DefectSeverity {
  CRITICAL // Critical defect (safety/legal)
  MAJOR // Major defect (functionality)
  MINOR // Minor defect (cosmetic)
}

enum ApprovalStatus {
  PENDING // Awaiting approval
  APPROVED // Approved
  REJECTED // Rejected
  ESCALATED // Escalated to higher level
}

enum ApprovalDecision {
  APPROVE // Approve inspection
  REJECT // Reject inspection
  REQUEST_REWORK // Request rework
  ESCALATE // Escalate to next level
}

// ==========================================
// KITTING & ASSEMBLY MANAGEMENT
// ==========================================

model BillOfMaterials {
  id             String @id @default(cuid())
  organizationId String

  // BOM Identification
  bomNumber   String // Auto-generated (BOM-YYYYMMDD-XXX)
  name        String
  description String? @db.Text
  version     String  @default("1.0")

  // Product Information
  productId       String // The finished product (InventoryItem)
  productQuantity Int    @default(1) // How many units this BOM produces

  // BOM Type & Configuration
  bomType   BOMType @default(ASSEMBLY)
  isActive  Boolean @default(true)
  isDefault Boolean @default(false) // Default BOM for this product

  // Production Details
  estimatedTime Int? // Estimated production time in minutes
  laborCost     Decimal? @db.Decimal(10, 2)
  overheadCost  Decimal? @db.Decimal(10, 2)
  totalCost     Decimal? @db.Decimal(10, 2) // Auto-calculated

  // Yield Management
  standardYield Decimal @default(100.00) @db.Decimal(5, 2) // Expected yield %
  scrapRate     Decimal @default(0.00) @db.Decimal(5, 2) // Expected scrap %

  // Workflow
  status       BOMStatus @default(DRAFT)
  approvedById String?
  approvedDate DateTime?

  // Effective dates
  effectiveFrom DateTime  @default(now())
  effectiveTo   DateTime?

  // Metadata
  notes        String? @db.Text
  attachments  Json? // Array of file URLs
  customFields Json? // Flexible fields for industry-specific data

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  product        InventoryItem   @relation("BOMProduct", fields: [productId], references: [id])
  approvedBy     User?           @relation("BOMApprover", fields: [approvedById], references: [id])
  components     BOMComponent[]
  assemblyOrders AssemblyOrder[]

  @@unique([organizationId, bomNumber])
  @@index([organizationId])
  @@index([productId])
  @@index([status])
  @@index([isActive])
  @@map("bills_of_materials")
}

model BOMComponent {
  id    String @id @default(cuid())
  bomId String

  // Component Information
  componentId String // The component/raw material (InventoryItem)
  quantity    Decimal @db.Decimal(10, 4) // Quantity needed per unit
  unit        String? // Unit of measure

  // Component Details
  isOptional      Boolean @default(false)
  isSubstitutable Boolean @default(false)
  substituteIds   Json? // Array of substitute component IDs

  // Costing
  unitCost  Decimal? @db.Decimal(10, 2)
  totalCost Decimal? @db.Decimal(10, 2) // quantity * unitCost

  // Assembly Instructions
  sequence      Int     @default(1) // Order of assembly
  assemblyNotes String? @db.Text
  position      String? // Physical position in assembly

  // Waste & Scrap
  scrapFactor Decimal @default(0.00) @db.Decimal(5, 2) // Expected waste %

  // Metadata
  reference String? // Reference designator (e.g., "R1", "C5" for electronics)
  notes     String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  bom       BillOfMaterials @relation(fields: [bomId], references: [id], onDelete: Cascade)
  component InventoryItem   @relation("BOMComponent", fields: [componentId], references: [id])

  @@index([bomId])
  @@index([componentId])
  @@index([sequence])
  @@map("bom_components")
}

model AssemblyOrder {
  id             String @id @default(cuid())
  organizationId String

  // Order Identification
  orderNumber String // Auto-generated (ASM-YYYYMMDD-XXX)

  // BOM & Product
  bomId     String
  productId String // Finished product

  // Quantities
  plannedQuantity  Int
  producedQuantity Int @default(0)
  scrapQuantity    Int @default(0)

  // Yield Tracking
  actualYield   Decimal? @db.Decimal(5, 2) // Actual yield %
  yieldVariance Decimal? @db.Decimal(5, 2) // Variance from standard

  // Status & Workflow
  status   AssemblyStatus @default(PENDING)
  priority Int            @default(0) // Higher = more urgent

  // Scheduling
  scheduledStart DateTime?
  scheduledEnd   DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?

  // Location
  warehouseId   String?
  workstationId String? // Specific assembly location

  // Assignment
  assignedToId String?

  // Component Tracking
  componentsReserved Boolean @default(false)
  componentsIssued   Boolean @default(false)
  autoDeduct         Boolean @default(true) // Auto-deduct components on completion

  // Financial
  totalComponentCost Decimal? @db.Decimal(10, 2)
  laborCost          Decimal? @db.Decimal(10, 2)
  overheadCost       Decimal? @db.Decimal(10, 2)
  totalCost          Decimal? @db.Decimal(10, 2)

  // Quality Control
  qcRequired Boolean @default(false)
  qcStatus   String? // PENDING, PASSED, FAILED
  qcNotes    String? @db.Text

  // Reference
  referenceType String? // SALES_ORDER, STOCK_REPLENISHMENT, CUSTOM
  referenceId   String?
  salesOrderId  String?

  // Metadata
  notes         String? @db.Text
  internalNotes String? @db.Text
  attachments   Json? // Array of file URLs

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  // Relations
  organization    Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bom             BillOfMaterials          @relation(fields: [bomId], references: [id])
  product         InventoryItem            @relation("AssemblyProduct", fields: [productId], references: [id])
  warehouse       Warehouse?               @relation(fields: [warehouseId], references: [id])
  assignedTo      User?                    @relation("AssemblyAssignee", fields: [assignedToId], references: [id])
  createdBy       User                     @relation("AssemblyCreator", fields: [createdById], references: [id])
  salesOrder      SalesOrder?              @relation(fields: [salesOrderId], references: [id])
  componentIssues AssemblyComponentIssue[]
  productionLogs  AssemblyProductionLog[]

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([bomId])
  @@index([productId])
  @@index([status])
  @@index([scheduledStart])
  @@map("assembly_orders")
}

model AssemblyComponentIssue {
  id              String  @id @default(cuid())
  assemblyOrderId String
  bomComponentId  String? // Link to BOM component

  // Component Details
  componentId      String // What was issued
  requiredQuantity Decimal @db.Decimal(10, 4)
  issuedQuantity   Decimal @db.Decimal(10, 4)
  consumedQuantity Decimal @default(0) @db.Decimal(10, 4)
  returnedQuantity Decimal @default(0) @db.Decimal(10, 4)
  scrapQuantity    Decimal @default(0) @db.Decimal(10, 4)

  // Lot/Serial Tracking
  lotId         String?
  serialNumbers Json? // Array of serial numbers consumed

  // Status
  status IssueStatus @default(ISSUED)

  // Issued Details
  issuedById String
  issuedDate DateTime @default(now())

  // Return Details
  returnedById String?
  returnedDate DateTime?

  // Location
  fromLocationId String? // Where component was taken from

  // Costing
  unitCost  Decimal? @db.Decimal(10, 2)
  totalCost Decimal? @db.Decimal(10, 2)

  // Metadata
  notes String? @db.Text

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  assemblyOrder AssemblyOrder @relation(fields: [assemblyOrderId], references: [id], onDelete: Cascade)
  component     InventoryItem @relation("AssemblyComponent", fields: [componentId], references: [id])
  lot           Lot?          @relation(fields: [lotId], references: [id])
  issuedBy      User          @relation("ComponentIssuer", fields: [issuedById], references: [id])
  returnedBy    User?         @relation("ComponentReturner", fields: [returnedById], references: [id])
  fromLocation  Location?     @relation(fields: [fromLocationId], references: [id])

  @@index([assemblyOrderId])
  @@index([componentId])
  @@index([lotId])
  @@index([status])
  @@map("assembly_component_issues")
}

model AssemblyProductionLog {
  id              String @id @default(cuid())
  assemblyOrderId String

  // Production Event
  eventType ProductionEventType
  eventDate DateTime            @default(now())

  // Quantity Tracking
  quantityProduced Int?
  quantityScrapped Int?

  // Yield Information
  yieldPercentage Decimal? @db.Decimal(5, 2)

  // Operator
  operatorId String

  // Scrap/Defect Details
  scrapReason       String?
  defectType        String? // MATERIAL, WORKMANSHIP, EQUIPMENT, DESIGN
  defectDescription String? @db.Text

  // Time Tracking
  startTime       DateTime?
  endTime         DateTime?
  durationMinutes Int?

  // Quality Data
  qcCheckpoint String?
  qcResult     String? // PASS, FAIL

  // Metadata
  notes       String? @db.Text
  attachments Json? // Photos, documents

  createdAt DateTime @default(now())

  // Relations
  assemblyOrder AssemblyOrder @relation(fields: [assemblyOrderId], references: [id], onDelete: Cascade)
  operator      User          @relation("ProductionOperator", fields: [operatorId], references: [id])

  @@index([assemblyOrderId])
  @@index([eventType])
  @@index([eventDate])
  @@map("assembly_production_logs")
}

// Enums for Kitting & Assembly

enum BOMType {
  ASSEMBLY // Standard assembly (combine components)
  DISASSEMBLY // Breakdown into components
  KIT // Bundle/kit of items
  RECIPE // Recipe-based (food, chemicals)
  CONFIGURATION // Configured product
}

enum BOMStatus {
  DRAFT // Being created
  PENDING_APPROVAL // Awaiting approval
  APPROVED // Approved and active
  OBSOLETE // No longer used
  ARCHIVED // Archived for history
}

enum AssemblyStatus {
  PENDING // Awaiting start
  READY // Components reserved, ready to start
  IN_PROGRESS // Assembly in progress
  ON_HOLD // Temporarily paused
  COMPLETED // Assembly completed
  CANCELLED // Cancelled
  FAILED // Failed (quality issues)
}

enum IssueStatus {
  ISSUED // Components issued
  PARTIALLY_CONSUMED // Some components used
  FULLY_CONSUMED // All components consumed
  PARTIALLY_RETURNED // Some returned
  RETURNED // All returned
  SCRAPPED // Scrapped/wasted
}

enum ProductionEventType {
  START // Production started
  PRODUCTION // Production output recorded
  SCRAP // Scrap recorded
  PAUSE // Production paused
  RESUME // Production resumed
  COMPLETE // Production completed
  QC_CHECK // Quality check performed
  REWORK // Rework performed
  EQUIPMENT_CHANGE // Equipment changed
  MATERIAL_CHANGE // Material substitution
}

// ==========================================
// ANALYTICS & REPORTING
// ==========================================

model Report {
  id             String @id @default(cuid())
  organizationId String

  // Report Identification
  name        String
  description String? @db.Text
  code        String // Unique code per organization

  // Report Configuration
  reportType ReportType
  category   ReportCategory

  // Data Configuration
  dataSource String // Table/entity name
  filters    Json? // Filter configuration
  groupBy    Json? // Group by fields
  sortBy     Json? // Sort configuration
  columns    Json // Column definitions with aggregations

  // Visualization
  chartType   ChartType?
  chartConfig Json? // Chart-specific configuration

  // Schedule
  isScheduled    Boolean       @default(false)
  scheduleType   ScheduleType?
  scheduleConfig Json? // Cron expression or interval config

  // Distribution
  emailRecipients Json? // Array of email addresses
  webhookUrl      String?

  // Access Control
  isPublic       Boolean @default(false)
  allowedRoles   Json? // Array of roles
  allowedUserIds Json? // Array of user IDs

  // Status
  isActive  Boolean   @default(true)
  lastRunAt DateTime?
  nextRunAt DateTime?

  // Metadata
  tags         Json? // Array of tags
  customFields Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  // Relations
  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User              @relation("ReportCreator", fields: [createdById], references: [id])
  executions   ReportExecution[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([reportType])
  @@index([category])
  @@index([isActive])
  @@map("reports")
}

model ReportExecution {
  id             String @id @default(cuid())
  reportId       String
  organizationId String

  // Execution Details
  executionNumber String // AUTO: EXEC-YYYYMMDD-XXX
  status          ExecutionStatus @default(PENDING)

  // Timing
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  durationMs  Int? // Execution time in milliseconds

  // Results
  resultCount Int     @default(0)
  resultData  Json? // Actual report data (limited for large datasets)
  resultUrl   String? // URL to full results file

  // Parameters
  parameters Json? // Runtime parameters
  filters    Json? // Applied filters

  // Distribution
  emailSent     Boolean   @default(false)
  emailSentAt   DateTime?
  webhookSent   Boolean   @default(false)
  webhookSentAt DateTime?

  // Error Handling
  error      String? @db.Text
  errorStack String? @db.Text

  // Metadata
  fileSize   Int? // Size in bytes
  fileFormat String? // PDF, XLSX, CSV

  createdAt    DateTime @default(now())
  executedById String?

  // Relations
  report       Report       @relation(fields: [reportId], references: [id], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  executedBy   User?        @relation("ReportExecutor", fields: [executedById], references: [id])

  @@index([reportId])
  @@index([organizationId])
  @@index([status])
  @@index([startedAt])
  @@map("report_executions")
}

model Dashboard {
  id             String @id @default(cuid())
  organizationId String

  // Dashboard Identification
  name        String
  description String? @db.Text
  slug        String // URL-friendly identifier

  // Configuration
  layout  Json // Grid layout configuration
  widgets Json // Array of widget configurations

  // Dashboard Type
  dashboardType DashboardType @default(CUSTOM)
  category      String? // OPERATIONS, SALES, FINANCE, INVENTORY

  // Access Control
  isPublic       Boolean @default(false)
  isDefault      Boolean @default(false) // Default dashboard for role
  allowedRoles   Json?
  allowedUserIds Json?

  // Refresh
  autoRefresh     Boolean @default(false)
  refreshInterval Int? // Seconds

  // Status
  isActive Boolean @default(true)

  // Metadata
  icon  String?
  color String?
  tags  Json?

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdBy    User         @relation("DashboardCreator", fields: [createdById], references: [id])

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([dashboardType])
  @@index([isActive])
  @@map("dashboards")
}

model AnalyticsEvent {
  id             String @id @default(cuid())
  organizationId String

  // Event Details
  eventType String // USER_ACTION, SYSTEM_EVENT, BUSINESS_EVENT
  eventName String // login, order_created, inventory_updated
  category  String? // auth, orders, inventory, users

  // User Context
  userId    String?
  sessionId String?
  ipAddress String?
  userAgent String?

  // Event Data
  properties Json? // Event-specific properties
  metadata   Json? // Additional metadata

  // Performance
  duration Int? // Duration in milliseconds

  // Status
  success      Boolean @default(true)
  errorMessage String? @db.Text

  // Timestamps
  timestamp DateTime @default(now())

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation("AnalyticsUser", fields: [userId], references: [id])

  @@index([organizationId])
  @@index([eventType])
  @@index([eventName])
  @@index([category])
  @@index([userId])
  @@index([timestamp])
  @@map("analytics_events")
}

model KPIMetric {
  id             String @id @default(cuid())
  organizationId String

  // KPI Identification
  metricCode  String // REVENUE_TODAY, ORDERS_PENDING, INVENTORY_VALUE
  metricName  String
  description String?        @db.Text
  category    MetricCategory

  // Value
  currentValue  Decimal  @db.Decimal(18, 4)
  previousValue Decimal? @db.Decimal(18, 4)
  targetValue   Decimal? @db.Decimal(18, 4)

  // Units
  unit String? // USD, units, percentage, hours

  // Change Tracking
  changeAmount  Decimal?        @db.Decimal(18, 4)
  changePercent Decimal?        @db.Decimal(8, 2)
  trend         TrendDirection?

  // Time Period
  periodType  PeriodType @default(DAILY)
  periodStart DateTime
  periodEnd   DateTime

  // Status
  status         MetricStatus @default(NORMAL)
  alertThreshold Decimal?     @db.Decimal(18, 4)

  // Display
  displayOrder Int     @default(0)
  isVisible    Boolean @default(true)
  icon         String?
  color        String?

  // Metadata
  metadata Json?

  calculatedAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@unique([organizationId, metricCode, periodStart])
  @@index([organizationId])
  @@index([category])
  @@index([periodType])
  @@index([periodStart])
  @@map("kpi_metrics")
}

// Enums for Analytics & Reporting

enum ReportType {
  TABULAR // Standard table report
  SUMMARY // Summary/aggregated report
  CHART // Chart/visualization
  COMBINED // Table + Chart
  PIVOT // Pivot table
  MATRIX // Matrix/cross-tab
}

enum ReportCategory {
  INVENTORY // Inventory reports
  SALES // Sales reports
  PURCHASING // Purchasing reports
  WAREHOUSE // Warehouse operations
  FINANCIAL // Financial reports
  QUALITY // Quality control reports
  PRODUCTION // Production/assembly reports
  CUSTOM // Custom reports
}

enum ChartType {
  BAR // Bar chart
  LINE // Line chart
  PIE // Pie chart
  DONUT // Donut chart
  AREA // Area chart
  SCATTER // Scatter plot
  GAUGE // Gauge/meter
  FUNNEL // Funnel chart
  HEATMAP // Heat map
  TABLE // Data table
}

enum ScheduleType {
  HOURLY // Every hour
  DAILY // Daily
  WEEKLY // Weekly
  MONTHLY // Monthly
  CUSTOM // Custom cron expression
}

enum ExecutionStatus {
  PENDING // Waiting to run
  RUNNING // Currently executing
  COMPLETED // Successfully completed
  FAILED // Failed with error
  CANCELLED // Cancelled by user
}

enum DashboardType {
