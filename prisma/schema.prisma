model IoTSensorEvent {
  id             String   @id @default(cuid())
  organizationId String
  warehouseId    String
  locationId     String?
  deviceId       String
  sensorType     String // e.g. "WEIGHT_SCALE", "VISION_CAMERA"
  payload        Json // { weight: 0.5, unit: "kg" } or { emptySpacePct: 85 }
  triggeredTask  Boolean  @default(false)
  createdAt      DateTime @default(now())

  warehouse    Warehouse    @relation("WarehouseIoT", fields: [warehouseId], references: [id])
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([warehouseId])
  @@index([deviceId])
  @@map("iot_sensor_events")
}

// ─── Voice System (V-2) ────────────────────────────────────────────────────────

model VoiceSession {
  id             String             @id @default(cuid())
  userId         String
  organizationId String?
  transcript     String // raw text sent to the engine
  intent         String? // parsed intent label, e.g. "PICK"
  entities       Json? // extracted entities (sku, qty, location …)
  response       String? // text response returned to the user
  audioUrl       String? // optional URL to stored audio file
  language       String             @default("en")
  status         VoiceSessionStatus @default(PENDING)
  errorMessage   String?
  durationMs     Int? // processing time in milliseconds
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([organizationId])
  @@index([createdAt])
  @@map("voice_sessions")
}

enum VoiceSessionStatus {
  PENDING
  PROCESSED
  FAILED
  CANCELLED
}

// ─── Auth Security (required by apps/web/src/lib/auth.ts) ─────────────────────

model SecurityProfile {
