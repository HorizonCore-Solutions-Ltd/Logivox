// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ==========================================
// AUTHENTICATION & USER MANAGEMENT
// ==========================================

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  password      String? // For email/password auth
  role          UserRole  @default(USER)
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  accounts                Account[]
  sessions                Session[]
  organizationMemberships OrganizationMember[]
  createdOrganizations    Organization[]       @relation("OrganizationCreator")
  createdInventoryItems   InventoryItem[]      @relation("InventoryCreator")
  createdBookings         Booking[]            @relation("BookingCreator")
  createdPurchaseOrders   PurchaseOrder[]      @relation("POCreator")
  approvedPurchaseOrders  PurchaseOrder[]      @relation("POApprover")
  receivedGRNs            GoodsReceiptNote[]   @relation("GRNReceivedBy")
  qcGRNs                  GoodsReceiptNote[]   @relation("GRNQCBy")
  createdSalesOrders      SalesOrder[]         @relation("SOCreator")
  approvedSalesOrders     SalesOrder[]         @relation("SOApprover")
  pickedSalesOrders       SalesOrder[]         @relation("SOPicker")
  packedSalesOrders       SalesOrder[]         @relation("SOPacker")
  assignedPickLists       PickList[]           @relation("PickListAssignee")
  createdPickLists        PickList[]           @relation("PickListCreator")
  createdShipments        Shipment[]           @relation("ShipmentCreator")
  createdPacks            Pack[]               @relation("PackCreator")
  initiatedPacks          Pack[]               @relation("PackInitiator")
  activityLogs            ActivityLog[]

  @@index([email])
  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

enum UserRole {
  SUPER_ADMIN   // Platform administrator
  ADMIN         // Organization administrator
  MANAGER       // Department/warehouse manager
  USER          // Regular user
  VIEWER        // Read-only access
}

// ==========================================
// MULTI-TENANT ORGANIZATION MANAGEMENT
// ==========================================

model Organization {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  domain      String?  @unique // Custom domain for white-labeling
  logo        String?
  primaryColor String?  @default("#3B82F6")
  isActive    Boolean  @default(true)
  
  // Subscription & billing
  subscriptionTier  SubscriptionTier @default(FREE)
  subscriptionStatus String?          @default("active")
  billingEmail      String?
  
  // Settings
  timezone          String           @default("UTC")
  currency          String           @default("USD")
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  createdById String
  
  // Relations
  createdBy          User                 @relation("OrganizationCreator", fields: [createdById], references: [id])
  members            OrganizationMember[]
  warehouses         Warehouse[]
  inventoryItems     InventoryItem[]
  bookings           Booking[]
  categories         Category[]
  suppliers          Supplier[]
  customers          Customer[]
  purchaseOrders     PurchaseOrder[]
  goodsReceiptNotes  GoodsReceiptNote[]
  salesOrders        SalesOrder[]
  pickLists          PickList[]
  shipments          Shipment[]
  packs              Pack[]
  integrations       Integration[]
  apiKeys            ApiKey[]
  activityLogs       ActivityLog[]
  reorderAlerts      ReorderAlert[]

  @@index([slug])
  @@index([createdById])
  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  permissions    Json?            // Custom permissions
  isActive       Boolean          @default(true)
  joinedAt       DateTime         @default(now())
  
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

enum OrganizationRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  GUEST
}

enum SubscriptionTier {
  FREE
  STARTER
  PROFESSIONAL
  ENTERPRISE
}

// ==========================================
// INVENTORY MANAGEMENT
// ==========================================

model Warehouse {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String   // Unique code per organization
  address        String?
  city           String?
  country        String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItems InventoryItem[]
  grns           GoodsReceiptNote[]
  salesOrders    SalesOrder[]
  pickLists      PickList[]
  packs          Pack[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("warehouses")
}

model Category {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  parentId       String?
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[]      @relation("CategoryHierarchy")
  inventoryItems InventoryItem[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([parentId])
  @@map("categories")
}

model InventoryItem {
  id             String   @id @default(cuid())
  organizationId String
  warehouseId    String
  categoryId     String?
  supplierId     String?
  
  // Product details
  sku            String
  name           String
  description    String?  @db.Text
  barcode        String?
  
  // Inventory tracking
  quantity       Int      @default(0)
  reservedQty    Int      @default(0) // Quantity reserved in bookings
  availableQty   Int      @default(0) // quantity - reservedQty
  minStockLevel  Int      @default(0)
  maxStockLevel  Int?
  reorderPoint   Int?
  reorderQuantity Int?     @default(0) // How many to reorder when threshold hit
  leadTimeDays   Int?     @default(7)  // Supplier lead time in days
  lastReorderDate DateTime?             // Track when last reorder was triggered
  autoReorder    Boolean  @default(false) // Enable auto-reorder alerts
  
  // Pricing
  costPrice      Decimal? @db.Decimal(10, 2)
  sellingPrice   Decimal? @db.Decimal(10, 2)
  currency       String   @default("USD")
  
  // Status
  status         InventoryStatus @default(ACTIVE)
  isActive       Boolean         @default(true)
  
  // Metadata
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String
  
  // Relations
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouse          Warehouse            @relation(fields: [warehouseId], references: [id])
  category           Category?            @relation(fields: [categoryId], references: [id])
  supplier           Supplier?            @relation(fields: [supplierId], references: [id])
  createdBy          User                 @relation("InventoryCreator", fields: [createdById], references: [id])
  bookingItems       BookingItem[]
  movements          InventoryMovement[]
  reorderAlerts      ReorderAlert[]
  purchaseOrderItems PurchaseOrderItem[]  @relation("POInventoryItem")
  grnItems           GRNItem[]
  salesOrderItems    SalesOrderItem[]
  pickListItems      PickListItem[]
  packageItems       PackageItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([sku])
  @@map("inventory_items")
}

enum InventoryStatus {
  ACTIVE
  LOW_STOCK
  OUT_OF_STOCK
  DISCONTINUED
  DAMAGED
}

model InventoryMovement {
  id              String         @id @default(cuid())
  inventoryItemId String
  type            MovementType
  quantity        Int
  fromWarehouse   String?
  toWarehouse     String?
  reason          String?
  notes           String?        @db.Text
  createdAt       DateTime       @default(now())
  
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([createdAt])
  @@map("inventory_movements")
}

enum MovementType {
  PURCHASE
  SALE
  TRANSFER
  ADJUSTMENT
  RETURN
  DAMAGE
  BOOKING
  RELEASE
}

// ==========================================
// REORDER ALERTS
// ==========================================

model ReorderAlert {
  id              String        @id @default(cuid())
  organizationId  String
  inventoryItemId String
  
  // Alert details
  alertType       AlertType     @default(LOW_STOCK)
  severity        AlertSeverity @default(MEDIUM)
  status          AlertStatus   @default(PENDING)
  
  // Stock information at time of alert
  currentStock    Int
  reorderPoint    Int
  reorderQuantity Int
  estimatedStockoutDate DateTime?
  
  // Notification tracking
  emailSent       Boolean       @default(false)
  smsSent         Boolean       @default(false)
  slackSent       Boolean       @default(false)
  pushSent        Boolean       @default(false)
  
  sentAt          DateTime?
  acknowledgedAt  DateTime?
  resolvedAt      DateTime?
  dismissedAt     DateTime?
  
  notes           String?       @db.Text
  metadata        Json?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  // Relations
  organization    Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([inventoryItemId])
  @@index([status])
  @@index([createdAt])
  @@map("reorder_alerts")
}

enum AlertType {
  LOW_STOCK        // Below reorder point
  OUT_OF_STOCK     // Zero stock
  CRITICAL_STOCK   // Stockout imminent (within lead time)
  OVERSTOCK        // Above max stock level
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  PENDING
  ACKNOWLEDGED
  RESOLVED
  DISMISSED
  AUTO_RESOLVED
}

// ==========================================
// BOOKING MANAGEMENT
// ==========================================

model Booking {
  id             String        @id @default(cuid())
  organizationId String
  customerId     String?
  bookingNumber  String        @unique
  
  // Booking details
  status         BookingStatus @default(PENDING)
  priority       Priority      @default(MEDIUM)
  totalItems     Int           @default(0)
  totalValue     Decimal?      @db.Decimal(10, 2)
  
  // Dates
  bookedAt       DateTime      @default(now())
  requiredBy     DateTime?
  confirmedAt    DateTime?
  fulfilledAt    DateTime?
  cancelledAt    DateTime?
  
  // Notes
  notes          String?       @db.Text
  internalNotes  String?       @db.Text
  
  // Metadata
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String
  
  // Relations
  organization Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer     Customer?     @relation(fields: [customerId], references: [id])
  createdBy    User          @relation("BookingCreator", fields: [createdById], references: [id])
  items        BookingItem[]

  @@index([organizationId])
  @@index([customerId])
  @@index([bookingNumber])
  @@index([status])
  @@index([createdAt])
  @@map("bookings")
}

model BookingItem {
  id              String   @id @default(cuid())
  bookingId       String
  inventoryItemId String
  
  quantityBooked  Int
  quantityFulfilled Int    @default(0)
  unitPrice       Decimal? @db.Decimal(10, 2)
  totalPrice      Decimal? @db.Decimal(10, 2)
  
  notes           String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  
  booking       Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  inventoryItem InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([bookingId])
  @@index([inventoryItemId])
  @@map("booking_items")
}

enum BookingStatus {
  PENDING
  CONFIRMED
  PROCESSING
  FULFILLED
  PARTIALLY_FULFILLED
  CANCELLED
  ON_HOLD
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

// ==========================================
// SUPPLIERS & CUSTOMERS
// ==========================================

model Supplier {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  website        String?
  notes          String?  @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  inventoryItems  InventoryItem[]
  purchaseOrders  PurchaseOrder[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("suppliers")
}

model Customer {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  code           String
  email          String?
  phone          String?
  address        String?
  city           String?
  country        String?
  notes          String?  @db.Text
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  salesOrders  SalesOrder[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("customers")
}

// ==========================================
// PURCHASE ORDERS (Inbound Operations)
// ==========================================

model PurchaseOrder {
  id              String            @id @default(cuid())
  organizationId  String
  supplierId      String
  poNumber        String            @unique
  
  // Status & workflow
  status          POStatus          @default(DRAFT)
  priority        Priority          @default(MEDIUM)
  
  // Dates
  orderDate       DateTime          @default(now())
  expectedDate    DateTime?
  approvedDate    DateTime?
  receivedDate    DateTime?
  cancelledDate   DateTime?
  
  // Financial
  subtotal        Decimal?          @db.Decimal(10, 2)
  tax             Decimal?          @db.Decimal(10, 2)
  shipping        Decimal?          @db.Decimal(10, 2)
  totalAmount     Decimal?          @db.Decimal(10, 2)
  currency        String            @default("USD")
  
  // Delivery information
  deliveryAddress String?
  deliveryCity    String?
  deliveryCountry String?
  deliveryNotes   String?           @db.Text
  
  // Internal tracking
  notes           String?           @db.Text
  internalNotes   String?           @db.Text
  approvedById    String?
  
  // Metadata
  metadata        Json?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdById     String
  
  // Relations
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier        Supplier          @relation(fields: [supplierId], references: [id])
  createdBy       User              @relation("POCreator", fields: [createdById], references: [id])
  approvedBy      User?             @relation("POApprover", fields: [approvedById], references: [id])
  items           PurchaseOrderItem[]
  receipts        GoodsReceiptNote[]

  @@index([organizationId])
  @@index([supplierId])
  @@index([poNumber])
  @@index([status])
  @@index([createdAt])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String
  inventoryItemId String?
  
  // Product details
  sku             String
  description     String
  
  // Quantity & pricing
  quantityOrdered Int
  quantityReceived Int          @default(0)
  unitPrice       Decimal       @db.Decimal(10, 2)
  tax             Decimal?      @db.Decimal(10, 2)
  totalPrice      Decimal       @db.Decimal(10, 2)
  
  // Metadata
  notes           String?       @db.Text
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  
  // Relations
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryItem   InventoryItem? @relation("POInventoryItem", fields: [inventoryItemId], references: [id])
  grnItems        GRNItem[]

  @@index([purchaseOrderId])
  @@index([inventoryItemId])
  @@map("purchase_order_items")
}

enum POStatus {
  DRAFT               // Being created
  PENDING             // Awaiting approval
  APPROVED            // Approved, ready to send
  SENT                // Sent to supplier
  CONFIRMED           // Confirmed by supplier
  PARTIALLY_RECEIVED  // Some items received
  RECEIVED            // All items received
  CANCELLED           // Cancelled
  CLOSED              // Completed and closed
}

// ==========================================
// GOODS RECEIPT NOTE (GRN) - Receiving System
// ==========================================

enum GRNStatus {
  DRAFT           // Being created
  PENDING         // Submitted for QC
  QUALITY_CHECK   // Under quality inspection
  APPROVED        // QC passed
  REJECTED        // QC failed
  COMPLETED       // Finalized & inventory updated
}

model GoodsReceiptNote {
  id                String    @id @default(cuid())
  organizationId    String
  purchaseOrderId   String
  warehouseId       String?
  grnNumber         String    @unique
  status            GRNStatus @default(DRAFT)
  receivedDate      DateTime  @default(now())
  receivedById      String
  
  // Quality Control
  qcStatus          String?   // PASS, FAIL, PENDING
  qcNotes           String?   @db.Text
  qcById            String?
  qcDate            DateTime?
  
  // Discrepancies
  hasDiscrepancy    Boolean   @default(false)
  discrepancyNotes  String?   @db.Text
  
  // Financial
  totalReceived     Decimal   @default(0) @db.Decimal(10, 2)
  currency          String    @default("GBP")
  
  // Location & Put-away
  receivingDock     String?
  putAwayCompleted  Boolean   @default(false)
  putAwayDate       DateTime?
  
  // Metadata
  notes             String?   @db.Text
  internalNotes     String?   @db.Text
  attachments       Json?     // Array of file URLs
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  
  // Relations
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  purchaseOrder     PurchaseOrder @relation(fields: [purchaseOrderId], references: [id])
  warehouse         Warehouse? @relation(fields: [warehouseId], references: [id])
  receivedBy        User @relation("GRNReceivedBy", fields: [receivedById], references: [id])
  qcBy              User? @relation("GRNQCBy", fields: [qcById], references: [id])
  items             GRNItem[]

  @@index([organizationId])
  @@index([purchaseOrderId])
  @@index([warehouseId])
  @@index([status])
  @@index([receivedDate])
  @@map("goods_receipt_notes")
}

model GRNItem {
  id                  String   @id @default(cuid())
  grnId               String
  purchaseOrderItemId String?
  inventoryItemId     String
  
  // Quantities
  orderedQuantity     Int      // From PO
  receivedQuantity    Int      // Actually received
  acceptedQuantity    Int      // After QC
  rejectedQuantity    Int      @default(0)
  
  // Quality
  qcStatus            String?  // PASS, FAIL, PENDING
  qcNotes             String?  @db.Text
  hasDefects          Boolean  @default(false)
  defectDescription   String?  @db.Text
  
  // Location
  binLocation         String?
  putAwayCompleted    Boolean  @default(false)
  
  // Batch/Serial Tracking
  batchNumber         String?
  serialNumbers       Json?    // Array of serial numbers
  expiryDate          DateTime?
  
  // Financial
  unitCost            Decimal  @db.Decimal(10, 2)
  
  // Metadata
  notes               String?  @db.Text
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt
  
  // Relations
  grn                 GoodsReceiptNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  purchaseOrderItem   PurchaseOrderItem? @relation(fields: [purchaseOrderItemId], references: [id])
  inventoryItem       InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([grnId])
  @@index([inventoryItemId])
  @@index([purchaseOrderItemId])
  @@map("grn_items")
}

// ==========================================
// SALES ORDERS & OUTBOUND OPERATIONS
// ==========================================

enum SalesOrderStatus {
  DRAFT              // Initial creation
  PENDING_APPROVAL   // Awaiting approval
  APPROVED           // Approved, ready to pick
  PICKING            // Items being picked
  PICKED             // All items picked
  PACKING            // Items being packed
  PACKED             // Ready to ship
  SHIPPED            // Shipped to customer
  DELIVERED          // Delivered successfully
  CANCELLED          // Order cancelled
  ON_HOLD            // Temporarily paused
}

enum PaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED
  OVERDUE
}

enum ShippingMethod {
  STANDARD
  EXPRESS
  OVERNIGHT
  PICKUP
  FREIGHT
}

model SalesOrder {
  id              String            @id @default(cuid())
  organizationId  String
  soNumber        String            // Auto-generated (SO-YYYYMMDD-XXX)
  
  // Customer Information
  customerId      String
  
  // Order Details
  status          SalesOrderStatus  @default(DRAFT)
  orderDate       DateTime          @default(now())
  requestedDate   DateTime?         // Customer requested delivery date
  promisedDate    DateTime?         // Promised delivery date
  
  // Warehouse & Fulfillment
  warehouseId     String?
  
  // Shipping Information
  shippingMethod  ShippingMethod?
  shippingAddress String?           @db.Text
  shippingCity    String?
  shippingState   String?
  shippingZip     String?
  shippingCountry String?
  trackingNumber  String?
  carrierName     String?
  shippedDate     DateTime?
  deliveredDate   DateTime?
  
  // Financial
  subtotal        Decimal           @db.Decimal(10, 2)
  taxAmount       Decimal           @db.Decimal(10, 2) @default(0)
  shippingCost    Decimal           @db.Decimal(10, 2) @default(0)
  discount        Decimal           @db.Decimal(10, 2) @default(0)
  total           Decimal           @db.Decimal(10, 2)
  currency        String            @default("USD")
  
  // Payment
  paymentStatus   PaymentStatus     @default(UNPAID)
  paymentMethod   String?
  paidAmount      Decimal           @db.Decimal(10, 2) @default(0)
  
  // Workflow
  priority        Int               @default(0) // Higher = more urgent
  approvedById    String?
  approvedDate    DateTime?
  pickedById      String?
  pickedDate      DateTime?
  packedById      String?
  packedDate      DateTime?
  
  // Metadata
  notes           String?           @db.Text
  internalNotes   String?           @db.Text
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  createdById     String
  
  // Relations
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customer        Customer          @relation(fields: [customerId], references: [id])
  warehouse       Warehouse?        @relation(fields: [warehouseId], references: [id])
  createdBy       User              @relation("SOCreator", fields: [createdById], references: [id])
  approvedBy      User?             @relation("SOApprover", fields: [approvedById], references: [id])
  pickedBy        User?             @relation("SOPicker", fields: [pickedById], references: [id])
  packedBy        User?             @relation("SOPacker", fields: [packedById], references: [id])
  items           SalesOrderItem[]
  pickLists       PickList[]
  shipments       Shipment[]
  packs           Pack[]

  @@unique([organizationId, soNumber])
  @@index([organizationId])
  @@index([customerId])
  @@index([warehouseId])
  @@index([status])
  @@index([orderDate])
  @@map("sales_orders")
}

model SalesOrderItem {
  id                String        @id @default(cuid())
  salesOrderId      String
  inventoryItemId   String
  
  // Quantities
  quantity          Int
  quantityPicked    Int           @default(0)
  quantityPacked    Int           @default(0)
  quantityShipped   Int           @default(0)
  
  // Pricing
  unitPrice         Decimal       @db.Decimal(10, 2)
  discount          Decimal       @db.Decimal(10, 2) @default(0)
  taxRate           Decimal       @db.Decimal(5, 2) @default(0)
  lineTotal         Decimal       @db.Decimal(10, 2)
  
  // Fulfillment
  binLocation       String?
  batchNumber       String?
  serialNumbers     Json?         // Array of serial numbers
  
  // Metadata
  notes             String?       @db.Text
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  
  // Relations
  salesOrder        SalesOrder    @relation(fields: [salesOrderId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id])
  pickListItems     PickListItem[]
  packageItems      PackageItem[]

  @@index([salesOrderId])
  @@index([inventoryItemId])
  @@map("sales_order_items")
}

enum PickListStatus {
  PENDING
  IN_PROGRESS
  PICKED
  CANCELLED
}

model PickList {
  id              String          @id @default(cuid())
  organizationId  String
  pickListNumber  String          // Auto-generated (PICK-YYYYMMDD-XXX)
  salesOrderId    String
  warehouseId     String
  
  status          PickListStatus  @default(PENDING)
  priority        Int             @default(0)
  
  // Assignment
  assignedToId    String?
  assignedDate    DateTime?
  startedDate     DateTime?
  completedDate   DateTime?
  
  // Metadata
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdById     String
  
  // Relations
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder      SalesOrder      @relation(fields: [salesOrderId], references: [id])
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  assignedTo      User?           @relation("PickListAssignee", fields: [assignedToId], references: [id])
  createdBy       User            @relation("PickListCreator", fields: [createdById], references: [id])
  items           PickListItem[]
  packs           Pack[]

  @@unique([organizationId, pickListNumber])
  @@index([organizationId])
  @@index([salesOrderId])
  @@index([warehouseId])
  @@index([status])
  @@map("pick_lists")
}

model PickListItem {
  id                String         @id @default(cuid())
  pickListId        String
  salesOrderItemId  String
  inventoryItemId   String
  
  quantityToPick    Int
  quantityPicked    Int            @default(0)
  binLocation       String?
  batchNumber       String?
  serialNumbers     Json?
  
  pickedAt          DateTime?
  
  // Relations
  pickList          PickList       @relation(fields: [pickListId], references: [id], onDelete: Cascade)
  salesOrderItem    SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  inventoryItem     InventoryItem  @relation(fields: [inventoryItemId], references: [id])

  @@index([pickListId])
  @@index([salesOrderItemId])
  @@index([inventoryItemId])
  @@map("pick_list_items")
}

enum PackingStatus {
  PENDING
  IN_PROGRESS
  PACKED
  CANCELLED
}

model Pack {
  id              String          @id @default(cuid())
  organizationId  String
  packNumber      String          // Auto-generated (PACK-YYYYMMDD-XXX)
  salesOrderId    String
  pickListId      String?
  warehouseId     String
  
  status          PackingStatus   @default(PENDING)
  
  // Assignment
  packedById      String?
  startedDate     DateTime?
  completedDate   DateTime?
  
  // Package details
  totalPackages   Int             @default(0)
  totalWeight     Decimal?        @db.Decimal(10, 2)
  weightUnit      String?         @default("kg")
  
  // Metadata
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdById     String
  
  // Relations
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder      SalesOrder      @relation(fields: [salesOrderId], references: [id])
  pickList        PickList?       @relation(fields: [pickListId], references: [id])
  warehouse       Warehouse       @relation(fields: [warehouseId], references: [id])
  packedBy        User?           @relation("PackCreator", fields: [packedById], references: [id])
  createdBy       User            @relation("PackInitiator", fields: [createdById], references: [id])
  packages        Package[]

  @@unique([organizationId, packNumber])
  @@index([organizationId])
  @@index([salesOrderId])
  @@index([pickListId])
  @@index([warehouseId])
  @@index([status])
  @@map("packs")
}

model Package {
  id              String          @id @default(cuid())
  packId          String
  packageNumber   String          // Sequential within pack (1, 2, 3...)
  
  // Package details
  packageType     String?         // Box, Pallet, Envelope, etc.
  weight          Decimal?        @db.Decimal(10, 2)
  weightUnit      String?         @default("kg")
  dimensions      Json?           // {length, width, height, unit}
  
  // Tracking
  trackingNumber  String?
  labelUrl        String?
  
  // Contents
  items           PackageItem[]
  
  // Metadata
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  
  // Relations
  pack            Pack            @relation(fields: [packId], references: [id], onDelete: Cascade)

  @@index([packId])
  @@index([trackingNumber])
  @@map("packages")
}

model PackageItem {
  id                String         @id @default(cuid())
  packageId         String
  salesOrderItemId  String
  inventoryItemId   String
  
  quantity          Int
  binLocation       String?
  batchNumber       String?
  serialNumbers     Json?
  
  // Relations
  package           Package        @relation(fields: [packageId], references: [id], onDelete: Cascade)
  salesOrderItem    SalesOrderItem @relation(fields: [salesOrderItemId], references: [id])
  inventoryItem     InventoryItem  @relation(fields: [inventoryItemId], references: [id])

  @@index([packageId])
  @@index([salesOrderItemId])
  @@index([inventoryItemId])
  @@map("package_items")
}

enum ShipmentStatus {
  PENDING
  PROCESSING
  SHIPPED
  IN_TRANSIT
  DELIVERED
  FAILED
  CANCELLED
}

model Shipment {
  id              String          @id @default(cuid())
  organizationId  String
  shipmentNumber  String          // Auto-generated (SHIP-YYYYMMDD-XXX)
  salesOrderId    String
  
  status          ShipmentStatus  @default(PENDING)
  
  // Carrier Information
  carrierName     String?
  carrierService  String?
  trackingNumber  String?
  trackingUrl     String?
  labelUrl        String?
  
  // Shipping Details
  weight          Decimal?        @db.Decimal(10, 2)
  weightUnit      String?         @default("kg")
  dimensions      Json?           // {length, width, height, unit}
  
  // Dates
  shippedDate     DateTime?
  estimatedDelivery DateTime?
  actualDelivery  DateTime?
  
  // Cost
  shippingCost    Decimal?        @db.Decimal(10, 2)
  currency        String          @default("USD")
  
  // Metadata
  notes           String?         @db.Text
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  createdById     String
  
  // Relations
  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder      SalesOrder      @relation(fields: [salesOrderId], references: [id])
  createdBy       User            @relation("ShipmentCreator", fields: [createdById], references: [id])

  @@unique([organizationId, shipmentNumber])
  @@index([organizationId])
  @@index([salesOrderId])
  @@index([status])
  @@index([trackingNumber])
  @@map("shipments")
}

// ==========================================
// INTEGRATIONS & API
// ==========================================

model Integration {
  id             String          @id @default(cuid())
  organizationId String
  type           IntegrationType
  name           String
  config         Json            // Integration-specific configuration
  isActive       Boolean         @default(true)
  lastSyncAt     DateTime?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([type])
  @@map("integrations")
}

enum IntegrationType {
  ERP
  ECOMMERCE
  ACCOUNTING
  CRM
  WAREHOUSE
  SHIPPING
  ANALYTICS
  CUSTOM
}

model ApiKey {
  id             String   @id @default(cuid())
  organizationId String
  name           String
  key            String   @unique
  permissions    Json?
  isActive       Boolean  @default(true)
  expiresAt      DateTime?
  lastUsedAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([key])
  @@map("api_keys")
}

// ==========================================
// AUDIT & ACTIVITY LOGGING
// ==========================================

model ActivityLog {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?
  action         String
  entityType     String
  entityId       String?
  metadata       Json?
  ipAddress      String?
  userAgent      String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user         User?        @relation(fields: [userId], references: [id])

  @@index([organizationId])
  @@index([userId])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("activity_logs")
}
