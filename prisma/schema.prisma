// ─────────────────────────────────────────────────────────────────────────────
// EXCEPTION MANAGEMENT
// ─────────────────────────────────────────────────────────────────────────────

model ExceptionRecord {
  id               String            @id @default(cuid())
  organizationId   String
  type             ExceptionType
  severity         ExceptionSeverity @default(MEDIUM)
  status           ExceptionStatus   @default(OPEN)
  title            String
  description      String?
  resourceType     String? // "SalesOrder", "Shipment", "InventoryItem" etc.
  resourceId       String?
  resourceRef      String? // human-readable reference (SO-0001)
  detectedAt       DateTime          @default(now())
  acknowledgedAt   DateTime?
  acknowledgedById String?
  resolvedAt       DateTime?
  resolvedById     String?
  resolution       String?
  autoResolved     Boolean           @default(false)
  slaBreachAt      DateTime? // when SLA will/did breach
  slaBreached      Boolean           @default(false)
  metadata         Json?
  escalatedAt      DateTime?
  escalatedToId    String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([type])
  @@index([status])
  @@index([severity])
  @@index([resourceType, resourceId])
  @@index([detectedAt])
  @@map("exception_records")
}

enum ExceptionType {
  DELAYED_ORDER
  SLA_BREACH
  STOCKOUT
  LOW_STOCK
  OVERDUE_INVOICE
  OVERDUE_SHIPMENT
  PICKING_ERROR
  RECEIVING_DISCREPANCY
  CREDIT_LIMIT_EXCEEDED
  DAMAGED_GOODS
  CARRIER_FAILURE
  SYSTEM_ERROR
  CUSTOM
}

enum ExceptionSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum ExceptionStatus {
  OPEN
  ACKNOWLEDGED
  IN_PROGRESS
  RESOLVED
  CLOSED
  SUPPRESSED
}

