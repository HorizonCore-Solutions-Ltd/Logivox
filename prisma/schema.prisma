// ============================================================================
// ADVANCED WAREHOUSE OPERATIONS
// ============================================================================

// WavePick - Wave picking strategy for batch order fulfillment
model WavePick {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  // Wave identification
  waveNumber  String // Auto-generated: WAVE-YYYYMMDD-XXXX
  name        String // Wave name
  description String?      @db.Text
  waveType    WaveType // Wave type
  priority    WavePriority @default(NORMAL)

  // Wave strategy
  strategy         WaveStrategy // Picking strategy
  groupingCriteria Json // Criteria for grouping orders (zone, carrier, ship date)
  maxLines         Int? // Maximum pick lines per wave
  maxOrders        Int? // Maximum orders per wave
  maxWeight        Decimal?     @db.Decimal(10, 2) // Maximum weight
  maxVolume        Decimal?     @db.Decimal(10, 2) // Maximum volume

  // Scheduling
  scheduledFor DateTime? // Scheduled start time
  releaseTime  DateTime? // Time wave was released
  pickDeadline DateTime? // Pick completion deadline
  shipDate     DateTime? // Target ship date

  // Status tracking
  status WaveStatus @default(PLANNED)

  // Statistics
  totalOrders   Int      @default(0)
  totalLines    Int      @default(0)
  totalQuantity Int      @default(0)
  totalWeight   Decimal? @db.Decimal(10, 2)
  totalVolume   Decimal? @db.Decimal(10, 2)

  // Progress tracking
  pickedLines   Int     @default(0)
  packedOrders  Int     @default(0)
  shippedOrders Int     @default(0)
  progress      Decimal @default(0) @db.Decimal(5, 2) // Percentage

  // Timing
  startedAt   DateTime?
  completedAt DateTime?
  duration    Int? // Duration in minutes

  // Assignment
  assignedToId String?
  assignedTo   User?     @relation("WaveAssignee", fields: [assignedToId], references: [id])
  assignedAt   DateTime?

  // Performance metrics
  pickRate Decimal? @db.Decimal(8, 2) // Lines per hour
  accuracy Decimal? @db.Decimal(5, 2) // Percentage

  // Metadata
  tags     String[]
  notes    String?  @db.Text
  metadata Json?

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("WaveCreator", fields: [createdById], references: [id])

  // Relations
  lines  WavePickLine[]
  tasks  PickingTask[]
  routes PickingRoute[]

  @@unique([organizationId, waveNumber])
  @@index([organizationId, warehouseId])
  @@index([status])
  @@index([scheduledFor])
  @@index([assignedToId])
}

// WavePickLine - Individual pick line within a wave
model WavePickLine {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  wavePickId     String
  wavePick       WavePick     @relation(fields: [wavePickId], references: [id], onDelete: Cascade)

  // Line details
  lineNumber   Int // Sequential line number in wave
  salesOrderId String
  salesOrder   SalesOrder @relation(fields: [salesOrderId], references: [id])
  pickListId   String?
  pickList     PickList?  @relation(fields: [pickListId], references: [id])

  // Item details
  inventoryItemId String
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id])
  locationId      String?
  location        Location?     @relation(fields: [locationId], references: [id])

  // Quantities
  orderedQuantity Int
  pickedQuantity  Int @default(0)
  shortQuantity   Int @default(0)

  // Batch/Serial tracking
  lotId         String?
  lot           Lot?     @relation(fields: [lotId], references: [id])
  serialNumbers String[] // Array of serial numbers

  // Priority & sequencing
  priority     Int  @default(0)
  pickSequence Int? // Optimized pick sequence
  zoneSequence Int? // Zone-based sequence

  // Status
  status PickLineStatus @default(PENDING)

  // Assignment
  assignedToId String?
  assignedTo   User?     @relation("LinePickerAssignee", fields: [assignedToId], references: [id])
  pickedAt     DateTime?
  pickedById   String?
  pickedBy     User?     @relation("LinePicker", fields: [pickedById], references: [id])

  // Verification
  verified     Boolean   @default(false)
  verifiedAt   DateTime?
  verifiedById String?
  verifiedBy   User?     @relation("LineVerifier", fields: [verifiedById], references: [id])

  // Notes & issues
  notes  String?
  issues Json? // Array of issues encountered

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, wavePickId])
  @@index([salesOrderId])
  @@index([inventoryItemId])
  @@index([status])
  @@index([assignedToId])
}

// PickingTask - Individual picking task assignment
model PickingTask {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  // Task identification
  taskNumber String // Auto-generated: TASK-YYYYMMDD-XXXX
  taskType   TaskType
  priority   TaskPriority @default(NORMAL)

  // Task details
  title        String
  description  String? @db.Text
  instructions String? @db.Text

  // Source reference
  sourceType String? // Source entity type (WavePick, PickList, etc.)
  sourceId   String? // Source entity ID
  wavePickId String?
  wavePick   WavePick? @relation(fields: [wavePickId], references: [id])

  // Location details
  fromLocationId String?
  fromLocation   Location? @relation("TaskFromLocation", fields: [fromLocationId], references: [id])
  toLocationId   String?
  toLocation     Location? @relation("TaskToLocation", fields: [toLocationId], references: [id])

  // Item details (for pick/put tasks)
  inventoryItemId String?
  inventoryItem   InventoryItem? @relation(fields: [inventoryItemId], references: [id])
  quantity        Int?

  // Status & progress
  status   TaskStatus @default(PENDING)
  progress Decimal    @default(0) @db.Decimal(5, 2) // Percentage

  // Assignment
  assignedToId String?
  assignedTo   User?      @relation("TaskAssignee", fields: [assignedToId], references: [id])
  assignedAt   DateTime?
  
  // Employee Assignment (for labor management)
  employeeId   String?
  employee     Employee?  @relation("TaskAssignee", fields: [employeeId], references: [id])

  // Timing
  scheduledFor DateTime?
  dueBy        DateTime?
  startedAt    DateTime?
  completedAt  DateTime?
  duration     Int? // Duration in seconds

  // Completion details
  completedById   String?
  completedBy     User?   @relation("TaskCompleter", fields: [completedById], references: [id])
  completionNotes String? @db.Text

  // Dependencies
  dependsOn String[] // Array of task IDs this depends on
  blockedBy String[] // Array of task IDs blocking this

  // Metadata
  metadata Json?

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("TaskCreator", fields: [createdById], references: [id])

  @@unique([organizationId, taskNumber])
  @@index([organizationId, warehouseId])
  @@index([taskType])
  @@index([status])
  @@index([assignedToId])
  @@index([scheduledFor])
}

// PickingRoute - Optimized route for picking tasks
model PickingRoute {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  warehouseId    String
  warehouse      Warehouse    @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  // Route identification
  routeNumber String // Auto-generated: ROUTE-YYYYMMDD-XXXX
  name        String
  description String? @db.Text

  // Route details
  wavePickId         String?
  wavePick           WavePick?          @relation(fields: [wavePickId], references: [id])
  routeType          RouteType          @default(STANDARD)
  optimizationMethod OptimizationMethod @default(SHORTEST_PATH)

  // Route configuration
  startLocationId String?
  startLocation   Location? @relation("RouteStart", fields: [startLocationId], references: [id])
  endLocationId   String?
  endLocation     Location? @relation("RouteEnd", fields: [endLocationId], references: [id])

  // Route waypoints
  waypoints Json // Array of location IDs in sequence
  // Example: [{ locationId: "loc1", sequence: 1, distance: 10, estimatedTime: 30 }]

  // Statistics
  totalStops        Int      @default(0)
  totalDistance     Decimal? @db.Decimal(10, 2) // Distance in meters
  estimatedDuration Int? // Estimated duration in seconds
  actualDuration    Int? // Actual duration in seconds

  // Status
  status RouteStatus @default(PLANNED)

  // Assignment
  assignedToId String?
  assignedTo   User?     @relation("RouteAssignee", fields: [assignedToId], references: [id])
  assignedAt   DateTime?

  // Timing
  startedAt   DateTime?
  completedAt DateTime?

  // Performance
  efficiency Decimal? @db.Decimal(5, 2) // Percentage
  deviations Json? // Deviations from planned route

  // Metadata
  metadata Json?

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("RouteCreator", fields: [createdById], references: [id])

  @@unique([organizationId, routeNumber])
  @@index([organizationId, warehouseId])
  @@index([wavePickId])
  @@index([status])
  @@index([assignedToId])
}

// TaskAutomation - Automated task creation rules
model TaskAutomation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  // Automation identification
  name        String
  code        String // Unique code
  description String? @db.Text

  // Trigger configuration
  triggerEvent      TriggerEvent // Event that triggers automation
  triggerConditions Json // Conditions for triggering
  // Example: { "field": "quantity", "operator": "lt", "value": 10 }

  // Task template
  taskType     TaskType
  taskPriority TaskPriority @default(NORMAL)
  taskTemplate Json // Template for creating tasks
  // Example: { "title": "Restock {{item}}", "instructions": "..." }

  // Assignment rules
  assignmentRule AssignmentRule @default(ROUND_ROBIN)
  assignToRole   String? // Role to assign to
  assignToUserId String? // Specific user to assign to
  assignToUser   User?          @relation("AutomationAssignee", fields: [assignToUserId], references: [id])

  // Scheduling
  scheduleType ScheduleType @default(HOURLY)
  scheduleTime String? // Time of day (HH:MM)
  scheduleDays String[] // Days of week
  delay        Int? // Delay in minutes

  // Frequency limits
  maxExecutionsPerDay  Int?
  maxExecutionsPerHour Int?
  cooldownPeriod       Int? // Minutes between executions

  // Status & monitoring
  isActive        Boolean   @default(true)
  lastTriggeredAt DateTime?
  lastExecutionAt DateTime?
  executionCount  Int       @default(0)
  successCount    Int       @default(0)
  failureCount    Int       @default(0)

  // Error handling
  lastError      String? @db.Text
  retryOnFailure Boolean @default(true)
  maxRetries     Int     @default(3)

  // Metadata
  tags     String[]
  metadata Json?

  // Timestamps
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  createdById String
  createdBy   User     @relation("AutomationCreator", fields: [createdById], references: [id])

  // Relations
  executions TaskExecution[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([triggerEvent])
  @@index([isActive])
}

// TaskExecution - Execution log for automated tasks
model TaskExecution {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  automationId   String
  automation     TaskAutomation @relation(fields: [automationId], references: [id], onDelete: Cascade)

  // Execution details
  executionNumber String // Auto-generated: EXEC-YYYYMMDD-XXXX
  status          ExecutionStatus @default(PENDING)

  // Trigger details
  triggerData Json // Data that triggered execution
  triggeredBy String? // User ID if manually triggered

  // Created task reference
  taskId     String? // Created PickingTask ID
  taskNumber String? // Created task number

  // Timing
  startedAt   DateTime?
  completedAt DateTime?
  duration    Int? // Duration in milliseconds

  // Result
  result     Json? // Execution result
  error      String? @db.Text
  errorStack String? @db.Text

  // Retry tracking
  attempt     Int @default(1)
  maxAttempts Int @default(3)

  // Metadata
  metadata Json?

  // Timestamp
  createdAt DateTime @default(now())

  @@unique([organizationId, executionNumber])
  @@index([organizationId, automationId])
  @@index([status])
  @@index([createdAt])
}

// Enums for Advanced Operations

enum WaveType {
  SINGLE_ORDER // Wave for single order
  BATCH // Batch multiple orders
  ZONE // Zone-based wave
  CARRIER // Carrier-based wave
  PRIORITY // Priority-based wave
  CUSTOM // Custom wave type
}

enum WavePriority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

enum WaveStrategy {
  FIFO // First In First Out
  LIFO // Last In First Out
  ZONE_BASED // Pick by zone
  CARRIER_BASED // Group by carrier
  SHIP_DATE // Group by ship date
  PRIORITY // Priority-based
  SHORTEST_PATH // Optimize for shortest path
  CUSTOM // Custom strategy
}

enum WaveStatus {
  PLANNED // Wave planned
  RELEASED // Released for picking
  IN_PROGRESS // Picking in progress
  PICKED // All items picked
  VERIFIED // Picks verified
  PACKED // Orders packed
  SHIPPED // Orders shipped
  COMPLETED // Wave completed
  CANCELLED // Wave cancelled
  ON_HOLD // Temporarily on hold
}

enum PickLineStatus {
  PENDING // Waiting to be picked
  ASSIGNED // Assigned to picker
  IN_PROGRESS // Being picked
  PICKED // Picked
  SHORT // Short pick
  VERIFIED // Verified
  CANCELLED // Cancelled
}

enum TaskType {
  PICK // Pick task
  PUT // Put away task
  MOVE // Move inventory
  COUNT // Count task
  REPLENISH // Replenishment
  RESTOCK // Restock task
  PACK // Packing task
  INSPECT // Inspection task
  LABEL // Labeling task
  CUSTOM // Custom task
}

enum TaskPriority {
  LOW
  NORMAL
  HIGH
  URGENT
  CRITICAL
}

enum TaskStatus {
  PENDING // Pending execution
  ASSIGNED // Assigned to user
  IN_PROGRESS // In progress
  COMPLETED // Completed
  CANCELLED // Cancelled
  ON_HOLD // On hold
  FAILED // Failed
}

enum RouteType {
  STANDARD // Standard picking route
  EXPRESS // Express route
  ZONE // Zone-specific route
  BATCH // Batch picking route
  CUSTOM // Custom route
}

enum OptimizationMethod {
  SHORTEST_PATH // Shortest path algorithm
  NEAREST_NEIGHBOR // Nearest neighbor
  GENETIC_ALGORITHM // Genetic algorithm
  SIMULATED_ANNEALING // Simulated annealing
  MANUAL // Manually defined
}

enum RouteStatus {
  PLANNED // Route planned
  ASSIGNED // Assigned to picker
  IN_PROGRESS // In progress
  COMPLETED // Completed
  CANCELLED // Cancelled
}

enum TriggerEvent {
  LOW_STOCK // Low stock trigger
  OUT_OF_STOCK // Out of stock
  ORDER_CREATED // New order created
  ORDER_RELEASED // Order released
  SHIPMENT_DUE // Shipment due soon
  WAVE_RELEASED // Wave released
  LOCATION_FULL // Location full
  LOCATION_EMPTY // Location empty
  SCHEDULE // Scheduled trigger
  MANUAL // Manual trigger
  CUSTOM // Custom event
}

enum AssignmentRule {
  ROUND_ROBIN // Round robin assignment
  LEAST_BUSY // Assign to least busy user
  SKILL_BASED // Skill-based assignment
  ZONE_BASED // Zone-based assignment
  RANDOM // Random assignment
  MANUAL // Manual assignment
}

// ==========================================
// LABOR MANAGEMENT
// ==========================================

model Employee {
  id             String   @id @default(cuid())
  organizationId String
  userId         String?  @unique // Link to User if applicable
  employeeNumber String
  
  // Personal Information
  firstName      String
  lastName       String
  email          String?
  phone          String?
  dateOfBirth    DateTime?
  hireDate       DateTime
  terminationDate DateTime?
  
  // Employment Details
  status         EmployeeStatus @default(ACTIVE)
  employmentType EmploymentType @default(FULL_TIME)
  department     String?
  position       String?
  hourlyRate     Decimal?       @db.Decimal(10, 2)
  
  // Warehouse Assignment
  warehouseId    String?
  defaultZoneId  String?
  
  // Skills & Certifications
  skills         Json? // Array of skill codes
  certifications Json? // Array of certification details
  
  // Preferences
  preferredShiftType ShiftType?
  maxHoursPerWeek    Float?     @default(40)
  
  // Metadata
  notes      String?  @db.Text
  metadata   Json?
  isActive   Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  createdById String?
  securityPersonnel SecurityPersonnel?
  
  // Relations
  organization    Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user            User?                @relation(fields: [userId], references: [id])
  shiftAssignments ShiftAssignment[]
  timeEntries     TimeEntry[]
  productivity    ProductivityRecord[]
  tasks           PickingTask[]        @relation("TaskAssignee")
  
  @@unique([organizationId, employeeNumber])
  @@index([organizationId])
  @@index([userId])
  @@index([status])
  @@index([warehouseId])
  @@map("employees")
}

model Shift {
  id             String    @id @default(cuid())
  organizationId String
  shiftCode      String
  shiftName      String
  
  // Shift Details
  shiftType      ShiftType
  warehouseId    String?
  
  // Time
  startTime      String // HH:MM format
  endTime        String // HH:MM format
  duration       Float  // Hours
  breakDuration  Float? @default(0) // Hours
  
  // Days of Week (JSON array: [1,2,3,4,5] for Mon-Fri)
  daysOfWeek     Json
  
  // Capacity
  maxEmployees   Int?
  minEmployees   Int?
  
  // Pay & Rules
  overtimeAfter  Float? @default(8) // Hours
  payMultiplier  Float  @default(1.0)
  
  // Status
  isActive       Boolean  @default(true)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  
  // Metadata
  notes          String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assignments      ShiftAssignment[]
  
  @@unique([organizationId, shiftCode])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([shiftType])
  @@index([effectiveFrom, effectiveTo])
  @@map("shifts")
}

model ShiftAssignment {
  id          String            @id @default(cuid())
  organizationId String
  employeeId  String
  shiftId     String
  
  // Schedule
  assignedDate DateTime // Date of the shift
  status       ShiftAssignmentStatus @default(SCHEDULED)
  
  // Time Tracking
  checkInTime  DateTime?
  checkOutTime DateTime?
  actualHours  Float?
  overtimeHours Float?
  
  // Performance
  tasksCompleted Int?
  linesProcessed Int?
  accuracy       Float? // Percentage
  
  // Approval
  approvedBy   String?
  approvedAt   DateTime?
  
  // Metadata
  notes        String? @db.Text
  metadata     Json?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  
  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id])
  shift        Shift        @relation(fields: [shiftId], references: [id])
  
  @@unique([employeeId, shiftId, assignedDate])
  @@index([organizationId])
  @@index([employeeId])
  @@index([shiftId])
  @@index([assignedDate])
  @@index([status])
  @@map("shift_assignments")
}

model TimeEntry {
  id             String        @id @default(cuid())
  organizationId String
  employeeId     String
  
  // Time
  startTime      DateTime
  endTime        DateTime?
  duration       Float? // Calculated hours
  breakDuration  Float? @default(0)
  
  // Type & Category
  entryType      TimeEntryType
  category       String? // "REGULAR", "OVERTIME", "HOLIDAY", "SICK", etc.
  
  // Work Details
  warehouseId    String?
  zoneId         String?
  taskType       String? // "PICKING", "PACKING", "RECEIVING", etc.
  
  // Approval
  status         TimeEntryStatus @default(PENDING)
  approvedBy     String?
  approvedAt     DateTime?
  
  // Payroll
  hourlyRate     Decimal? @db.Decimal(10, 2)
  payMultiplier  Float?   @default(1.0)
  totalPay       Decimal? @db.Decimal(10, 2)
  
  // Metadata
  notes          String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id])
  
  @@index([organizationId])
  @@index([employeeId])
  @@index([startTime])
  @@index([status])
  @@index([entryType])
  @@map("time_entries")
}

model ProductivityRecord {
  id             String   @id @default(cuid())
  organizationId String
  employeeId     String
  
  // Period
  recordDate     DateTime
  shiftId        String?
  
  // Productivity Metrics
  tasksAssigned  Int      @default(0)
  tasksCompleted Int      @default(0)
  linesProcessed Int      @default(0)
  unitsPicked    Int      @default(0)
  unitsPacked    Int      @default(0)
  
  // Quality Metrics
  accuracy       Float?   // Percentage
  errorRate      Float?   // Percentage
  shortPicks     Int      @default(0)
  damagedUnits   Int      @default(0)
  
  // Efficiency
  hoursWorked    Float?
  unitsPerHour   Float?   // Calculated
  linesPerHour   Float?   // Calculated
  utilization    Float?   // Percentage
  
  // Performance Score
  performanceScore Float? // 0-100
  ranking         Int? // Rank among peers
  
  // Metadata
  notes      String?  @db.Text
  metadata   Json?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
  
  // Relations
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  employee     Employee     @relation(fields: [employeeId], references: [id])
  
  @@unique([employeeId, recordDate])
  @@index([organizationId])
  @@index([employeeId])
  @@index([recordDate])
  @@index([performanceScore])
  @@map("productivity_records")
}

// ==========================================
// SLOTTING OPTIMIZATION
// ==========================================

model SlottingRule {
  id             String   @id @default(cuid())
  organizationId String
  warehouseId    String?
  
  // Rule Details
  ruleName       String
  ruleCode       String
  priority       Int      @default(100)
  
  // Criteria
  criteria       Json // {velocity: "HIGH", category: "ABC", weight: <10}
  
  // Target Location Criteria
  targetZoneType String?
  targetLevel    String? // "FLOOR", "GROUND", "HIGH"
  maxDistance    Float? // From shipping area (meters)
  
  // Strategy
  strategy       SlottingStrategy
  
  // Thresholds
  minPickFrequency Int? // Picks per month
  maxPickFrequency Int?
  minVelocity      Float? // Revenue/month
  maxVelocity      Float?
  
  // Status
  isActive       Boolean  @default(true)
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  
  // Metadata
  description    String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  
  // Relations
  organization      Organization               @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  recommendations   SlottingRecommendation[]
  
  @@unique([organizationId, ruleCode])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([priority])
  @@index([isActive])
  @@map("slotting_rules")
}

model SlottingRecommendation {
  id             String   @id @default(cuid())
  organizationId String
  ruleId         String?
  
  // Item & Location
  itemId         String
  currentLocationId String?
  recommendedLocationId String
  
  // Analysis
  currentPickFrequency  Int?
  currentTravelDistance Float? // meters
  projectedPickFrequency Int?
  projectedTravelDistance Float?
  
  // Benefits
  estimatedTimeSaving Float? // hours/month
  estimatedCostSaving Decimal? @db.Decimal(10, 2)
  priorityScore       Float?
  
  // Status
  status         RecommendationStatus @default(PENDING)
  reason         String? @db.Text
  
  // Approval
  approvedBy     String?
  approvedAt     DateTime?
  implementedAt  DateTime?
  
  // Metadata
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rule           SlottingRule? @relation(fields: [ruleId], references: [id])
  item           InventoryItem @relation(fields: [itemId], references: [id])
  
  @@index([organizationId])
  @@index([ruleId])
  @@index([itemId])
  @@index([status])
  @@index([priorityScore])
  @@map("slotting_recommendations")
}

// ==========================================
// LOAD & ROUTE OPTIMIZATION
// ==========================================

model LoadPlan {
  id             String   @id @default(cuid())
  organizationId String
  planNumber     String
  
  // Plan Details
  planName       String
  shipmentDate   DateTime
  warehouseId    String?
  
  // Vehicle/Container
  vehicleType    String?
  maxWeight      Float? // kg
  maxVolume      Float? // cubic meters
  maxPallets     Int?
  
  // Optimization
  optimizationGoal LoadOptimizationGoal @default(MAXIMIZE_UTILIZATION)
  algorithm        String? // Algorithm used
  
  // Results
  totalWeight    Float?
  totalVolume    Float?
  totalPallets   Int?
  utilization    Float? // Percentage
  
  // Cost
  estimatedCost  Decimal? @db.Decimal(10, 2)
  actualCost     Decimal? @db.Decimal(10, 2)
  
  // Status
  status         LoadPlanStatus @default(DRAFT)
  
  // Approval
  approvedBy     String?
  approvedAt     DateTime?
  
  // Execution
  loadedBy       String?
  loadedAt       DateTime?
  
  // Metadata
  notes          String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  
  // Relations
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  items          LoadPlanItem[]
  routes         DeliveryRoute[]
  
  @@unique([organizationId, planNumber])
  @@index([organizationId])
  @@index([shipmentDate])
  @@index([status])
  @@index([warehouseId])
  @@map("load_plans")
}

model LoadPlanItem {
  id             String   @id @default(cuid())
  loadPlanId     String
  
  // Item Reference
  salesOrderId   String?
  shipmentId     String?
  packId         String?
  
  // Item Details
  itemSKU        String
  itemName       String
  quantity       Int
  
  // Dimensions
  weight         Float // kg
  volume         Float? // cubic meters
  length         Float? // cm
  width          Float? // cm
  height         Float? // cm
  
  // Loading Info
  palletNumber   Int?
  loadSequence   Int?
  stackPosition  Int?
  
  // Special Requirements
  isFragile      Boolean @default(false)
  requiresCooling Boolean @default(false)
  stackLimit     Int?
  
  // Status
  isLoaded       Boolean @default(false)
  loadedAt       DateTime?
  
  // Metadata
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  loadPlan       LoadPlan      @relation(fields: [loadPlanId], references: [id], onDelete: Cascade)
  salesOrder     SalesOrder?   @relation(fields: [salesOrderId], references: [id])
  shipment       Shipment?     @relation(fields: [shipmentId], references: [id])
  
  @@index([loadPlanId])
  @@index([salesOrderId])
  @@index([shipmentId])
  @@index([palletNumber])
  @@map("load_plan_items")
}

model DeliveryRoute {
  id             String   @id @default(cuid())
  organizationId String
  routeNumber    String
  loadPlanId     String?
  
  // Route Details
  routeName      String
  deliveryDate   DateTime
  warehouseId    String?
  
  // Vehicle & Driver
  vehicleId      String?
  driverName     String?
  driverPhone    String?
  
  // Route Optimization
  optimizationMethod OptimizationMethod @default(SHORTEST_PATH)
  totalDistance  Float? // km
  estimatedDuration Float? // hours
  
  // Status
  status         DeliveryRouteStatus @default(PLANNED)
  
  // Execution
  startTime      DateTime?
  endTime        DateTime?
  actualDistance Float?
  actualDuration Float?
  
  // Cost
  estimatedCost  Decimal? @db.Decimal(10, 2)
  actualCost     Decimal? @db.Decimal(10, 2)
  fuelCost       Decimal? @db.Decimal(10, 2)
  
  // Metadata
  notes          String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  
  // Relations
  organization   Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  loadPlan       LoadPlan?          @relation(fields: [loadPlanId], references: [id])
  stops          DeliveryStop[]
  
  @@unique([organizationId, routeNumber])
  @@index([organizationId])
  @@index([loadPlanId])
  @@index([deliveryDate])
  @@index([status])
  @@index([warehouseId])
  @@map("delivery_routes")
}

model DeliveryStop {
  id             String   @id @default(cuid())
  routeId        String
  
  // Stop Details
  stopSequence   Int
  stopType       StopType @default(DELIVERY)
  
  // Customer/Location
  customerName   String?
  contactPerson  String?
  contactPhone   String?
  addressLine1   String
  addressLine2   String?
  city           String
  state          String?
  postalCode     String
  country        String   @default("US")
  
  // Geographic
  latitude       Float?
  longitude      Float?
  
  // Timing
  scheduledArrival DateTime?
  scheduledDeparture DateTime?
  actualArrival    DateTime?
  actualDeparture  DateTime?
  serviceTime      Float? // minutes
  
  // Orders
  salesOrderIds  Json? // Array of sales order IDs
  
  // Delivery
  deliveryStatus StopDeliveryStatus @default(PENDING)
  signedBy       String?
  signedAt       DateTime?
  signatureImage String? // URL to signature
  proofOfDelivery String? // URL to photo
  
  // Special Instructions
  instructions   String?  @db.Text
  specialRequirements Json?
  
  // Distance from previous stop
  distanceFromPrevious Float? // km
  travelTime           Float? // minutes
  
  // Metadata
  notes          String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  route          DeliveryRoute @relation(fields: [routeId], references: [id], onDelete: Cascade)
  
  @@index([routeId])
  @@index([stopSequence])
  @@index([deliveryStatus])
  @@map("delivery_stops")
}

// ==========================================
// 3PL & MULTI-TENANT BILLING
// ==========================================

model Client {
  id             String   @id @default(cuid())
  organizationId String // 3PL organization
  clientCode     String
  
  // Client Information
  clientName     String
  legalName      String?
  taxId          String?
  
  // Contact
  primaryContact String?
  email          String?
  phone          String?
  website        String?
  
  // Address
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?
  
  // Status
  status         ClientStatus @default(ACTIVE)
  onboardingDate DateTime
  contractStart  DateTime?
  contractEnd    DateTime?
  
  // Billing Configuration
  billingCycle   BillingCycle @default(MONTHLY)
  currency       String       @default("USD")
  paymentTerms   Int          @default(30) // Days
  
  // Service Level Agreement
  slaTarget      Float? // percentage
  
  // Metadata
  notes          String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  
  // Relations
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  rateCards      BillingRateCard[]
  invoices       ClientInvoice[]
  transactions   BillingTransaction[]
  
  @@unique([organizationId, clientCode])
  @@index([organizationId])
  @@index([status])
  @@map("clients")
}

model BillingRateCard {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  
  // Rate Card Details
  rateCardName   String
  rateCardCode   String
  
  // Validity
  effectiveFrom  DateTime
  effectiveTo    DateTime?
  isActive       Boolean  @default(true)
  
  // Rates (JSON structure)
  storageRates   Json? // {unit: "PALLET", rate: 10.00, frequency: "MONTHLY"}
  handlingRates  Json? // {inbound: {unit: "PALLET", rate: 5.00}, outbound: {...}}
  orderRates     Json? // {base: 2.50, perLine: 0.50, perUnit: 0.10}
  valueAddedServices Json? // Array of VAS with rates
  
  // Minimum Charges
  minimumMonthly Decimal? @db.Decimal(10, 2)
  minimumTransaction Decimal? @db.Decimal(10, 2)
  
  // Metadata
  notes          String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  
  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client       @relation(fields: [clientId], references: [id])
  
  @@unique([organizationId, rateCardCode])
  @@index([organizationId])
  @@index([clientId])
  @@index([effectiveFrom, effectiveTo])
  @@index([isActive])
  @@map("billing_rate_cards")
}

model BillingTransaction {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  
  // Transaction Details
  transactionNumber String
  transactionDate DateTime
  transactionType BillingTransactionType
  
  // Service Details
  serviceCode    String
  serviceName    String
  description    String? @db.Text
  
  // Quantity & Units
  quantity       Float
  unit           String // "PALLET", "ORDER", "LINE", "UNIT", "HOUR"
  
  // Pricing
  unitRate       Decimal  @db.Decimal(10, 4)
  amount         Decimal  @db.Decimal(10, 2)
  
  // References
  referenceType  String? // "SALES_ORDER", "GRN", "SHIPMENT", etc.
  referenceId    String?
  referenceNumber String?
  
  // Period
  periodStart    DateTime?
  periodEnd      DateTime?
  
  // Billing
  invoiceId      String?
  billingStatus  BillingStatus @default(PENDING)
  
  // Metadata
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client         @relation(fields: [clientId], references: [id])
  invoice        ClientInvoice? @relation(fields: [invoiceId], references: [id])
  
  @@unique([organizationId, transactionNumber])
  @@index([organizationId])
  @@index([clientId])
  @@index([invoiceId])
  @@index([transactionDate])
  @@index([billingStatus])
  @@map("billing_transactions")
}

model ClientInvoice {
  id             String   @id @default(cuid())
  organizationId String
  clientId       String
  
  // Invoice Details
  invoiceNumber  String
  invoiceDate    DateTime
  dueDate        DateTime
  
  // Period
  periodStart    DateTime
  periodEnd      DateTime
  
  // Amounts
  subtotal       Decimal  @db.Decimal(10, 2)
  taxAmount      Decimal  @db.Decimal(10, 2) @default(0)
  discountAmount Decimal  @db.Decimal(10, 2) @default(0)
  total          Decimal  @db.Decimal(10, 2)
  paidAmount     Decimal  @db.Decimal(10, 2) @default(0)
  balanceDue     Decimal  @db.Decimal(10, 2)
  
  // Status
  status         InvoiceStatus @default(DRAFT)
  
  // Payment
  paymentMethod  String?
  paymentDate    DateTime?
  paymentRef     String?
  
  // Documents
  invoicePDF     String? // URL to PDF
  
  // Metadata
  notes          String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  
  // Relations
  organization   Organization         @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  client         Client               @relation(fields: [clientId], references: [id])
  transactions   BillingTransaction[]
  
  @@unique([organizationId, invoiceNumber])
  @@index([organizationId])
  @@index([clientId])
  @@index([invoiceDate])
  @@index([dueDate])
  @@index([status])
  @@map("client_invoices")
}

// ==========================================
// YARD MANAGEMENT
// ==========================================

model YardLocation {
  id             String   @id @default(cuid())
  organizationId String
  warehouseId    String?
  
  // Location Details
  locationCode   String
  locationName   String
  locationType   YardLocationType
  
  // Physical Details
  capacity       Int? // Number of trailers/containers
  length         Float? // meters
  width          Float? // meters
  
  // Status
