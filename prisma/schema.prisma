}

enum ChartType {
  BAR             // Bar chart
  LINE            // Line chart
  PIE             // Pie chart
  DONUT           // Donut chart
  AREA            // Area chart
  SCATTER         // Scatter plot
  GAUGE           // Gauge/meter
  FUNNEL          // Funnel chart
  HEATMAP         // Heat map
  TABLE           // Data table
}

enum ScheduleType {
