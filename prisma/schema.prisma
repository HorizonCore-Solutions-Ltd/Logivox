  isOccupied     Boolean  @default(false)
  
  // Metadata
  notes          String?  @db.Text
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  appointments   DockAppointment[]
  
  @@unique([organizationId, locationCode])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([locationType])
  @@index([isActive, isOccupied])
  @@map("yard_locations")
}

model DockAppointment {
  id             String   @id @default(cuid())
  organizationId String
  appointmentNumber String
  
  // Appointment Details
  appointmentType DockAppointmentType
  warehouseId    String?
  yardLocationId String?
  
  // Scheduling
  scheduledDate  DateTime
  scheduledStart DateTime
  scheduledEnd   DateTime
  duration       Float // hours
  
  // Actual Times
  actualArrival  DateTime?
  actualStart    DateTime?
  actualEnd      DateTime?
  actualDuration Float?
  
  // Carrier & Vehicle
  carrierName    String?
  driverName     String?
  driverPhone    String?
  vehicleNumber  String?
  trailerNumber  String?
  sealNumber     String?
  
  // References
  referenceType  String? // "PURCHASE_ORDER", "SALES_ORDER", "TRANSFER"
  referenceId    String?
  referenceNumber String?
  
  // Capacity
  expectedPallets Int?
  actualPallets   Int?
  expectedWeight  Float?
  actualWeight    Float?
  
  // Status
  status         AppointmentStatus @default(SCHEDULED)
  
  // Check-in/out
  checkedInBy    String?
  checkedInAt    DateTime?
  checkedOutBy   String?
  checkedOutAt   DateTime?
  
  // Approval
  approvedBy     String?
  approvedAt     DateTime?
  
  // Relations
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  yardLocation   YardLocation? @relation(fields: [yardLocationId], references: [id])
  gateEntries    GateEntry[]

  @@unique([organizationId, appointmentNumber])
  @@index([organizationId])
  @@index([yardLocationId])
  @@index([scheduledDate])
  @@index([status])
  @@index([carrierName])
  @@map("dock_appointments")
}

// ==========================================
// IOT & DEVICE INTEGRATION
// ==========================================

model IoTDevice {
  id             String   @id @default(cuid())
  organizationId String
  deviceId       String @unique
  
  // Device Details
  deviceName     String
  deviceType     IoTDeviceType
  manufacturer   String?
  modelNumber    String?
  serialNumber   String?
  
  // Location
  warehouseId    String?
  locationId     String?
  zoneId         String?
  
  // Status
  status         DeviceStatus @default(OFFLINE)
  isActive       Boolean      @default(true)
  
  // Connectivity
  ipAddress      String?
  macAddress     String?
  firmwareVersion String?
  lastHeartbeat  DateTime?
  
  // Configuration
  configuration  Json? // Device-specific settings
  thresholds     Json? // Alert thresholds
  
  // Battery (for mobile devices)
  batteryLevel   Float?
  isCharging     Boolean?
  
  // Metadata
  notes          String?  @db.Text
  metadata       Json?
  installedAt    DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  createdById    String?
  
  // Relations
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  readings       IoTSensorReading[]
  alerts         IoTAlert[]
  
  @@index([organizationId])
  @@index([deviceType])
  @@index([status])
  @@index([warehouseId])
  @@map("iot_devices")
}

model IoTSensorReading {
  id             String   @id @default(cuid())
  deviceId       String
  
  // Reading Details
  readingType    String // "TEMPERATURE", "HUMIDITY", "LOCATION", "WEIGHT", etc.
  readingValue   Float
  unit           String // "C", "%", "kg", etc.
  
  // Timestamp
  timestamp      DateTime @default(now())
  
  // Context
  warehouseId    String?
  locationId     String?
  inventoryId    String?
  
  // Metadata
  metadata       Json?
  
  // Relations
  device         IoTDevice @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  
  @@index([deviceId])
  @@index([timestamp])
  @@index([readingType])
  @@map("iot_sensor_readings")
}

model IoTAlert {
  id             String   @id @default(cuid())
  organizationId String
  deviceId       String
  
  // Alert Details
  alertType      IoTAlertType
  severity       AlertSeverity
  message        String       @db.Text
  
  // Context
  readingType    String?
  readingValue   Float?
  thresholdValue Float?
  
  // Status
  status         AlertStatus @default(PENDING)
  acknowledgedBy String?
  acknowledgedAt DateTime?
  resolvedBy     String?
  resolvedAt     DateTime?
  
  // Metadata
  metadata       Json?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  
  // Relations
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  device         IoTDevice    @relation(fields: [deviceId], references: [id], onDelete: Cascade)
  
  @@index([organizationId])
  @@index([deviceId])
  @@index([status])
  @@index([severity])
  @@index([createdAt])
  @@map("iot_alerts")
}

