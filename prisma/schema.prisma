  IDLE
  WORKING
  CHARGING
  ERROR
  MAINTENANCE
  OFFLINE
}

enum RobotTaskType {
  MOVE_PALLET
  MOVE_TOTE
  DELIVER_PICK
  REPLENISHMENT
  CYCLE_COUNT
  SORTATION
  DISPOSAL
  CUSTOM
}

enum RobotTaskStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  FAILED
  CANCELLED
}

enum VASStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
  ON_HOLD
}

enum ChargebackReason {
  LATE_DELIVERY
  DAMAGED_GOODS
  INCORRECT_QUANTITY
  WRONG_ITEM
  PACKAGING_VIOLATION
  LABELING_ERROR
  DOCUMENT_MISSING
  QC_FAILURE
  OTHER
}

enum ChargebackStatus {
  DRAFT
  ISSUED
  ACCEPTED
  DISPUTED
  RESOLVED
  CANCELLED
}

// ─────────────────────────────────────────────────────────────────────────────
// COGNITIVE ORCHESTRATION & AUTONOMOUS DECISION ENGINE
// ─────────────────────────────────────────────────────────────────────────────

enum CognitiveGoalType {
  MINIMIZE_COST
  MAXIMIZE_SPEED
  MINIMIZE_CARBON
  MAXIMIZE_ACCURACY
  BALANCE_ALL
}

enum DecisionStatus {
  EVALUATING
  PROPOSED
  EXECUTED
  FAILED
  OVERRIDDEN
}

enum ActionCategory {
  LABOR_ALLOCATION
  INVENTORY_ROUTING
  CARRIER_SELECTION
  WAVE_MANAGEMENT
  BILLING_ADJUSTMENT
}

model CognitivePolicy {
  id             String            @id @default(cuid())
  organizationId String
  name           String
  description    String?
  goalType       CognitiveGoalType @default(BALANCE_ALL)
  priority       Int               @default(1) // 1 = High, 10 = Low
  isActive       Boolean           @default(true)
  constraints    Json? // e.g., { "maxCost": 50, "minSLA": 98 }
  learningRate   Float             @default(0.1) // For RL models
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt
  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  decisionLogs   DecisionLog[]

  @@index([organizationId])
  @@index([isActive])
  @@map("cognitive_policies")
}

model DecisionLog {
  id              String           @id @default(cuid())
  organizationId  String
  policyId        String?
  scenarioId      String? // Link to a simulation if applicable
  timestamp       DateTime         @default(now())
  triggerEvent    String // e.g., "CongestionDetected", "SLA_Breach_Predicted"
  category        ActionCategory
  description     String
  aiReasoning     String // Explanation of why this decision was made
  confidenceScore Float
  status          DecisionStatus
  actionTaken     Json? // Details of the server action executed
  outcomeMetric   Json? // The literal result (time saved, cost incurred)
  userOverrideId  String? // If a human stopped it
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  policy          CognitivePolicy? @relation(fields: [policyId], references: [id])

  @@index([organizationId])
  @@index([timestamp])
  @@index([category])
  @@map("decision_logs")
}

// ─────────────────────────────────────────────────────────────────────────────
// COGNITIVE ORCHESTRATION & MULTI-ECHELON TRANSFER MODULE
// ─────────────────────────────────────────────────────────────────────────────

model TransferRequest {
  id                   String  @id @default(cuid())
  transferNumber       String  @unique
  sourceOrganizationId String
  targetOrganizationId String
  sourceWarehouseId    String?
  targetWarehouseId    String?

  status TransferRequestStatus @default(DRAFT)
  type   TransferType          @default(INTERNAL) // INTERNAL, INTER_ORG, RECALL, RECTIFICATION

  requestedById String
  approvedById  String?
  shippedById   String?
  receivedById  String?

  requestedAt DateTime  @default(now())
  approvedAt  DateTime?
  shippedAt   DateTime?
  receivedAt  DateTime?

  shippingMethod String?
  trackingNumber String?

  // Financial clearing for Inter-Org
  invoiceId      String? // Generated Inter-Company Invoice
  clearingStatus ClearingStatus @default(PENDING) // PENDING, INVOICED, SETTLED

  items TransferRequestItem[]

  sourceOrganization Organization @relation("TransferSourceOrg", fields: [sourceOrganizationId], references: [id])
  targetOrganization Organization @relation("TransferTargetOrg", fields: [targetOrganizationId], references: [id])
  sourceWarehouse    Warehouse?   @relation("TransferSourceWh", fields: [sourceWarehouseId], references: [id])
  targetWarehouse    Warehouse?   @relation("TransferTargetWh", fields: [targetWarehouseId], references: [id])

  requestedBy User @relation("TransferRequestor", fields: [requestedById], references: [id])

  @@index([sourceOrganizationId])
  @@index([targetOrganizationId])
  @@index([status])
  @@map("transfer_requests")
}

model TransferRequestItem {
  id                String @id @default(cuid())
  transferRequestId String
  sku               String
  productName       String
  quantityRequested Int
  quantityShipped   Int    @default(0)
  quantityReceived  Int    @default(0)

  unitCost Decimal? @db.Decimal(10, 2) // For valuation

  status TransferItemStatus @default(PENDING)

  transferRequest TransferRequest @relation(fields: [transferRequestId], references: [id], onDelete: Cascade)

  @@index([transferRequestId])
  @@index([sku])
  @@map("transfer_request_items")
}

enum TransferRequestStatus {
  DRAFT
  REQUESTED
  APPROVED
  IN_TRANSIT
  PARTIALLY_RECEIVED
  RECEIVED
  COMPLETED
  CANCELLED
}

enum TransferType {
  INTERNAL // Branch to Branch (Same Org)
  INTER_ORG // Cross-Entity
  RECALL // DC Recall from Branch
  RECTIFICATION // Virtual correction
}

enum ClearingStatus {
  PENDING
  INVOICED
  SETTLED
  NOT_APPLICABLE
}

enum TransferItemStatus {
  PENDING
  ALLOCATED
  SHIPPED
  RECEIVED
  SHORT
  DAMAGED
}

model Printer {
  id             String  @id @default(cuid())
  organizationId String
  name           String
  type           String  @default("LASER") // ZEBRA, LASER, PDF_DOWNLOAD
  ipAddress      String?
  port           Int?    @default(9100) // Standard HP JetDirect port
  location       String?
  description    String?
  isActive       Boolean @default(true)
  metadata       Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  users        User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("printers")
}

model Refund {
  id              String       @id @default(cuid())
  organizationId  String
  salesOrderId    String?
  rmaId           String?
  amount          Decimal      @db.Decimal(10, 2)
  reason          RefundReason
  reasonDetails   String?
  status          RefundStatus @default(PENDING)
  processedAt     DateTime?
  processedById   String?
  transactionId   String?
  currency        String       @default("USD")
  method          String? // Credit Card, Store Credit, Check
  metadata        Json?
  
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  salesOrder      SalesOrder?  @relation(fields: [salesOrderId], references: [id])
  rma             RMA?         @relation(fields: [rmaId], references: [id])
  processedBy     User?        @relation("RefundProcessor", fields: [processedById], references: [id])

  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt

  @@index([organizationId])
  @@index([salesOrderId])
  @@index([rmaId])
  @@index([status])
}

enum RefundReason {
  ITEM_NOT_ARRIVED
  DAMAGED_ITEM
  JOB_CANCELLED
  CUSTOMER_REQUEST
  OTHER
}

enum RefundStatus {
  PENDING
  PROCESSED
  FAILED
  REJECTED
}
