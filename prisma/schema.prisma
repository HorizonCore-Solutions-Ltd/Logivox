generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model User {
  id                           String                   @id @default(cuid())
  name                         String?
  email                        String                   @unique
  emailVerified                DateTime?
  image                        String?
  password                     String?
  role                         UserRole                 @default(USER)
  isActive                     Boolean                  @default(true)
  defaultPrinterId             String?
  defaultPrinter               Printer?                 @relation(fields: [defaultPrinterId], references: [id])
  createdAt                    DateTime                 @default(now())
  updatedAt                    DateTime                 @updatedAt
  acknowledgedAlerts           Alert[]                  @relation("AlertAcknowledger")
  resolvedAlerts               Alert[]                  @relation("AlertResolver")
  createdAlertRules            AlertRule[]              @relation("AlertRuleCreator")
  createdExternalIntegrations  ExternalIntegration[]    @relation("ExternalIntegrationCreator")
  createdConnections           IntegrationConnection[]  @relation("ConnectionCreator")
  integrationLogs              IntegrationLog[]         @relation("LogUser")
  createdMappings              IntegrationMapping[]     @relation("MappingCreator")
  triggeredSyncs               IntegrationSync[]        @relation("SyncTriggeredBy")
  createdWebhooks              IntegrationWebhook[]     @relation("WebhookCreator")
  createdNotifications         Notification[]           @relation("NotificationCreator")
  receivedNotifications        Notification[]           @relation("NotificationRecipient")
  notificationPreference       NotificationPreference?
  createdNotificationTemplates NotificationTemplate[]   @relation("NotificationTemplateCreator")
  assignedRoutes               PickingRoute[]           @relation("RouteAssignee")
  createdRoutes                PickingRoute[]           @relation("RouteCreator")
  assignedTasks                PickingTask[]            @relation("TaskAssignee")
  completedTasks               PickingTask[]            @relation("TaskCompleter")
  createdTasks                 PickingTask[]            @relation("TaskCreator")
  assignedAutomations          TaskAutomation[]         @relation("AutomationAssignee")
  createdAutomations           TaskAutomation[]         @relation("AutomationCreator")
  assignedWaves                WavePick[]               @relation("WaveAssignee")
  createdWaves                 WavePick[]               @relation("WaveCreator")
  createdWaveRules             WaveAutomationRule[]     @relation("WaveRuleCreator")
  assignedPickLines            WavePickLine[]           @relation("LinePickerAssignee")
  pickedLines                  WavePickLine[]           @relation("LinePicker")
  verifiedLines                WavePickLine[]           @relation("LineVerifier")
  accounts                     Account[]
  activityLogs                 ActivityLog[]
  analyticsEvents              AnalyticsEvent[]         @relation("AnalyticsUser")
  issuedComponents             AssemblyComponentIssue[] @relation("ComponentIssuer")
  returnedComponents           AssemblyComponentIssue[] @relation("ComponentReturner")
  assignedAssemblyOrders       AssemblyOrder[]          @relation("AssemblyAssignee")
  createdAssemblyOrders        AssemblyOrder[]          @relation("AssemblyCreator")
  productionLogs               AssemblyProductionLog[]  @relation("ProductionOperator")
  approvedBOMs                 BillOfMaterials[]        @relation("BOMApprover")
  blogComments                 BlogComment[]
  createdBookings              Booking[]                @relation("BookingCreator")
  countedItems                 CycleCountItem[]         @relation("CountedItems")
  reconciledItems              CycleCountItem[]         @relation("ReconciledItems")
  approvedCycleCounts          CycleCount[]             @relation("ApprovedCycleCounts")
  assignedCycleCounts          CycleCount[]             @relation("AssignedCycleCounts")
  createdDashboards            Dashboard[]              @relation("DashboardCreator")
  employee                     Employee?
  qcGRNs                       GoodsReceiptNote[]       @relation("GRNQCBy")
  receivedGRNs                 GoodsReceiptNote[]       @relation("GRNReceivedBy")
  createdInventoryItems        InventoryItem[]          @relation("InventoryCreator")
  organizationMemberships      OrganizationMember[]
  processedRefunds             Refund[]                 @relation("RefundProcessor")
  createdOrganizations         Organization[]           @relation("OrganizationCreator")
  initiatedPacks               Pack[]                   @relation("PackInitiator")
  createdPacks                 Pack[]                   @relation("PackCreator")
  assignedPickLists            PickList[]               @relation("PickListAssignee")
  createdPickLists             PickList[]               @relation("PickListCreator")
  approvedPurchaseOrders       PurchaseOrder[]          @relation("POApprover")
  createdPurchaseOrders        PurchaseOrder[]          @relation("POCreator")
  qcApprovals                  QCApproval[]             @relation("QCApprover")
  performedCheckpoints         QCCheckpoint[]           @relation("CheckpointPerformer")
  inspectedQC                  QCInspection[]           @relation("QCInspector")
  qcReceivingInspections       QCReceivingInspection[]  @relation("QCReceivingInspector")
  executedReports              ReportExecution[]        @relation("ReportExecutor")
  createdReports               Report[]                 @relation("ReportCreator")
  restockedRMAItems            RMAItem[]                @relation("RMARestockedBy")
  approvedRMAs                 RMA[]                    @relation("RMAApprovedBy")
  inspectedRMAs                RMA[]                    @relation("RMAInspectedBy")
  approvedSalesOrders          SalesOrder[]             @relation("SOApprover")
  createdSalesOrders           SalesOrder[]             @relation("SOCreator")
  packedSalesOrders            SalesOrder[]             @relation("SOPacker")
  pickedSalesOrders            SalesOrder[]             @relation("SOPicker")
  sessions                     Session[]
  createdShipments             Shipment[]               @relation("ShipmentCreator")
  approvedAdjustments          StockAdjustment[]        @relation("AdjustmentApprovedBy")
  completedAdjustments         StockAdjustment[]        @relation("AdjustmentCompletedBy")
  createdAdjustments           StockAdjustment[]        @relation("AdjustmentCreatedBy")
  approvedTransfers            WarehouseTransfer[]      @relation("TransferApprovedBy")
  completedTransfers           WarehouseTransfer[]      @relation("TransferCompletedBy")
  requestedTransfers           WarehouseTransfer[]      @relation("TransferRequestedBy")
  assignedReplenishmentTasks   ReplenishmentTask[]      @relation("ReplenAssignedTo")
  assignedYardMoves            YardMove[]               @relation("YardMoveAssignee")
  voiceSessions                VoiceSession[]
  securityProfile              SecurityProfile?
  securityLogs                 SecurityLog[]
  assignedVasRequests          VASRequest[]

  requestedTransferRequests TransferRequest[] @relation("TransferRequestor")

  @@index([email])
  @@map("users")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
  @@map("verification_tokens")
}

model Organization {
  id                         String                       @id @default(cuid())
  name                       String
  slug                       String                       @unique
  domain                     String?                      @unique
  logo                       String?
  primaryColor               String?                      @default("#3B82F6")
  isActive                   Boolean                      @default(true)
  subscriptionTier           SubscriptionTier             @default(FREE)
  subscriptionStatus         String?                      @default("active")
  billingEmail               String?
  timezone                   String                       @default("UTC")
  currency                   String                       @default("USD")
  createdAt                  DateTime                     @default(now())
  updatedAt                  DateTime                     @updatedAt
  createdById                String
  securitySettings           Json?
  invoiceSettings            Json? // { trigger, termsNet, footerText, showPackingSlip, logoUrl }
  alerts                     Alert[]
  alertRules                 AlertRule[]
  externalIntegrations       ExternalIntegration[]
  integrationConnections     IntegrationConnection[]
  integrationLogs            IntegrationLog[]
  integrationMappings        IntegrationMapping[]
  integrationSyncs           IntegrationSync[]
  integrationWebhooks        IntegrationWebhook[]
  notifications              Notification[]
  notificationTemplates      NotificationTemplate[]
  pickingRoutes              PickingRoute[]
  pickingTasks               PickingTask[]
  taskAutomations            TaskAutomation[]
  taskExecutions             TaskExecution[]
  waves                      WavePick[]
  yardMoves                  YardMove[]
  waveAutomationRules        WaveAutomationRule[]
  waveAutomationExecutions   WaveAutomationExecution[]
  wavePickLines              WavePickLine[]
  accessControlZones         AccessControlZone[]
  activityLogs               ActivityLog[]
  qrReturns                  QRReturn[]
  analyticsEvents            AnalyticsEvent[]
  apiKeys                    ApiKey[]
  assemblyOrders             AssemblyOrder[]
  audits                     Audit[]
  autonomousConfig           AutonomousConfig?
  autonomousDecisions        AutonomousDecision[]
  cognitivePolicies          CognitivePolicy[]
  decisionLogs               DecisionLog[]
  rateCards                  BillingRateCard[]
  billingTransactions        BillingTransaction[]
  billsOfMaterials           BillOfMaterials[]
  bookings                   Booking[]
  cameraSystems              CameraSystem[]
  carrierConfigs             CarrierConfig[]
  categories                 Category[]
  clientInvoices             ClientInvoice[]
  invoices                   Invoice[]
  clients                    Client[]
  replenishmentRules         ReplenishmentRule[]
  replenishmentTasks         ReplenishmentTask[]
  replenishmentFeatureFlag   ReplenishmentFeatureFlag?
  replenishmentForecasts     ReplenishmentForecastCache[]
  replenishmentIoTTriggers   ReplenishmentIoTTrigger[]
  replenishmentWaveBinds     ReplenishmentWaveBind[]
  replenishmentRobotJobs     ReplenishmentRobotJob[]
  replenishmentCostLogs      ReplenishmentCostLog[]
  replenishmentSimRuns       ReplenishmentSimRun[]
  accessorialCodes           AccessorialChargeCode[]
  accessorialLines           AccessorialChargeLine[]
  customerContracts          CustomerContract[]
  exceptions                 ExceptionRecord[]
  cartonTypes                CartonType[]
  outboundASNs               OutboundASN[]
  capas                      CorrectivePreventiveAction[]
  crossBorderReturns         CrossBorderReturn[]
  customerReturnProfiles     CustomerReturnProfile[]
  customers                  Customer[]
  cycleCounts                CycleCount[]
  daily_activity_reports     daily_activity_reports[]
  dashboards                 Dashboard[]
  deliveryRoutes             DeliveryRoute[]
  dockAppointments           DockAppointment[]
  documents                  Document[]
  duties                     Duty[]
  dutyTypes                  DutyType[]
  printers                   Printer[]
  employees                  Employee[]
  equipment                  equipment[]
  fmeas                      FMEA[]
  gateDocuments              GateDocument[]
  gateEntries                GateEntry[]
  gatePhotos                 GatePhoto[]
  gateQueue                  GateQueue[]
  gateWeighBridges           GateWeighBridge[]
  gates                      Gate[]
  geofences                  geofences[]
  goodsReceiptNotes          GoodsReceiptNote[]
  guard_certifications       guard_certifications[]
  guard_locations            guard_locations[]
  hazmatRecords              HazmatRecord[]
  inspectionTemplates        InspectionTemplate[]
  instantRefunds             InstantRefund[]
  integrations               Integration[]
  inventoryItems             InventoryItem[]
  iotAlerts                  IoTAlert[]
  iotDevices                 IoTDevice[]
  kpiMetrics                 KPIMetric[]
  loadPlans                  LoadPlan[]
  locations                  Location[]
  lotGenealogies             LotGenealogy[]
  lotMovements               LotMovement[]
  lots                       Lot[]
  nonConformanceReports      NonConformanceReport[]
  members                    OrganizationMember[]
  createdBy                  User                         @relation("OrganizationCreator", fields: [createdById], references: [id])
  packs                      Pack[]
  panic_alerts               panic_alerts[]
  parkingSpots               ParkingSpot[]
  patrol_routes              patrol_routes[]
  pickLists                  PickList[]
  productReturnAnalyses      ProductReturnAnalysis[]
  productivityRecords        ProductivityRecord[]
  purchaseOrders             PurchaseOrder[]
  qcDefects                  QCDefect[]
  qcInspectionTemplates      QCInspectionTemplate[]
  qcInspections              QCInspection[]
  qcReceivingInspections     QCReceivingInspection[]
  qcSettings                 QCSettings?
  qr_returns                 qr_returns[]
  qualityHolds               QualityHold[]
  qualityMeasurements        QualityMeasurement[]
  qualityReports             QualityReport[]
  refurbTemplates            RefurbTemplate[]
  reorderAlerts              ReorderAlert[]
  reportExecutions           ReportExecution[]
  reports                    Report[]
  returnReasons              ReturnReason[]
  returnRiskPredictions      ReturnRiskPrediction[]
  returnSettings             ReturnSettings?
  returnsForecasts           ReturnsForecast[]
  riskRegister               RiskRegister[]
  rmas                       RMA[]
  refunds                    Refund[]
  rootCauseAnalyses          RootCauseAnalysis[]
  rtvRequests                RTVRequest[]
  rtvs                       RTV[]
  salesOrders                SalesOrder[]
  samplingPlans              SamplingPlan[]
  securityAccessLogs         SecurityAccessLog[]
  securityAlerts             SecurityAlert[]
  complianceReports          SecurityComplianceReport[]
  securityIncidents          SecurityIncident[]
  securityNotifications      SecurityNotification[]
  securityPersonnel          SecurityPersonnel[]
  securityShifts             SecurityShift[]
  serialMovements            SerialMovement[]
  serialNumbers              SerialNumber[]
  serialTracking             SerialTracking[]
  shiftAssignments           ShiftAssignment[]
  shift_handovers            shift_handovers[]
  shifts                     Shift[]
  shipments                  Shipment[]
  slottingRecommendations    SlottingRecommendation[]
  slottingRules              SlottingRule[]
  stockAdjustments           StockAdjustment[]
  supplierPerformanceReviews SupplierPerformanceReview[]
  suppliers                  Supplier[]
  sustainabilityReports      SustainabilityReport[]
  temperatureLogs            TemperatureLog[]
  timeAttendanceMappings     TimeAttendanceMapping[]
  timeEntries                TimeEntry[]
  training_courses           training_courses[]
  vehicleBlacklist           VehicleBlacklist[]
  vehicleWhitelist           VehicleWhitelist[]
  vendorChargebacks          VendorChargeback[]
  complianceChecks           VendorComplianceCheck[]
  vendorConcessions          VendorConcession[]
  vendorDebitMemos           VendorDebitMemo[]
  vendorQualityScores        VendorQualityScore[]
  vendorReturnPolicies       VendorReturnPolicy[]
  visitorPreRegistrations    VisitorPreRegistration[]
  visitors                   Visitor[]
  warehouseTransfers         WarehouseTransfer[]
  warehouses                 Warehouse[]
  weather_logs               weather_logs[]
  yardLocations              YardLocation[]
  fleetVehicleTypes          FleetVehicleType[]
  IoTSensorEvent             IoTSensorEvent[]
  bayDoors                   BayDoor[]
  loadSheets                 LoadSheet[]
  vasRequests                VASRequest[]
  chargebacks                SupplierChargeback[]

  // Inter-Org Transfers
  transfersAsSource TransferRequest[] @relation("TransferSourceOrg")
  transfersAsTarget TransferRequest[] @relation("TransferTargetOrg")

  @@index([slug])
  @@index([createdById])
  @@map("organizations")
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  userId         String
  role           OrganizationRole @default(MEMBER)
  permissions    Json?
  isActive       Boolean          @default(true)
  joinedAt       DateTime         @default(now())
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  user           User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model Warehouse {
  id                     String                  @id @default(cuid())
  organizationId         String
  name                   String
  code                   String
  address                String?
  city                   String?
  country                String?
  isActive               Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  pickingRoutes          PickingRoute[]
  pickingTasks           PickingTask[]
  waves                  WavePick[]
  waveAutomationRules    WaveAutomationRule[]
  assemblyOrders         AssemblyOrder[]
  grns                   GoodsReceiptNote[]
  inventoryItems         InventoryItem[]
  packs                  Pack[]
  pickLists              PickList[]
  qcReceivingInspections QCReceivingInspection[]
  rtvs                   RTV[]
  salesOrders            SalesOrder[]
  organization           Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  replenishmentRules     ReplenishmentRule[]     @relation("ReplenRuleWarehouse")
  replenishmentTasks     ReplenishmentTask[]     @relation("ReplenTaskWarehouse")
  iotSensorEvents        IoTSensorEvent[]        @relation("WarehouseIoT")
  bayDoors               BayDoor[]
  loadSheets             LoadSheet[]

  // Transfers
  transfersAsSource TransferRequest[] @relation("TransferSourceWh")
  transfersAsTarget TransferRequest[] @relation("TransferTargetWh")

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("warehouses")
}

model Category {
  id             String          @id @default(cuid())
  organizationId String
  name           String
  slug           String
  description    String?
  parentId       String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  parent         Category?       @relation("CategoryHierarchy", fields: [parentId], references: [id])
  children       Category[]      @relation("CategoryHierarchy")
  cycleCounts    CycleCount[]
  inventoryItems InventoryItem[]

  @@unique([organizationId, slug])
  @@index([organizationId])
  @@index([parentId])
  @@map("categories")
}

model InventoryItem {
  id                      String                       @id @default(cuid())
  organizationId          String
  warehouseId             String
  categoryId              String?
  supplierId              String?
  sku                     String
  name                    String
  description             String?
  barcode                 String?
  quantity                Int                          @default(0)
  reservedQty             Int                          @default(0)
  availableQty            Int                          @default(0)
  minStockLevel           Int                          @default(0)
  maxStockLevel           Int?
  reorderPoint            Int?
  reorderQuantity         Int?                         @default(0)
  leadTimeDays            Int?                         @default(7)
  lastReorderDate         DateTime?
  autoReorder             Boolean                      @default(false)
  costPrice               Decimal?                     @db.Decimal(10, 2)
  sellingPrice            Decimal?                     @db.Decimal(10, 2)
  currency                String                       @default("USD")
  status                  InventoryStatus              @default(ACTIVE)
  isActive                Boolean                      @default(true)
  metadata                Json?
  createdAt               DateTime                     @default(now())
  updatedAt               DateTime                     @updatedAt
  createdById             String
  PickingTask             PickingTask[]
  WavePickLine            WavePickLine[]
  assemblyComponents      AssemblyComponentIssue[]     @relation("AssemblyComponent")
  assemblyOrdersAsProduct AssemblyOrder[]              @relation("AssemblyProduct")
  autonomousDecisions     AutonomousDecision[]
  bomsAsProduct           BillOfMaterials[]            @relation("BOMProduct")
  bomComponents           BOMComponent[]               @relation("BOMComponent")
  bookingItems            BookingItem[]
  cycleCountItems         CycleCountItem[]
  demandForecasts         DemandForecast[]
  digitalTwinStates       DigitalTwinState[]
  grnItems                GRNItem[]
  category                Category?                    @relation(fields: [categoryId], references: [id])
  createdBy               User                         @relation("InventoryCreator", fields: [createdById], references: [id])
  organization            Organization                 @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplier                Supplier?                    @relation(fields: [supplierId], references: [id])
  warehouse               Warehouse                    @relation(fields: [warehouseId], references: [id])
  locationId              String?
  location                Location?                    @relation(fields: [locationId], references: [id])
  movements               InventoryMovement[]
  lots                    Lot[]
  packageItems            PackageItem[]
  pickListItems           PickListItem[]
  purchaseOrderItems      PurchaseOrderItem[]          @relation("POInventoryItem")
  qcInspectionItems       QCInspectionItem[]           @relation("QCInspectionItemProduct")
  qcInspections           QCInspection[]
  refurbWorkOrders        RefurbWorkOrder[]            @relation("RefurbWorkOrderProduct")
  reorderAlerts           ReorderAlert[]
  rmaExchangeItems        RMAItem[]                    @relation("RMAExchangeItem")
  rmaItems                RMAItem[]                    @relation("RMAInventoryItem")
  salesOrderItems         SalesOrderItem[]
  serialNumbers           SerialNumber[]
  slottingRecommendations SlottingRecommendation[]
  stockAdjustments        StockAdjustment[]
  velocityClassification  VelocityClassification?
  warehouseTransfers      WarehouseTransfer[]
  replenishmentRules      ReplenishmentRule[]          @relation("ReplenRuleItem")
  replenishmentTasks      ReplenishmentTask[]          @relation("ReplenTaskItem")
  replenishmentForecasts  ReplenishmentForecastCache[] @relation("ReplenForecastItem")
  replenIoTTriggers       ReplenishmentIoTTrigger[]    @relation("ReplenIoTItem")

  containerItems ContainerItem[]

  @@unique([organizationId, sku])
  @@index([organizationId])
  @@index([warehouseId])
  @@index([categoryId])
  @@index([supplierId])
  @@index([sku])
  @@map("inventory_items")
}

model InventoryMovement {
  id              String        @id @default(cuid())
  inventoryItemId String
  type            MovementType
  quantity        Int
  fromWarehouse   String?
  toWarehouse     String?
  reason          String?
  notes           String?
  createdAt       DateTime      @default(now())
  inventoryItem   InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)

  @@index([inventoryItemId])
  @@index([createdAt])
  @@map("inventory_movements")
}

model ReorderAlert {
  id                    String        @id @default(cuid())
  organizationId        String
  inventoryItemId       String
  alertType             AlertType     @default(LOW_STOCK)
  severity              AlertSeverity @default(MEDIUM)
  status                AlertStatus   @default(PENDING)
  currentStock          Int
  reorderPoint          Int
  reorderQuantity       Int
  estimatedStockoutDate DateTime?
  emailSent             Boolean       @default(false)
  smsSent               Boolean       @default(false)
  slackSent             Boolean       @default(false)
  pushSent              Boolean       @default(false)
  sentAt                DateTime?
  acknowledgedAt        DateTime?
  resolvedAt            DateTime?
  dismissedAt           DateTime?
  notes                 String?
  metadata              Json?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  inventoryItem         InventoryItem @relation(fields: [inventoryItemId], references: [id], onDelete: Cascade)
  organization          Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([inventoryItemId])
  @@index([status])
  @@index([createdAt])
  @@map("reorder_alerts")
}

model Booking {
  id             String        @id @default(cuid())
  organizationId String
  customerId     String?
  bookingNumber  String        @unique
  status         BookingStatus @default(PENDING)
  priority       Priority      @default(MEDIUM)
  totalItems     Int           @default(0)
  totalValue     Decimal?      @db.Decimal(10, 2)
  bookedAt       DateTime      @default(now())
  requiredBy     DateTime?
  confirmedAt    DateTime?
  fulfilledAt    DateTime?
  cancelledAt    DateTime?
  notes          String?
  internalNotes  String?
  metadata       Json?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String
  items          BookingItem[]
  createdBy      User          @relation("BookingCreator", fields: [createdById], references: [id])
  customer       Customer?     @relation(fields: [customerId], references: [id])
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([customerId])
  @@index([bookingNumber])
  @@index([status])
  @@index([createdAt])
  @@map("bookings")
}

model BookingItem {
  id                String        @id @default(cuid())
  bookingId         String
  inventoryItemId   String
  quantityBooked    Int
  quantityFulfilled Int           @default(0)
  unitPrice         Decimal?      @db.Decimal(10, 2)
  totalPrice        Decimal?      @db.Decimal(10, 2)
  notes             String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
  booking           Booking       @relation(fields: [bookingId], references: [id], onDelete: Cascade)
  inventoryItem     InventoryItem @relation(fields: [inventoryItemId], references: [id])

  @@index([bookingId])
  @@index([inventoryItemId])
  @@map("booking_items")
}

model Supplier {
  id                         String                      @id @default(cuid())
  organizationId             String
  name                       String
  code                       String
  email                      String?
  phone                      String?
  address                    String?
  city                       String?
  country                    String?
  website                    String?
  notes                      String?
  isActive                   Boolean                     @default(true)
  createdAt                  DateTime                    @default(now())
  updatedAt                  DateTime                    @updatedAt
  audits                     Audit[]
  inventoryItems             InventoryItem[]
  lots                       Lot[]
  ncrs                       NonConformanceReport[]      @relation("NCRs")
  purchaseOrders             PurchaseOrder[]
  qcReceivingInspections     QCReceivingInspection[]     @relation("SupplierInspections")
  rootCauseAnalyses          RootCauseAnalysis[]
  rtvRequests                RTVRequest[]                @relation("RTVRequest")
  rtvs                       RTV[]                       @relation("SupplierRTVs")
  supplierPerformanceReviews SupplierPerformanceReview[]
  supplierUsers              SupplierUser[]
  organization               Organization                @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  chargebacks                VendorChargeback[]          @relation("VendorChargebacks")
  complianceChecks           VendorComplianceCheck[]     @relation("ComplianceChecks")
  concessions                VendorConcession[]          @relation("VendorConcessions")
  debitMemos                 VendorDebitMemo[]           @relation("VendorDebitMemos")
  qualityScore               VendorQualityScore?         @relation("VendorQualityScore")
  vendorPolicies             VendorReturnPolicy[]        @relation("VendorReturnPolicy")
  replenishmentRules         ReplenishmentRule[]         @relation("ReplenRuleSupplier")
  supplierChargebacks        SupplierChargeback[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("suppliers")
}

model Customer {
  id                    String                 @id @default(cuid())
  organizationId        String
  name                  String
  code                  String
  email                 String?
  phone                 String?
  address               String?
  city                  String?
  country               String?
  notes                 String?
  isActive              Boolean                @default(true)
  // ── Credit & payment terms ──────────────────────────────────────────────
  creditLimit           Decimal?               @db.Decimal(12, 2)
  creditUsed            Decimal                @default(0) @db.Decimal(12, 2)
  creditHold            Boolean                @default(false)
  paymentTermsDays      Int? // default payment terms (days)
  taxId                 String? // VAT/GST registration
  currency              String                 @default("USD")
  // ───────────────────────────────────────────────────────────────────────
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  qrReturns             QRReturn[]
  bookings              Booking[]
