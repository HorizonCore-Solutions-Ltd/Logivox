# FlowStock Production Environment Variables
# NOTE: Do not commit real secrets. Provision via your secret manager/CI.

# ===========================================
# DATABASE
# ===========================================
DATABASE_URL="postgresql://user:password@host:5432/flowstock_production?schema=public&pgbouncer=true&connection_limit=10"
DIRECT_URL="postgresql://user:password@host:5432/flowstock_production?schema=public" # For migrations

# ===========================================
# NEXTAUTH.JS
# ===========================================
NEXTAUTH_URL="https://flowstock.com"
NEXTAUTH_SECRET="REPLACE_WITH_STRONG_SECRET_MINIMUM_32_CHARACTERS_GENERATED_WITH_openssl_rand_base64_32"

# ===========================================
# OAUTH PROVIDERS
# ===========================================
GOOGLE_CLIENT_ID="your-google-client-id-from-console.cloud.google.com"
GOOGLE_CLIENT_SECRET="your-google-client-secret"

GITHUB_ID="your-github-client-id-from-github.com/settings/developers"
GITHUB_SECRET="your-github-client-secret"

# ===========================================
# APP CONFIGURATION
# ===========================================
NEXT_PUBLIC_APP_URL="https://flowstock.com"
NEXT_PUBLIC_APP_NAME="FlowStock"
NODE_ENV="production"
LOG_LEVEL="info"

# ===========================================
# FEATURE FLAGS
# ===========================================
NEXT_PUBLIC_ENABLE_ANALYTICS=true
NEXT_PUBLIC_ENABLE_PWA=true
NEXT_PUBLIC_ENABLE_LABEL_PRINTING=false  # Enable after Phase 22
NEXT_PUBLIC_ENABLE_AI_ASSISTANT=false    # Enable after Phase 20

# ===========================================
# EMAIL SERVICE (Choose one)
# ===========================================
# Option 1: SendGrid
SENDGRID_API_KEY="SG.your-sendgrid-api-key"
SMTP_FROM_EMAIL="noreply@logivox.ai"
SMTP_FROM_NAME="LogiVox"

# Option 2: Resend
RESEND_API_KEY="re_your-resend-api-key"

# Option 3: AWS SES
AWS_SES_REGION="us-east-1"
AWS_SES_ACCESS_KEY_ID="your-aws-access-key"
AWS_SES_SECRET_ACCESS_KEY="your-aws-secret-key"

# Option 4: Generic SMTP
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_SECURE="true"

# ===========================================
# FILE STORAGE (Choose one)
# ===========================================
# Option 1: Vercel Blob (Recommended for Vercel)
BLOB_READ_WRITE_TOKEN="vercel_blob_your-token"

# Option 2: AWS S3
AWS_ACCESS_KEY_ID="your-aws-access-key-id"
AWS_SECRET_ACCESS_KEY="your-aws-secret-access-key"
AWS_REGION="us-east-1"
AWS_S3_BUCKET="logivox-production"
AWS_S3_URL="https://logivox-production.s3.amazonaws.com"

# Option 3: Cloudflare R2
CLOUDFLARE_ACCOUNT_ID="your-cloudflare-account-id"
CLOUDFLARE_ACCESS_KEY_ID="your-r2-access-key"
CLOUDFLARE_SECRET_ACCESS_KEY="your-r2-secret-key"
CLOUDFLARE_R2_BUCKET="logivox-production"

# ===========================================
# REDIS/CACHING (Phase 14) - Upstash Recommended
# ===========================================
REDIS_URL="redis://default:password@host:6379"
UPSTASH_REDIS_REST_URL="https://your-region.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your-upstash-token"

# ===========================================
# RATE LIMITING (Phase 15) - Upstash
# ===========================================
UPSTASH_RATELIMIT_URL="https://your-region.upstash.io"
UPSTASH_RATELIMIT_TOKEN="your-upstash-ratelimit-token"

# ===========================================
# PRINTNODE (Phase 22) - Label Printing
# ===========================================
PRINTNODE_API_KEY="your-printnode-api-key-from-printnode.com"

# ===========================================
# AI/OPENAI (Phase 20)
# ===========================================
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_ORGANIZATION="org-your-openai-org-id"

# Vector Database - Option 1: Pinecone
PINECONE_API_KEY="your-pinecone-api-key"
PINECONE_ENVIRONMENT="us-west1-gcp"
PINECONE_INDEX="flowstock-knowledge"

# Vector Database - Option 2: Supabase Vector (if using Supabase)
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"

# ===========================================
# ANALYTICS
# ===========================================
# Vercel Analytics (Auto-enabled on Vercel)
VERCEL_ANALYTICS_ID="auto"

# Google Analytics
NEXT_PUBLIC_GA_MEASUREMENT_ID="G-XXXXXXXXXX"

# Mixpanel (Optional)
NEXT_PUBLIC_MIXPANEL_TOKEN="your-mixpanel-token"

# Posthog (Optional)
NEXT_PUBLIC_POSTHOG_KEY="your-posthog-key"
NEXT_PUBLIC_POSTHOG_HOST="https://app.posthog.com"

# ===========================================
# ERROR TRACKING
# ===========================================
# Sentry
SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"
SENTRY_AUTH_TOKEN="your-sentry-auth-token"
SENTRY_ORG="your-sentry-org"
SENTRY_PROJECT="flowstock"
NEXT_PUBLIC_SENTRY_DSN="https://your-sentry-dsn@sentry.io/project-id"

# ===========================================
# PAYMENT (Optional - Stripe)
# ===========================================
STRIPE_PUBLISHABLE_KEY="pk_live_your-stripe-publishable-key"
STRIPE_SECRET_KEY="sk_live_your-stripe-secret-key"
STRIPE_WEBHOOK_SECRET="whsec_your-webhook-secret"
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY="pk_live_your-stripe-publishable-key"

# ===========================================
# ERP INTEGRATIONS (Phase 16)
# ===========================================
# Oracle
ORACLE_CLIENT_ID="your-oracle-client-id"
ORACLE_CLIENT_SECRET="your-oracle-client-secret"

# SAP
SAP_CLIENT_ID="your-sap-client-id"
SAP_CLIENT_SECRET="your-sap-client-secret"

# NetSuite
NETSUITE_ACCOUNT_ID="your-netsuite-account-id"
NETSUITE_CONSUMER_KEY="your-netsuite-consumer-key"
NETSUITE_CONSUMER_SECRET="your-netsuite-consumer-secret"
NETSUITE_TOKEN_ID="your-netsuite-token-id"
NETSUITE_TOKEN_SECRET="your-netsuite-token-secret"

# QuickBooks
QUICKBOOKS_CLIENT_ID="your-quickbooks-client-id"
QUICKBOOKS_CLIENT_SECRET="your-quickbooks-client-secret"
QUICKBOOKS_REDIRECT_URI="https://logivox.ai/api/integrations/quickbooks/callback"

# ===========================================
# MARKETPLACE INTEGRATIONS (Phase 23.2)
# ===========================================
# Shopify
SHOPIFY_API_KEY="your-shopify-api-key"
SHOPIFY_API_SECRET="your-shopify-api-secret"

# Zapier
ZAPIER_CLIENT_ID="your-zapier-client-id"
ZAPIER_CLIENT_SECRET="your-zapier-client-secret"

# ===========================================
# MONITORING & LOGGING
# ===========================================
# LogDNA/Mezmo
LOGDNA_INGESTION_KEY="your-logdna-key"

# Datadog
DATADOG_API_KEY="your-datadog-api-key"
DATADOG_APP_KEY="your-datadog-app-key"

# ===========================================
# SECURITY
# ===========================================
# CSRF Protection (Auto-generated by NextAuth, but can override)
# CSRF_TOKEN_SECRET="your-csrf-secret"

# API Keys for external services
API_KEY_ENCRYPTION_SECRET="your-api-key-encryption-secret-32-chars-min"

# ===========================================
# ALLOWED ORIGINS (CORS)
# ===========================================
ALLOWED_ORIGINS="https://logivox.ai,https://www.logivox.ai,https://app.logivox.ai"

# ===========================================
# PUSH NOTIFICATIONS (PWA)
# ===========================================
NEXT_PUBLIC_VAPID_PUBLIC_KEY="your-vapid-public-key"
VAPID_PRIVATE_KEY="your-vapid-private-key"
VAPID_SUBJECT="mailto:admin@logivox.ai"

# ===========================================
# WEBHOOK SECRETS
# ===========================================
WEBHOOK_SECRET="your-webhook-signing-secret-for-outgoing-webhooks"

# ===========================================
# BACKUP & RECOVERY
# ===========================================
BACKUP_S3_BUCKET="logivox-backups"
BACKUP_ENCRYPTION_KEY="your-backup-encryption-key"

# ===========================================
# RATE LIMITING CONFIGURATION
# ===========================================
RATE_LIMIT_PER_IP_PER_MINUTE=100
RATE_LIMIT_PER_USER_PER_HOUR=1000
RATE_LIMIT_PER_API_KEY_PER_HOUR=5000

# ===========================================
# DATABASE POOLING
# ===========================================
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10
DATABASE_POOL_IDLE_TIMEOUT=30000

# ===========================================
# CUSTOM DOMAIN & WHITE LABEL (Phase 19, 23.4)
# ===========================================
CUSTOM_DOMAIN_VERIFICATION_KEY="your-domain-verification-key"

# ===========================================
# MAINTENANCE MODE
# ===========================================
MAINTENANCE_MODE=false
MAINTENANCE_MESSAGE="We are currently performing scheduled maintenance. We'll be back soon!"

# ===========================================
# GENERATION INSTRUCTIONS
# ===========================================
# To generate NEXTAUTH_SECRET: openssl rand -base64 32
# To generate VAPID keys: npx web-push generate-vapid-keys
# To generate random secrets: openssl rand -hex 32
